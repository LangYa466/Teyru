package text

public class Text {
  public static String shout(String s) { return s.toUpperCase() + "!" }

  public static String twice(String s) { return s + s }

  public static String spaced(int n) {
    String out = ""
    for (int i = 0 : i < n : i++) {
      out = out + i + " "
    }
    return out.trim()
  }
}
