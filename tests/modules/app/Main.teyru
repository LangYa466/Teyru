// A module's program: it imports one package of a required module and uses it.
// The import is spelled the way a module path is (`/` between the elements),
// and the build has to find it in the module cache without being told where
// the cache is or which module provides what.
import example.com/greeting/text

class Main {
  public static void main(String[] args) {
    System.out.println(Text.shout("teyru"))
    System.out.println(Text.twice("ab"))
    System.out.println(Text.spaced(3))
  }
}
