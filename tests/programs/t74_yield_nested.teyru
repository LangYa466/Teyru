// A yield at any depth inside a case body. Java hands the value to the switch
// expression whether the yield is written directly in the body or sits inside
// an if, a loop or a try, and every case below used to answer with the value
// the body reached after its yield instead: the yield was turned into a
// comment, its value was dropped, and the control flow fell through into the
// rest of the body and on into the next case.
//
// The .expected file is what javac 25.0.3 prints for the same program (javac 21
// prints the same; nothing here is a preview feature). Every statement that
// holds a yield below was also run from the same program written in Java.
class Main {
  static String byIf(String s, boolean b) {
    return switch (s) {
      case "a" -> {
        if (b) { yield "A_true" }
        yield "A_false"
      }
      default -> "D"
    }
  }

  static String byFor(String s) {
    return switch (s) {
      case "a" -> {
        for (int i = 0 : i < 3 : i++) { yield "K" + i }
        yield "end"
      }
      default -> "D"
    }
  }

  // a yield inside a while, and a continue that still belongs to the loop
  static String byWhile(int n) {
    return switch (n) {
      case 1 -> {
        int i = 0
        while (i < n) {
          i++
          if (i == 1) { continue }
          yield "W" + i
        }
        yield "W_none"
      }
      default -> "D"
    }
  }

  // a yield inside a try: the finally runs before the switch expression is
  // left, and the catch frame is left as well when the try throws instead
  static String byTry(String s, boolean t) {
    return switch (s) {
      case "a" -> {
        try {
          if (t) { throw new IllegalStateException("x") }
          yield "T_ok"
        } catch (Exception e) {
          yield "T_caught"
        } finally {
          System.out.println("fin " + s)
        }
      }
      default -> "D"
    }
  }

  // a chain switch, whose cases are an if/else chain rather than a C switch
  static String chain(Object o) {
    return switch (o) {
      case String s when s.length() > 1 -> {
        for (int i = 0 : i < 2 : i++) {
          if (i == 1) { yield "long" }
        }
        yield "long_no"
      }
      case String t -> {
        yield "short"
      }
      default -> "other"
    }
  }

  // a switch expression nested in the case body of another one: each yield
  // belongs to the switch it is written in
  static String nested(String s) {
    return switch (s) {
      case "a" -> {
        String inner = switch (s.length()) {
          case 1 -> {
            if (true) { yield "in" }
            yield "in_no"
          }
          default -> "in_d"
        }
        yield "outer-" + inner
      }
      default -> "D"
    }
  }

  public static void main(String[] args) {
    System.out.println(byIf("a", true) + " " + byIf("a", false))
    System.out.println(byFor("a"))
    System.out.println(byWhile(1) + " " + byWhile(3))
    System.out.println(byTry("a", false))
    System.out.println(byTry("a", true))
    System.out.println(chain("abc") + " " + chain("a") + " " + chain(7))
    System.out.println(nested("a"))
  }
}
