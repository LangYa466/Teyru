class Main {
  public static void main(String[] args) {
    // The boundary values are only writable as the operand of a unary minus,
    // which is what the lexer's range check has to allow for.
    int lo = -2147483648
    System.out.println(lo)
    System.out.println(-2147483648 / 2)
    long llo = -9223372036854775808L
    System.out.println(llo)
    System.out.println(-9223372036854775808L + 1L)

    // Hex, octal and binary literals keep the full 32-bit pattern.
    System.out.println(0x80000000)
    System.out.println(0xFFFFFFFF)
    System.out.println(037777777777)

    // Escapes that are defined, including the ones that stand for themselves.
    System.out.println("A\101\t\"\\\'")
    String text = """
      one\ttwo\nthree\"four\\five
      """
    System.out.println(text)
  }
}
