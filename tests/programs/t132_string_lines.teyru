/* Java's String.lines, which only became possible once java.util.stream
   existed. The three terminators are one regular expression; the rules that
   matter are that a terminator is not part of its line, that a string ending in
   one has no empty line after it, and that an empty string has no lines.
   Expected output is javac 25's. */

package teyru

class T132 {
  public static void main(String[] args) {
    System.out.println("one\ntwo\nthree".lines().count())
    System.out.println("one\ntwo\nthree".lines().toList())
    System.out.println("a\r\nb\rc".lines().toList())
    System.out.println("trailing\n".lines().toList())
    System.out.println("".lines().count())
    System.out.println("\n".lines().toList())
    System.out.println("\n\n".lines().toList())
    System.out.println("no terminator".lines().toList())
    System.out.println("x".lines().toList())
    System.out.println("== the stream is a stream ==")
    System.out.println("one\ntwo\nthree".lines().map(s -> s.length()).toList())
    System.out.println("one\ntwo\nthree".lines().filter(s -> s.length() > 3).toList())
    System.out.println("one\ntwo\nthree".lines().sorted().toList())
    System.out.println("blanks\n\nmix\n".lines().map(s -> "[" + s + "]").toList())
  }
}
