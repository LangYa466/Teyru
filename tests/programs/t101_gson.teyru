// Gson's object binding, which is where the compiler has to do the work.
//
// Gson binds a class to JSON by reflection: fromJson(s, Person.class) asks the
// runtime to look at Person's fields. Teyru has no reflection, so the compiler
// looks instead: it generates a reader and a writer for each bound class and
// rewrites the call to use them. The call site keeps Gson's spelling and does
// not even need the cast Gson's generic signature would have required.
//
// The one case with no compile-time answer is a reference whose static type is
// Object -- the object's own class decides, through the table the generated
// classes fill in from their static initializers, which is the same answer Gson
// gives.

import teyru.*

class Address {
  String city
  String zip
}

class Person {
  String name
  int age
  boolean active
  double score
  @SerializedName("home_address") Address address
}

class Team {
  String teamName
  Person lead
}

class Main {
  public static void main(String[] args) {
    Gson gson = new Gson()
    String json = "{\"name\":\"ann\",\"age\":30,\"active\":true,\"score\":9.5," +
        "\"home_address\":{\"city\":\"Taipei\",\"zip\":\"100\"}}"

    Person p = gson.fromJson(json, Person.class)
    System.out.println(p.name + " " + p.age + " " + p.active + " " + p.score)
    System.out.println(p.address.city + "/" + p.address.zip)

    // out again, in Gson's own shape, with the name the annotation chose
    System.out.println(gson.toJson(p))

    // pretty printing goes through the same tree, so the binding is unchanged
    Gson pretty = new GsonBuilder().setPrettyPrinting().create()
    System.out.println(pretty.toJson(p))

    // a member the document does not carry keeps what the field was given
    Person q = gson.fromJson("{\"name\":\"bob\"}", Person.class)
    System.out.println("[" + q.name + "] age=" + q.age + " addr=" + q.address)

    // a nested class binds through the same generated reader
    Team t = gson.fromJson("{\"teamName\":\"x\",\"lead\":" + json + "}", Team.class)
    System.out.println(t.teamName + " -> " + t.lead.name + "/" + t.lead.address.zip)

    // the runtime table, for a reference the compiler could not see through
    Object any = p
    System.out.println(gson.toJson(any))
    Person back = (Person) JsonBinding.readFrom(json, Person.class)
    System.out.println(back.name + "/" + back.address.city)

    // and the tree API underneath, unchanged
    JsonElement e = JsonParser.parseString(json)
    System.out.println(e.getAsJsonObject().get("home_address").getAsJsonObject().get("zip").getAsString())
  }
}
