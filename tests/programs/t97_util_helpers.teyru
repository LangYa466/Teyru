import java.util.ArrayDeque
import java.util.ArrayList
import java.util.Arrays
import java.util.Collection
import java.util.Collections
import java.util.Comparator
import java.util.Deque
import java.util.HashMap
import java.util.HashSet
import java.util.Iterator
import java.util.LinkedHashMap
import java.util.LinkedHashSet
import java.util.LinkedList
import java.util.List
import java.util.Map
import java.util.NavigableMap
import java.util.NavigableSet
import java.util.NoSuchElementException
import java.util.Objects
import java.util.Optional
import java.util.Queue
import java.util.Set
import java.util.StringJoiner
import java.util.function.Supplier
import java.util.TreeMap
import java.util.TreeSet

/* The rest of java.util: the helpers (Arrays, Collections, Objects, Optional,
 * StringJoiner) and the parts of the containers t96 does not reach -- the
 * LinkedList deque, the sorted map's range views, subList views, and the
 * contracts that say what a container returns when something is missing.
 *
 * As in t96, the .expected file is the output of the same program on Java 25. */

class Main {
  public static void main(String[] args) {
    // LinkedList is a List and a Deque at once
    LinkedList<String> ll = new LinkedList<String>()
    ll.add("b")
    ll.addFirst("a")
    ll.addLast("c")
    System.out.println(ll)
    System.out.println(ll.getFirst() + " " + ll.getLast())
    System.out.println(ll.removeFirst() + " " + ll.removeLast())
    System.out.println(ll)
    ll.push("z")
    System.out.println(ll.peek() + " " + ll.pop())
    ll.add("y")
    ll.add("y")
    System.out.println(ll.indexOf("y") + " " + ll.lastIndexOf("y"))
    Iterator<String> down = ll.descendingIterator()
    while (down.hasNext()) {
      System.out.print(down.next())
    }
    System.out.println()
    System.out.println(ll.poll() + " " + ll.size())
    Deque<Integer> dq = new LinkedList<Integer>()
    dq.offerFirst(1)
    dq.offerLast(2)
    System.out.println(dq + " " + dq.peekFirst() + " " + dq.peekLast())
    // a queue that is empty: poll gives null, remove throws
    Queue<String> q = new ArrayDeque<String>()
    System.out.println(q.poll())
    System.out.println(q.peek())
    try {
      q.remove()
      System.out.println("no throw")
    } catch (NoSuchElementException e) {
      System.out.println("empty queue")
    }
    try {
      q.element()
      System.out.println("no throw")
    } catch (NoSuchElementException e) {
      System.out.println("empty element")
    }

    // Map: the default methods
    Map<String, Integer> m = new LinkedHashMap<String, Integer>()
    m.put("a", 1)
    m.put("b", 2)
    m.put("c", 3)
    System.out.println(m.putIfAbsent("a", 9) + " " + m.putIfAbsent("d", 4) + " " + m)
    System.out.println(m.getOrDefault("zz", -1) + " " + m.getOrDefault("a", -1))
    System.out.println(m.replace("a", 11) + " " + m.replace("a", 11, 12) + " " + m.replace("a", 12, 99))
    System.out.println(m)
    System.out.println(m.remove("d", 5) + " " + m.remove("d", 4) + " " + m)
    System.out.println(m.merge("b", 10, (old, v) -> old + v) + " " + m.merge("e", 5, (old, v) -> old + v))
    System.out.println(m.compute("b", (k, v) -> v * 2) + " " + m.computeIfPresent("b", (k, v) -> v + 1))
    System.out.println(m.compute("zz", (k, v) -> 7) + " " + m.compute("zz", (k, v) -> null) + " " + m)
    m.replaceAll((k, v) -> v + 100)
    System.out.println(m)
    StringBuilder seen = new StringBuilder()
    m.forEach((k, v) -> seen.append(k + "=" + v + ";"))
    System.out.println(seen.toString())

    // Map.Entry writes through to the map
    for (Map.Entry<String, Integer> e : m.entrySet()) {
      if (e.getKey().equals("a")) {
        e.setValue(0)
      }
    }
    System.out.println(m)
    System.out.println(m.keySet().remove("e") + " " + m)
    System.out.println(m.values())
    System.out.println(m.containsKey("a") + " " + m.containsValue(0) + " " + m.containsValue(999))
    System.out.println(m.size() + " " + m.isEmpty())
    Map<String, Integer> copy = new LinkedHashMap<String, Integer>(m)
    System.out.println(copy.equals(m) + " " + (copy.hashCode() == m.hashCode()))
    copy.clear()
    System.out.println(copy + " " + copy.isEmpty())
    System.out.println(m.remove("a"))

    // TreeMap: the range views, live and half-open the way the JDK's are
    TreeMap<String, Integer> tm = new TreeMap<String, Integer>()
    String[] letters = new String[]{"e", "b", "d", "a", "c"}
    for (String s : letters) {
      tm.put(s, s.length())
    }
    System.out.println(tm)
    System.out.println(tm.firstKey() + " " + tm.lastKey())
    System.out.println(tm.subMap("b", "d") + " " + tm.subMap("b", true, "d", true))
    System.out.println(tm.headMap("c") + " " + tm.tailMap("c") + " " + tm.tailMap("c", false))
    System.out.println(tm.descendingMap())
    System.out.println(tm.navigableKeySet() + " " + tm.descendingKeySet())
    System.out.println(tm.firstEntry() + " " + tm.lastEntry())
    System.out.println(tm.ceilingEntry("bb") + " " + tm.floorEntry("bb") + " " + tm.higherKey("b") + " " + tm.lowerKey("b"))
    NavigableMap<String, Integer> range = tm.subMap("b", true, "d", true)
    System.out.println(range + " " + range.descendingMap() + " " + range.firstKey() + " " + range.lastKey())
    tm.put("bb", 99)
    System.out.println(range)
    System.out.println(range.remove("c") + " " + tm)
    System.out.println(tm.pollFirstEntry() + " " + tm.pollLastEntry() + " " + tm)
    System.out.println(tm.ceilingKey("zz"))

    // subList is a view: writes go through, and it can shrink the parent
    List<String> base = new ArrayList<String>()
    Collections.addAll(base, "a", "b", "c", "d", "e")
    List<String> sub = base.subList(1, 4)
    System.out.println(sub)
    sub.set(0, "B")
    System.out.println(base)
    sub.add("X")
    System.out.println(base)
    System.out.println(sub.remove(0) + " " + base)
    sub.clear()
    System.out.println(base + " " + sub)
    List<String> sub2 = base.subList(0, 1)
    System.out.println(sub2.equals(Collections.singletonList("a")))

    // Arrays, one group at a time
    int[] nums = new int[]{3, 1, 2}
    int[] more = Arrays.copyOf(nums, 5)
    System.out.println(Arrays.toString(more))
    System.out.println(Arrays.toString(Arrays.copyOfRange(nums, 1, 3)))
    System.out.println(Arrays.toString(Arrays.copyOf(nums, 2)))
    Arrays.fill(nums, 7)
    System.out.println(Arrays.toString(nums))
    System.out.println(Arrays.equals(new int[]{1, 2}, new int[]{1, 2}) + " " + Arrays.equals(new int[]{1, 2}, new int[]{1, 3}))
    System.out.println(Arrays.hashCode(new int[]{1, 2, 3}) + " " + Arrays.hashCode(new Object[]{"a", "b"}))
    String[] names = new String[]{"ann", "bob"}
    System.out.println(Arrays.toString(names) + " " + Arrays.hashCode(names))
    int[][] grid = new int[2][2]
    grid[0][0] = 1
    grid[1][1] = 2
    System.out.println(Arrays.deepToString(grid))
    System.out.println(Arrays.deepEquals(grid, grid) + " " + Arrays.deepEquals(new Object[]{names}, new Object[]{names}))
    List<String> fixed = Arrays.asList("p", "q")
    System.out.println(fixed + " " + fixed.size() + " " + fixed.get(1))
    fixed.set(0, "P")
    System.out.println(fixed)
    try {
      fixed.add("no")
      System.out.println("no throw")
    } catch (UnsupportedOperationException e) {
      System.out.println("fixed size")
    }
    System.out.println(new ArrayList<String>(fixed))

    // Collections: views and small lists
    List<String> src = new ArrayList<String>()
    Collections.addAll(src, "a", "b", "c")
    Collection<String> uc = Collections.unmodifiableCollection(src)
    System.out.println(uc.size() + " " + uc.contains("a"))
    try {
      uc.add("no")
      System.out.println("no throw")
    } catch (UnsupportedOperationException e) {
      System.out.println("unmodifiable collection")
    }
    Set<String> us = Collections.unmodifiableSet(new HashSet<String>(src))
    System.out.println(us)
    Map<String, Integer> um = Collections.unmodifiableMap(m)
    System.out.println(um.size())
    try {
      um.clear()
      System.out.println("no throw")
    } catch (UnsupportedOperationException e) {
      System.out.println("unmodifiable map")
    }
    System.out.println(Collections.singletonList("s").size())
    System.out.println(Collections.nCopies(2, "n"))
    Iterator<String> exhausted = Collections.emptyIterator()
    System.out.println(exhausted.hasNext())
    // shuffle is random, so what is checked is what a shuffle promises: the
    // same elements, reordered
    List<String> shuffled = new ArrayList<String>()
    Collections.addAll(shuffled, "a", "b", "c")
    Collections.shuffle(shuffled)
    Collections.sort(shuffled)
    System.out.println(shuffled + " " + shuffled.size())
    Collections.sort(shuffled, reversed())
    System.out.println(shuffled)
    System.out.println(Collections.<String>reverseOrder().compare("a", "b") + " " + Collections.<String>reverseOrder(reversed()).compare("a", "b"))

    // Objects: the null-handling helpers
    System.out.println(Objects.<String>requireNonNullElse(null, "dflt") + " " + Objects.requireNonNullElse("x", "dflt"))
    System.out.println(Objects.<String>requireNonNullElseGet(null, () -> "made") + " " + Objects.requireNonNullElseGet("x", () -> "made"))
    String nothing = null
    try {
      Objects.requireNonNullElse(nothing, nothing)
      System.out.println("no throw")
    } catch (NullPointerException e) {
      System.out.println("null default")
    }
    System.out.println(Objects.deepEquals(new int[]{1, 2}, new int[]{1, 2}) + " " + Objects.deepEquals(new Object[]{"a"}, new Object[]{"a"}))
    System.out.println(Objects.toString("x") + " " + Objects.toString(null))
    System.out.println(Objects.hashCode("a") + " " + Objects.equals("a", null))

    // Optional: the rest of the chain
    Optional<String> present = Optional.of("abc")
    Optional<Integer> len = present.<Integer>map(String::length)
    System.out.println(len.get() + " " + present.<String>flatMap(s -> Optional.of(s + "!")).get())
    System.out.println(Optional.<String>empty().or(() -> Optional.of("supplied")).get())
    System.out.println(present.or(() -> Optional.of("supplied")).get())
    System.out.println(present.<Integer>flatMap(s -> Optional.empty()).isEmpty())
    System.out.println(present.orElseThrow())
    try {
      Optional.<String>empty().orElseThrow()
      System.out.println("no throw")
    } catch (NoSuchElementException e) {
      System.out.println("no value")
    }
    Supplier<IllegalStateException> boom = () -> new IllegalStateException("boom")
    try {
      Optional.<String>empty().<IllegalStateException>orElseThrow(boom)
      System.out.println("no throw")
    } catch (IllegalStateException e) {
      System.out.println(e.getMessage())
    }
    present.ifPresentOrElse(s -> System.out.println("present " + s), () -> System.out.println("absent"))
    Optional.<String>empty().ifPresentOrElse(s -> System.out.println("present " + s), () -> System.out.println("absent"))
    System.out.println(Optional.of("abc").equals(present) + " " + (Optional.of("abc").hashCode() == present.hashCode()))
    Optional<String> absent = Optional.empty()
    System.out.println(absent + " " + present)

    // StringJoiner
    StringJoiner sj = new StringJoiner(", ", "[", "]")
    sj.add("a")
    sj.add("b")
    System.out.println(sj.toString() + " " + sj.length())
    StringJoiner other = new StringJoiner("-")
    other.add("c")
    other.add("d")
    System.out.println(sj.merge(other).toString())
    StringJoiner blank = new StringJoiner("-")
    System.out.println("[" + blank.toString() + "]")
    blank.setEmptyValue("none")
    System.out.println("[" + blank.toString() + "]")
    System.out.println(blank.add("x").toString())

    // a set with a comparator orders by it, and descendingIterator walks back
    Comparator<String> byLength = (a, b) -> a.length() - b.length()
    TreeSet<String> byLen = new TreeSet<String>(byLength)
    Collections.addAll(byLen, "aaa", "a", "cc", "bb")
    System.out.println(byLen)
    System.out.println(byLen.first() + " " + byLen.last())
    System.out.println(byLen.descendingSet())
    Iterator<String> back = byLen.descendingIterator()
    while (back.hasNext()) {
      System.out.print(back.next() + " ")
    }
    System.out.println()
    System.out.println(byLen.pollFirst() + " " + byLen.pollLast() + " " + byLen)
    // equality across Set implementations
    Set<Integer> a = new HashSet<Integer>()
    a.add(1)
    a.add(2)
    a.add(3)
    Set<Integer> b = new TreeSet<Integer>()
    b.add(3)
    b.add(2)
    b.add(1)
    Set<Integer> c = new LinkedHashSet<Integer>()
    c.add(2)
    c.add(3)
    c.add(1)
    System.out.println(a.equals(b) + " " + b.equals(c) + " " + c.equals(a))
    System.out.println((a.hashCode() == b.hashCode()) + " " + (b.hashCode() == c.hashCode()))
    System.out.println(a.containsAll(b) + " " + a.removeAll(Collections.singletonList(1)) + " " + a)
    System.out.println(a.retainAll(b) + " " + a)
    System.out.println(b.addAll(a) + " " + b)

    // equality across List implementations, and across the sorted map
    List<String> one = new ArrayList<String>()
    Collections.addAll(one, "x", "y")
    List<String> two = new LinkedList<String>()
    Collections.addAll(two, "x", "y")
    List<String> three = Arrays.asList("x", "y")
    System.out.println(one.equals(two) + " " + two.equals(three) + " " + three.equals(one))
    System.out.println((one.hashCode() == two.hashCode()) + " " + (two.hashCode() == three.hashCode()))
    System.out.println(one.indexOf("y") + " " + one.contains("z") + " " + one.containsAll(three))
  }

  private static Comparator<String> reversed() {
    return Collections.<String>reverseOrder()
  }
}
