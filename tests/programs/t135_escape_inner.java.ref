// The Java this test is the oracle for. Compiled with javac 25 and run to
// produce t135_escape_inner.expected; it is not part of the Teyru build.
public class T135 {
  static T135.Inner kept = null;

  int v;

  T135(int v) {
    this.v = v;
  }

  class Inner {
    int get() {
      return v;
    }
    String describe() {
      return "inner of " + v;
    }
  }

  static class Plain {
    int get() {
      return 7;
    }
  }

  Inner make() {
    return new Inner();
  }

  Inner makeQualified() {
    return this.new Inner();
  }

  public static void main(String[] args) {
    System.out.println("== an inner object made through a local ==");
    T135 a = new T135(12345);
    T135.Inner ia = a.new Inner();
    System.out.println(ia.get());
    System.out.println(ia.describe());
    kept = a.new Inner();
    System.out.println(kept.get());

    System.out.println("== an inner object returned from a method ==");
    T135 b = new T135(999);
    T135.Inner ib = b.make();
    System.out.println(ib.get());
    kept = b.make();
    System.out.println(kept.get());

    System.out.println("== and the same through this.new ==");
    T135 c = new T135(4242);
    kept = c.makeQualified();
    System.out.println(kept.get());

    System.out.println("== the controls ==");
    T135 d = new T135(5);
    System.out.println(d.new Inner().get());
    Plain p = new Plain();
    System.out.println(p.get());

    System.out.println("== the enclosing instances stay distinct ==");
    T135 e = new T135(1);
    T135 f = new T135(2);
    kept = e.new Inner();
    T135.Inner other = f.new Inner();
    System.out.println(kept.get() + " " + other.get() + " " + kept.get());
  }
}
