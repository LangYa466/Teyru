// Shift counts: JLS 15.19 keeps only the low 5 bits of an int shift count, and
// the low 6 of a long one, for `<<`, `>>` and `>>>` alike. A count of 32, 33,
// 64 or -1 is the case C leaves undefined, so the count has to be masked both
// where the expression is emitted and where it is folded. The expectations are
// what javac 25 prints for the same program (`/usr/lib/jvm/java-25/bin/javac`,
// which masks shifts exactly as javac 21 does).
class Main {
  public static void main(String[] args) {
    // counts that are not literals: the shift is computed at run time
    int a = 1
    int k = 32
    System.out.println(a << k)
    System.out.println(a << 33)
    long l = 1L
    System.out.println(l << 64)
    System.out.println(a << -1)

    // constant operands: the folder must mask with the operand's width, not
    // with the long width it happens to compute in
    System.out.println(-8 >> 33)
    System.out.println(1 << 32)
    System.out.println(1 << 33)
    System.out.println(2 << 31)
    System.out.println(1 << 63)
    System.out.println(1L << 64)
    System.out.println(-1 >>> 32)

    // a left-deep run reaches the C compiler as one flat chain, counts included
    int n = 1
    int b = 33
    int c = 32
    System.out.println(n << b << c)
    System.out.println(n << c << b)
    long one = 1L
    long m = 64
    System.out.println(one << m << m)

    // every integral type but long is promoted to int first, so all three
    // shift by 5 bits
    short s = 1
    byte y = 2
    char ch = 4
    System.out.println(s << b)
    System.out.println(y << b)
    System.out.println(ch << b)

    // a compound shift masks its count the same way
    int x = 1
    x <<= 33
    System.out.println(x)
    x >>= 33
    System.out.println(x)
    x >>>= 33
    System.out.println(x)
    long z = -8L
    z >>= 64
    System.out.println(z)
    z >>>= 70
    System.out.println(z)

    // a boxed count is unboxed before it is masked
    Integer box = 33
    int q = 1
    System.out.println(q << box)
    q <<= box
    System.out.println(q)

    // counts around the width, at run time
    int v = -8
    for (int i = 30 : i <= 34 : i++) {
      System.out.println(i + " " + (v << i) + " " + (v >> i) + " " + (v >>> i))
    }
    long w = -8L
    for (int i = 62 : i <= 66 : i++) {
      System.out.println(i + " " + (w << i) + " " + (w >> i) + " " + (w >>> i))
    }
  }
}
