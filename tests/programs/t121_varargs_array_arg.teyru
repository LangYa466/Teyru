/* A variable-arity call whose arguments are exactly the parameter list, so the
   array itself stands in for the variable arguments. That form is an ordinary
   call as far as inference goes, and it was the one place a type variable could
   not be settled: `Arrays.asList(a)` was rejected for a type argument that was
   sitting in the argument list. Expected output is javac 25's. */

package teyru

class T121 {
  @SafeVarargs
  static <X> int count(X... xs) { return xs.length }

  @SafeVarargs
  static <X> String joinAll(String sep, X... xs) {
    StringBuilder sb = new StringBuilder()
    for (int i = 0 : i < xs.length : i++) {
      if (i > 0) { sb.append(sep) }
      sb.append(String.valueOf(xs[i]))
    }
    return sb.toString()
  }

  @SafeVarargs
  static <X> List<X> listed(X... xs) { return new ArrayList<X>(Arrays.asList(xs)) }

  public static void main(String[] args) {
    System.out.println("== the array itself ==")
    String[] words = new String[]{"x", "y"}
    System.out.println(Arrays.asList(words).size())
    System.out.println(Arrays.asList(words).get(1))
    System.out.println(count(words))
    System.out.println(joinAll("-", words))
    System.out.println(listed(words).size())
    System.out.println("== and the ordinary form ==")
    System.out.println(Arrays.asList("p", "q", "r").size())
    System.out.println(count("p", "q"))
    System.out.println(joinAll("-", "p", "q"))
    System.out.println(listed("p", "q").size())
    System.out.println("== element types follow the array ==")
    Integer[] boxed = new Integer[]{4, 5}
    List<Integer> ls = Arrays.asList(boxed)
    System.out.println(ls.get(0) + ls.get(1))
    System.out.println("== an array as one element ==")
    System.out.println(Arrays.asList(words, words).size())
    System.out.println(count(new String[][]{ words, words }))
    System.out.println("== two array arguments name an array element type ==")
    System.out.println(Arrays.asList(words, words).size())
    System.out.println(count(words, words))
    List<String[]> nested = listed(words, words)
    System.out.println(nested.size() + " " + nested.get(0).length + " " + nested.get(1)[0])
  }
}
