/* Comparator's factory methods: comparing, naturalOrder, reverseOrder,
   thenComparing, nullsFirst and nullsLast. Expected output is javac 25's.

   Two things are written differently from Java, and both are the same
   limitation: a generic call with a free type variable gets no target type when
   it is an argument or the receiver of a chain, so `sort(xs, naturalOrder())`
   and `sort(xs, comparing(...).thenComparing(...))` are not accepted. The
   witness `<String>` or a declared variable is the way around it, and both are
   used below. Everything else is Java's own text. */

package teyru

class T125 {
  static void show(List<String> xs) { System.out.println(xs) }

  public static void main(String[] args) {
    List<String> xs = new ArrayList<String>()
    xs.add("pear")
    xs.add("fig")
    xs.add("apple")
    xs.add("kiwi")

    System.out.println("== natural and reversed ==")
    Comparator<String> nat = Comparator.naturalOrder()
    Collections.sort(xs, nat)
    show(xs)
    Collections.sort(xs, Comparator.<String>reverseOrder())
    show(xs)

    System.out.println("== comparing ==")
    Comparator<String> byLen = Comparator.comparing(s -> s.length())
    Collections.sort(xs, byLen)
    show(xs)
    Comparator<String> byLast = Comparator.comparing(s -> s.substring(s.length() - 1))
    Collections.sort(xs, byLast)
    show(xs)

    System.out.println("== thenComparing breaks the ties ==")
    List<String> words = new ArrayList<String>()
    words.add("bb")
    words.add("a")
    words.add("ccc")
    words.add("dd")
    Comparator<String> byLen2 = Comparator.comparing(s -> s.length())
    Collections.sort(words, byLen2.thenComparing(nat))
    show(words)

    System.out.println("== nullsFirst and nullsLast ==")
    List<String> withNull = new ArrayList<String>()
    withNull.add("b")
    withNull.add(null)
    withNull.add("a")
    Collections.sort(withNull, Comparator.nullsFirst(nat))
    show(withNull)
    Collections.sort(withNull, Comparator.nullsLast(nat))
    show(withNull)

    System.out.println("== reversed flips the whole order ==")
    Comparator<String> byLen3 = Comparator.comparing(s -> s.length())
    Collections.sort(words, byLen3.reversed())
    show(words)
  }
}
