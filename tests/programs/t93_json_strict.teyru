import com.google.gson.*

// The places where lib/10_json.teyru deliberately differs from com.google.gson
// 2.10.0, and the parser's strictness. t93_json covers everything that agrees
// with Gson; the lines here are this library's own answers.
//
// Gson reads JSON in lenient mode, so it accepts every document in the first
// block below. This parser follows RFC 8259 and rejects them, and its messages
// are its own -- Gson's say "Use JsonReader.setLenient(true) ...". The values
// after "Gson:" were measured by running the same calls with the real jar, so
// each one is evidence rather than recollection.
class Main {
  // the class name is printed too: this library throws IllegalArgumentException
  // where Gson throws NumberFormatException, which the standard library here
  // does not define
  static String intOrMessage(String json) {
    try {
      return "" + JsonParser.parseString(json).getAsJsonPrimitive().getAsInt()
    } catch (IllegalArgumentException ex) {
      return ex.getClass().getName() + ": " + ex.getMessage()
    }
  }

  static String longOrMessage(String json) {
    try {
      return "" + JsonParser.parseString(json).getAsJsonPrimitive().getAsLong()
    } catch (IllegalArgumentException ex) {
      return ex.getClass().getName() + ": " + ex.getMessage()
    }
  }

  static String byteOrMessage(String json) {
    try {
      return "" + JsonParser.parseString(json).getAsJsonPrimitive().getAsByte()
    } catch (IllegalArgumentException ex) {
      return ex.getClass().getName() + ": " + ex.getMessage()
    }
  }

  static String shortOrMessage(String json) {
    try {
      return "" + JsonParser.parseString(json).getAsJsonPrimitive().getAsShort()
    } catch (IllegalArgumentException ex) {
      return ex.getClass().getName() + ": " + ex.getMessage()
    }
  }

  static String doubleOrMessage(String json) {
    try {
      return "" + JsonParser.parseString(json).getAsJsonPrimitive().getAsDouble()
    } catch (IllegalArgumentException ex) {
      return ex.getClass().getName() + ": " + ex.getMessage()
    }
  }

  static String accept(String json) {
    try {
      return JsonParser.parseString(json).toString()
    } catch (JsonSyntaxException ex) {
      return "rejected: " + ex.getMessage()
    }
  }

  static String asString(JsonElement e) {
    try {
      return e.getAsString()
    } catch (UnsupportedOperationException ex) {
      return "UnsupportedOperationException: " + ex.getMessage()
    }
  }

  static String asObject(JsonElement e) {
    try {
      return e.getAsJsonObject().toString()
    } catch (IllegalStateException ex) {
      return ex.getClass().getName() + ": " + ex.getMessage()
    }
  }

  static String arrayAsString(String json) {
    try {
      return JsonParser.parseString(json).getAsString()
    } catch (IllegalStateException ex) {
      return ex.getClass().getName() + ": " + ex.getMessage()
    }
  }

  public static void main(String[] args) {
    System.out.println("== documents Gson accepts too ==")
    String[] accepted = {"null", "true", "false", "0", "-0", "1e5", "-1.5E-3", "10000000000000000000", "1e999", "\"\"", "{}", "[]", "[[[]]]", "{\"\":\"\"}", "[1,2]", "\"\\uD83D\\uDE00\"", "\"\\ud83d\\ude00\""}
    for (String json : accepted) {
      System.out.println("accept " + json + " | " + accept(json))
    }
    // whitespace is skipped wherever JSON allows it, including around the
    // whole document
    System.out.println("accept with whitespace | " + accept(" \t\r\n {\"a\" : [ 1 , 2 ] } \n "))

    /* Twenty-one documents Gson's lenient reader takes and this one does not.
       The first group is syntax Gson allows on purpose ({a:1}, 'a', a trailing
       comma, a leading +, a bare -, 01, .5, 1., NaN); the rest is malformed
       under any reading and Gson rejects it too. */
    System.out.println("== documents this parser rejects ==")
    String[] lenient = {"{a:1}", "{'a':1}", "[1,]", "{\"a\":1,}", "+1", "-", "01", ".5", "1.", "1.e5", "NaN", "Infinity", "0x10", "nul", "tru", "TRUE", ""}
    for (String json : lenient) {
      System.out.println("lenient reject " + json + " | " + accept(json))
    }
    String[] malformed = {"   ", "{", "[", "[1", "{\"a\"", "{\"a\"}", "{\"a\":}", "{\"a\" 1}", "{,}", "[,1]", "[1 2]", "\"abc", "\"\\q\"", "\"\\u12\"", "\"\\uZZZZ\"", "1.2.3", "1e", "1e+", "/*c*/1", "}}", "]", "{\"a\":1} x", "[1] [2]", "1 2", "{} {}", "\"a\"\"b\""}
    for (String json : malformed) {
      System.out.println("reject " + json + " | " + accept(json))
    }
    // a raw control character inside a string: JSON forbids it, and Gson's
    // lenient reader is not lenient about this either
    System.out.println("reject tab in string | " + accept("\"a\tb\""))

    // a few of these land on Gson's value after all -- the annotation says which
    System.out.println("== number conversions, against Gson's own answers ==")
    /* Gson's LazilyParsedNumber falls back to BigDecimal when the text does not
       fit a long, and BigDecimal.intValue() takes the low 32 bits of the exact
       value -- it wraps. This library has no arbitrary-precision decimal, so an
       integer literal that does not fit a long saturates: the number is still
       printed back as written and still compares correctly, only these
       conversions differ. */
    System.out.println("big int | " + intOrMessage("10000000000000000000") + " (Gson: -1981284352)")
    System.out.println("big long | " + longOrMessage("10000000000000000000") + " (Gson: -8446744073709551616)")
    System.out.println("big byte | " + byteOrMessage("10000000000000000000") + " (Gson: 0)")
    System.out.println("big short | " + shortOrMessage("10000000000000000000") + " (Gson: 0)")
    System.out.println("big double | " + doubleOrMessage("10000000000000000000") + " (Gson: 1.0E19)")
    // the same wrapping, for a value that is not integral: Gson reaches
    // BigDecimal here too, this library clamps through the double
    System.out.println("wide int | " + intOrMessage("1.5e+10") + " (Gson: 2115098112)")
    System.out.println("wide long | " + longOrMessage("1.5e+10") + " (Gson: 15000000000)")
    System.out.println("wide byte | " + byteOrMessage("1.5e+10") + " (Gson: 0)")
    System.out.println("wide short | " + shortOrMessage("1.5e+10") + " (Gson: -10752)")
    // outside the double range the text is still kept and Java answers Infinity
    System.out.println("overflow double | " + doubleOrMessage("1e999") + " (Gson: Infinity)")
    // Double.toString(-0.0) is "-0.0"; the runtime's formatter answers "0.0"
    System.out.println("negative zero | " + doubleOrMessage("-0") + " (Gson: -0.0)")
    // an unpaired surrogate cannot be encoded as UTF-8, and both sides print
    // "?" for it -- Java's encoder substitutes it on the way out, and this
    // runtime does the same
    System.out.println("lone surrogate | " + accept("\"\\uD83D\"") + " (Gson: \"?\" too)")

    System.out.println("== accesses that differ from Gson ==")
    // an empty document is not JSON; Gson answers JsonNull.INSTANCE for it, and
    // accepts anything at all after a null, because it skips its own
    // end-of-document check when the element it read is a JsonNull
    System.out.println("empty document | " + accept("") + " (Gson: JsonNull.INSTANCE)")
    System.out.println("null then trailing | " + accept("null x") + " (Gson: JsonNull.INSTANCE)")
    // the message names the class as this package spells it, not as
    // com.google.gson spells it
    System.out.println("null as string | " + asString(JsonNull.INSTANCE) + " (Gson: com.google.gson.JsonNull)")
    JsonObject object = JsonParser.parseString("{\"a\":1}").getAsJsonObject()
    System.out.println("object as string | " + asString(object) + " (Gson: com.google.gson.JsonObject)")
    // as in Gson, a one-element array answers with its element's string, and a
    // longer one fails; only the package of IllegalArgumentException differs
    System.out.println("one-element array as string | " + arrayAsString("[1]") + " (Gson: 1)")
    System.out.println("two-element array as string | " + arrayAsString("[1,2]") + " (Gson: java.lang.IllegalStateException, same message)")
    System.out.println("primitive as object | " + asObject(JsonParser.parseString("1")) + " (Gson: java.lang.IllegalStateException, same message)")
    // the message is Java's, but the class is not: there is no
    // NumberFormatException in this standard library
    System.out.println("bad int | " + intOrMessage("\"12.5\"") + " (Gson: java.lang.NumberFormatException, same message)")
    System.out.println("bad int text | " + intOrMessage("\" 13 \"") + " (Gson: java.lang.NumberFormatException, same message)")
    // a char argument reaches the constructor through the compiler's overload
    // fallback (see the file header in lib/10_json.teyru); the value stored is
    // still the one Gson stores
    JsonPrimitive x = new JsonPrimitive('x')
    System.out.println("char primitive | " + x + " isString=" + x.isString() + " (Gson: \"x\" isString=true)")

    System.out.println("== reader limits ==")
    // Gson 2.10 sets no depth limit: it recurses until the JVM stack overflows,
    // so 300 brackets parse and 20000 is a raw StackOverflowError. This reader
    // recurses into C frames, where there is no stack to catch, so the depth is
    // capped instead -- 300 is refused, 200 is fine
    StringBuilder deep = new StringBuilder()
    for (int i = 0 : i < 300 : i++) {
      deep.append("[")
    }
    System.out.println("deep nesting | " + accept(deep.toString()) + " (Gson: parses it)")
    StringBuilder ok = new StringBuilder()
    for (int i = 0 : i < 200 : i++) {
      ok.append("[")
    }
    for (int i = 0 : i < 200 : i++) {
      ok.append("]")
    }
    String nested = accept(ok.toString())
    System.out.println("200 deep | " + nested.length() + " characters, first two " + nested.substring(0, 2))
  }
}
