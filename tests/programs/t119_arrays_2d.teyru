/* Arrays of arrays: creation with and without inner dimensions, initializers
   that nest, `length` at each level, and an array used as a type argument
   (`List<int[]>`), where the element type has to survive erasure on the way
   out of the generic. Expected output is javac 25's for this same program. */

package teyru

class T119 {
  static void show(int[][] g) {
    for (int i = 0 : i < g.length : i++) {
      String row = ""
      for (int j = 0 : j < g[i].length : j++) {
        row = row + g[i][j]
        if (j + 1 < g[i].length) { row = row + "," }
      }
      System.out.println("[" + row + "]")
    }
  }

  public static void main(String[] args) {
    System.out.println("== rectangular ==")
    int[][] a = new int[2][3]
    a[1][2] = 9
    System.out.println(a[1][2])
    System.out.println(a.length + " " + a[0].length)
    show(a)
    System.out.println("== ragged from an initializer ==")
    int[][] b = new int[][]{ {1, 2}, {3, 4, 5}, {} }
    show(b)
    System.out.println(b.length + " " + b[1].length + " " + b[2].length)
    System.out.println("== elements built by hand ==")
    int[][] c = new int[][]{ new int[]{7, 8}, new int[]{9} }
    show(c)
    System.out.println(c[0][1])
    System.out.println("== the Java shorthand with no `new` ==")
    int[][] d = { {10, 20}, {30} }
    show(d)
    System.out.println("== a dimension left open ==")
    int[][] e = new int[2][]
    System.out.println(e.length)
    System.out.println(e[0] == null)
    e[1] = new int[]{5, 6}
    System.out.println(e[1][1])
    System.out.println("== three deep ==")
    int[][][] f = new int[2][2][2]
    f[1][1][1] = 4
    System.out.println(f[1][1][1])
    System.out.println(f[0][0].length)
    int[][][] g = { { {1}, {2, 3} }, { {} } }
    System.out.println(g[0][1][1] + " " + g[0][1].length + " " + g[1][0].length)
    System.out.println("== reference elements ==")
    String[][] s = new String[][]{ {"a", "b"}, {"c"} }
    System.out.println(s[0][1] + s[1][0])
    System.out.println(s.length + " " + s[0].length + " " + s[1].length)
    Object[][] o = new Object[2][1]
    o[0][0] = "boxed"
    System.out.println(o[0][0])
    System.out.println(o[1][0] == null)
    System.out.println("== an array as a type argument ==")
    List<int[]> xs = new ArrayList<int[]>()
    xs.add(new int[]{1, 2, 3})
    xs.add(new int[]{4})
    System.out.println(xs.get(0).length)
    System.out.println(xs.get(0)[2])
    System.out.println(xs.get(1).length)
    System.out.println(xs.size())
    for (int[] row : xs) {
      System.out.println(row.length)
    }
    System.out.println("== an empty array ==")
    int[] empty = new int[0]
    int[] alsoEmpty = {}
    System.out.println(empty.length + " " + alsoEmpty.length)
  }
}
