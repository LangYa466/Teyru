import lombok.*
import lombok.experimental.*

class Base {
  public int b
  public Base(int b) {
    this.b = b
  }
  public String toString() {
    return "Base(" + b + ")"
  }
  public int hashCode() {
    return b
  }
  public boolean equals(Object o) {
    return o instanceof Base && ((Base) o).b == b
  }
}

@ToString(callSuper = true)
@EqualsAndHashCode(callSuper = true)
class Derived extends Base {
  public int d
  public Derived(int b, int d) {
    super(b)
    this.d = d
  }
}

class Res implements AutoCloseable {
  private String name
  public Res(String name) {
    this.name = name
  }
  public void close() {
    System.out.println("closed " + name)
  }
  public String toString() {
    return "Res(" + name + ")"
  }
}

class Extensions {
  public static String shout(String s) {
    return s.toUpperCase() + "!"
  }
  public static int twice(int v) {
    return v * 2
  }
}

@ExtensionMethod({Extensions.class})
class Main {
  @SneakyThrows
  static int parse(String s) {
    return Integer.parseInt(s)
  }

  @Synchronized
  static void locked() {
    System.out.println("locked")
  }

  public static void main(String[] args) {
    Derived x = new Derived(1, 2)
    Derived y = new Derived(1, 2)
    System.out.println(x)
    System.out.println(x.equals(y))
    System.out.println(x.hashCode() == y.hashCode())

    {
      @Cleanup Res r = new Res("first")
      System.out.println("using " + r)
    }

    System.out.println(parse("42"))
    locked()
    System.out.println("hi".shout())
    System.out.println(5.twice())
  }
}
