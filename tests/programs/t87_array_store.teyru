// Java's arrays are covariant — Object[] o = new String[2] is a legal widening
// — but the array still promises String for its elements, so storing an Integer
// through the wider view has to throw ArrayStoreException rather than leave an
// object the array never promised in the slot. The program prints what it
// caught and what the array holds afterwards, so a silent store fails against
// javac's output.
class Main {
  public static void main(String[] args) {
    Object[] o = new String[2]
    o[0] = "hello"
    o[1] = "world"
    try {
      o[0] = Integer.valueOf(5)
      System.out.println("stored an Integer")
    } catch (ArrayStoreException e) {
      System.out.println("caught ArrayStoreException")
    }
    System.out.println("o[0] = " + o[0])
    System.out.println("o[1] = " + o[1])
    o[0] = null
    System.out.println("o[0] = " + o[0])
    Object[] plain = new Object[2]
    plain[0] = Integer.valueOf(5)
    System.out.println("plain[0] = " + plain[0])
  }
}
