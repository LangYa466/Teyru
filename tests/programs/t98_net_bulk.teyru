// A payload bigger than one read, and a line bigger than the line buffer.
//
// The layer's two loops only run when there is more data than the kernel is
// willing to move at once, and on loopback that takes a real payload. There is
// no thread here to be the other end of a back-pressured socket, so this test
// covers the half of it that one thread can: a read that comes back short and a
// line that arrives in several pieces. The write loop's repeated-iteration case
// -- a send buffer that is full and a peer that is not reading -- is covered in
// tests/native/net_c_test.c, where the reader is a forked child.

class Main {
  public static void main(String[] args) {
    final int SIZE = 131072 // 128 KiB

    byte[] up = new byte[SIZE]
    for (int i = 0 : i < SIZE : i++) {
      // A pattern with no period that divides the size, so a chunk arriving out
      // of place cannot pass for one that arrived where it belongs.
      up[i] = (byte) ((i * 31 + 7) & 255)
    }

    ServerSocket server = new ServerSocket(0)
    server.setSoTimeout(5000)
    Socket client = new Socket("127.0.0.1", server.getLocalPort(), 5000)
    client.setSoTimeout(5000)
    Socket conn = server.accept()
    conn.setSoTimeout(5000)

    // The whole payload in one call. The client is one thread, so this returns
    // only once the kernel has taken all of it -- the loop inside the layer is
    // what makes that true when the buffer cannot hold it.
    long before = System.currentTimeMillis()
    int sent = client.write(up, 0, SIZE)
    System.out.println("sent: " + sent)

    // ... and read back the same way, with readFully looping over whatever
    // short reads the kernel has for us.
    byte[] down = new byte[SIZE]
    conn.getInputStream().readFully(down, 0, SIZE)
    boolean same = true
    for (int i = 0 : i < SIZE : i++) {
      if (up[i] != down[i]) {
        same = false
        break
      }
    }
    System.out.println("server got every byte: " + same)

    // Back the other way, so both directions have carried the payload.
    conn.getOutputStream().write(down, 0, SIZE)
    byte[] back = new byte[SIZE]
    client.getInputStream().readFully(back, 0, SIZE)
    boolean round = true
    for (int i = 0 : i < SIZE : i++) {
      if (up[i] != back[i]) {
        round = false
        break
      }
    }
    System.out.println("client got every byte: " + round)
    System.out.println("took under 10s: " + (System.currentTimeMillis() - before < 10000))

    // A line of 100 000 bytes, which is thirteen times the reader's buffer: the
    // line reader has to keep what it has, fill again, and join the two.
    StringBuilder sb = new StringBuilder()
    for (int i = 0 : i < 100000 : i++) {
      sb.append((char) (97 + i % 26))
    }
    String huge = sb.toString()
    client.getOutputStream().write(huge)
    client.getOutputStream().write("\n")
    String line = conn.getInputStream().readLine()
    System.out.println("long line: " + (line.length() == 100000))
    System.out.println("long line matches: " + line.equals(huge))

    // A line that ends at the terminator, with a byte after it left over in the
    // buffer -- so the position the reader keeps is exercised right after a
    // line that filled it many times over. The half close is what ends the
    // last line: "two" has no terminator, and a reader that waited for one
    // would sit there until its deadline, which is what Java's does too.
    client.getOutputStream().write("one\ntwo")
    client.shutdownOutput()
    System.out.println("after: " + conn.getInputStream().readLine())
    System.out.println("after: " + conn.getInputStream().readLine())
    System.out.println("after: " + (conn.getInputStream().readLine() == null))

    client.close()
    conn.close()
    server.close()
  }
}
