// Names and contents that a shell would read, written to a filesystem that
// never sees a shell.
//
// The layer is fopen/read/write/opendir and nothing else. If any call went
// through system() -- or through popen, or through a command line built by
// joining strings -- these names would be split into arguments, glob-expanded,
// or executed, and the checks below are the ones that would notice. The names
// are exactly what a program that reads a user-supplied filename has to
// survive, and a semicolon in a path is not a rare input.

class Main {
  public static void main(String[] args) {
    Path dir = Files.createTempDirectory("teyru-t99q")

    // A filename with everything a shell treats specially. A space alone would
    // catch argument splitting; the rest catches substitution and redirection,
    // which is the half that does damage rather than merely failing.
    String nasty = "a b; c$(touch pwned) d`touch pwned2` e'f\"g*h&i|j>k"
    Path weird = dir.resolve(nasty)
    Files.writeString(weird, "contents are data, not a command line\n")
    System.out.println("written: " + Files.exists(weird))
    System.out.println("read back: " + Files.readString(weird).equals("contents are data, not a command line\n"))
    System.out.println("size: " + Files.size(weird))
    System.out.println("name preserved: " + weird.getFileName().toString().equals(nasty))

    // The listing is the real proof: the directory holds exactly one entry and
    // its name is the one asked for, byte for byte. A layer that had handed the
    // name to anything else would have produced a different name here -- or
    // several.
    String[] names = new File(dir.toString()).list()
    System.out.println("one entry: " + names.length)
    System.out.println("name exact: " + names[0].equals(nasty))

    // The command substitutions above name a path next to the file. Nothing ran
    // them, so neither exists. (This is the check that fails loudly if a shell
    // ever appears in the layer.)
    System.out.println("nothing executed: " + (!Files.exists(dir.resolve("pwned"))
      && !Files.exists(dir.resolve("pwned2"))))

    // A newline in a filename, which is legal on every unix and which every
    // line-oriented interface gets wrong. The path is passed as one byte string
    // and never parsed, so it round trips.
    Path nl = dir.resolve("line1\nline2.txt")
    Files.writeString(nl, "x")
    System.out.println("newline name: " + Files.exists(nl))
    System.out.println("newline size: " + Files.size(nl))

    // A backslash and a quote, in a file whose contents are also shell syntax.
    // The content check matters as much as the name check: a writer that built
    // its command from the data would execute this text.
    String text = "echo $(touch pwned3)\n\"rm -rf /\"\n`touch pwned4`"
    Path script = dir.resolve("has\\backslash and \"quote\"")
    Files.writeString(script, text)
    System.out.println("quote name: " + Files.exists(script))
    System.out.println("content preserved: " + Files.readString(script).equals(text))
    System.out.println("still nothing executed: " + (!Files.exists(dir.resolve("pwned3"))
      && !Files.exists(dir.resolve("pwned4"))))

    // A leading dash, which a program that passed the name to another command's
    // argv would have read as an option. There is no other command.
    Path dash = dir.resolve("-rf")
    Files.writeString(dash, "dash\n")
    System.out.println("dash name: " + Files.readString(dash).equals("dash\n"))

    // Directories with the same characters, since mkdir is the other place a
    // name becomes an argument.
    Path sub = dir.resolve("sub dir; with $things")
    Files.createDirectories(sub)
    System.out.println("dir: " + Files.isDirectory(sub))

    // Now remove all of it, still by name and still without a shell. A leading
    // dash matters here too: an rm handed "-rf" would have been asked to remove
    // something else entirely.
    Files.delete(dash)
    Files.delete(script)
    Files.delete(nl)
    Files.delete(weird)
    Files.delete(sub)
    Files.delete(dir)
    System.out.println("cleaned: " + !Files.exists(dir))
  }
}
