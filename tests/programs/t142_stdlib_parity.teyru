// Where the library and the language used to answer differently from javac.
//
// Every line here was checked against the same program compiled and run by
// javac 21: the overloads of Stream.of, the way an array argument picks between
// a fixed and a variable-arity method, and the range views a TreeSet hands out,
// which are live windows onto the set rather than copies.

class Overloads {
  static <T> String pick(T[] x) { return "array" }
  static <T> String pick(T x) { return "element" }
  static String choose(String[] v) { return "array" }
  static <T> String choose(T... v) { return "varargs" }
}

class Main {
  public static void main(String[] args) {
    // an array argument binds to the array, in a fixed parameter and in a
    // variable-arity one: of(String[]) streams the elements, not the array
    String[] names = {"a", "b"}
    System.out.println(Stream.of(names).count())
    System.out.println(Stream.of(names).map(n -> n.toUpperCase()).findFirst().get())
    System.out.println(Stream.of("x").count())
    System.out.println(Stream.of("x", "y", "z").count())
    System.out.println(Overloads.pick(names))
    System.out.println(Overloads.choose(names))

    // the head of a sorted set is a view: an element within its range goes
    // into the set it came from
    TreeSet<Integer> t = new TreeSet<Integer>()
    t.add(1)
    t.add(2)
    t.add(3)
    SortedSet<Integer> head = t.headSet(3)
    System.out.println(head.size())
    System.out.println(head.add(0))
    System.out.println(t.size() + " " + t.first())
    System.out.println(head.size())
    try {
      head.add(9)
    } catch (IllegalArgumentException e) {
      System.out.println("out of range: " + e.getMessage())
    }

    // and the tail is one too
    SortedSet<Integer> tail = t.tailSet(2)
    tail.add(5)
    System.out.println(t.last() + " " + t)

    // a map's key set still refuses to insert: it has no value to store
    Set<Integer> keys = new TreeMap<Integer, Integer>().keySet()
    try {
      keys.add(1)
    } catch (UnsupportedOperationException e) {
      System.out.println("key set refuses")
    }
  }
}
