/* Collections.shuffle against a seeded java.util.Random.

   The swap sequence is a function of the Random's own nextInt, so the same seed
   has to give the same order in both languages -- which also makes this a test
   of Random.next(bits) reproducing java.util.Random's generator exactly.
   Expected output is javac 25's. */

package teyru

class T129 {
  static List<Integer> nums(int n) {
    List<Integer> xs = new ArrayList<Integer>()
    for (int i = 0 : i < n : i++) { xs.add(i) }
    return xs
  }
  static List<String> words() {
    List<String> xs = new ArrayList<String>()
    xs.add("a")
    xs.add("b")
    xs.add("c")
    xs.add("d")
    xs.add("e")
    return xs
  }

  public static void main(String[] args) {
    System.out.println("== the same seed gives the same order ==")
    List<Integer> a = nums(10)
    Collections.shuffle(a, new Random(42L))
    System.out.println(a)
    List<Integer> b = nums(10)
    Collections.shuffle(b, new Random(42L))
    System.out.println(b)
    System.out.println("== and a different one does not ==")
    List<Integer> c = nums(10)
    Collections.shuffle(c, new Random(7L))
    System.out.println(c)
    List<Integer> d = nums(10)
    Collections.shuffle(d, new Random(0L))
    System.out.println(d)
    System.out.println("== of other element types, and small lists ==")
    List<String> w = words()
    Collections.shuffle(w, new Random(1L))
    System.out.println(w)
    System.out.println(nums(0))
    System.out.println(nums(1))
    List<Integer> one = nums(1)
    Collections.shuffle(one, new Random(5L))
    System.out.println(one)
    List<Integer> two = nums(2)
    Collections.shuffle(two, new Random(5L))
    System.out.println(two)
    System.out.println("== the generator itself ==")
    Random r = new Random(12345L)
    System.out.println(r.nextInt())
    System.out.println(r.nextInt(1000))
    System.out.println(r.nextLong())
    System.out.println(r.nextDouble())
    System.out.println(r.nextBoolean())
    System.out.println(r.nextGaussian())
    Random r2 = new Random(99L)
    byte[] buf = new byte[8]
    r2.nextBytes(buf)
    for (int i = 0 : i < buf.length : i++) {
      System.out.print(buf[i] + " ")
    }
    System.out.println()
  }
}
