// A primitive selector of a switch: JEP 507 asks whether the value converts to
// the pattern's type exactly, because the selector is not a box. The
// expectations are javac 25's output with --enable-preview for the same
// program.
class Main {
  static String fit(long v) {
    return switch (v) {
      case int i -> "int " + i
      default -> "other"
    }
  }

  static String shrink(int v) {
    return switch (v) {
      case byte b -> "byte " + b
      case short s -> "short " + s
      default -> "int " + v
    }
  }

  public static void main(String[] args) {
    System.out.println(fit(5L))
    System.out.println(fit(5000000000L))
    System.out.println(shrink(100))
    System.out.println(shrink(70000))
  }
}
