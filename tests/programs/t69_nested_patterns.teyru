interface Shape { }
record Circle(int r) implements Shape { }
record Square(int s) implements Shape { }
record Box(Shape a, Shape b) { }

record Point(int x, int y) { }
record Line(Point from, Point to) { }
record Grid(Line top, Line bottom) { }

class Outer {
  record Inner(int n) implements Shape { }
}
record Holder(Outer.Inner i) { }

class Main {
  public static void main(String[] args) {
    // a nested record pattern rejects a null component
    Object o1 = new Line(null, new Point(1, 2))
    if (o1 instanceof Line(Point(int a, int b), Point to)) {
      System.out.println("a matched " + a + "," + b + " " + to)
    } else {
      System.out.println("a no match")
    }
    // the same pattern with every component in place
    Object o2 = new Line(new Point(1, 2), new Point(3, 4))
    if (o2 instanceof Line(Point(int a, int b), Point to)) {
      System.out.println("b matched " + a + "," + b + " " + to)
    } else {
      System.out.println("b no match")
    }
    // a nested type pattern that names the component's own type is total: it
    // matches a null component
    Object o3 = new Line(new Point(5, 6), null)
    if (o3 instanceof Line(Point from, Point to)) {
      System.out.println("c matched " + from + " " + to)
    } else {
      System.out.println("c no match")
    }
    // a var pattern is total as well
    Object o4 = new Line(null, new Point(7, 8))
    if (o4 instanceof Line(var f, var t)) {
      System.out.println("d matched " + f + " " + t)
    } else {
      System.out.println("d no match")
    }
    // a nested type pattern narrower than the component's declared type tests
    // the component, and a component of a sibling type fails it
    Object o5 = new Box(new Square(3), new Circle(4))
    if (o5 instanceof Box(Circle c, Shape s)) {
      System.out.println("e matched " + c + " " + s)
    } else {
      System.out.println("e no match")
    }
    Object o6 = new Box(new Circle(3), new Square(4))
    if (o6 instanceof Box(Circle c, Shape s)) {
      System.out.println("f matched " + c + " " + s)
    } else {
      System.out.println("f no match")
    }
    // two levels of nesting
    Grid g1 = new Grid(new Line(new Point(1, 2), new Point(3, 4)), new Line(new Point(5, 6), new Point(7, 8)))
    Grid g2 = new Grid(null, new Line(new Point(5, 6), new Point(7, 8)))
    Grid g3 = new Grid(new Line(null, new Point(3, 4)), new Line(new Point(5, 6), new Point(7, 8)))
    if (g1 instanceof Grid(Line(Point(int a, int b), Point t), Line(Point(int c, int d), Point u))) {
      System.out.println("g1 matched " + a + b + c + d)
    } else {
      System.out.println("g1 no match")
    }
    if (g2 instanceof Grid(Line(Point(int a, int b), Point t), Line(Point(int c, int d), Point u))) {
      System.out.println("g2 matched " + a + b + c + d)
    } else {
      System.out.println("g2 no match")
    }
    if (g3 instanceof Grid(Line(Point(int a, int b), Point t), Line(Point(int c, int d), Point u))) {
      System.out.println("g3 matched " + a + b + c + d)
    } else {
      System.out.println("g3 no match")
    }
    // a nested pattern in a while condition is tested again on every round
    Object[] xs = { new Line(new Point(1, 2), new Point(3, 4)), new Line(null, new Point(5, 6)), new Point(9, 9) }
    int i = 0
    while (i < xs.length && xs[i] instanceof Line(Point(int a, int b), Point t)) {
      System.out.println("h " + i + " " + a + "," + b)
      i++
    }
    System.out.println("h stopped at " + i)
    // a nested pattern in a switch case
    Object[] ys = { new Line(new Point(1, 2), new Point(3, 4)), new Line(null, new Point(5, 6)), new Box(new Circle(3), new Square(4)) }
    for (Object v : ys) {
      switch (v) {
        case Line(Point(int a, int b), Point t) -> System.out.println("i line " + a + "," + b)
        case Box(Circle c, Shape s) -> System.out.println("i box " + c + " " + s)
        default -> System.out.println("i other")
      }
    }
    // a nested pattern in a switch case that also has a guard
    Object[] zs = { new Line(new Point(1, 2), new Point(3, 4)), new Line(new Point(9, 9), new Point(3, 4)) }
    for (Object v : zs) {
      System.out.println(switch (v) {
        case Line(Point(int a, int b), Point t) when a > 5 -> "j big " + a + "," + b
        case Line(Point(int a, int b), Point t) -> "j small " + a + "," + b
        default -> "j other"
      })
    }
    // the flat forms keep working
    Object p = new Point(11, 12)
    if (p instanceof Point(int x, int y)) {
      System.out.println("k flat " + (x + y))
    } else {
      System.out.println("k no match")
    }
    if (p instanceof Point pt) {
      System.out.println("l named " + pt.x())
    } else {
      System.out.println("l no match")
    }
    if (p instanceof Circle cr) {
      System.out.println("m circle " + cr.r())
    } else {
      System.out.println("m no match")
    }

    // a nested pattern that names a class nested in another, written with dots.
    // The component is of a sibling type, so the pattern has to test it.
    Object n1 = new Box(new Square(13), new Square(14))
    if (n1 instanceof Box(Outer.Inner c, Shape s)) {
      System.out.println("n sibling " + c + " " + s)
    } else {
      System.out.println("n no match")
    }
    Object n2 = new Box(new Outer.Inner(15), new Square(16))
    if (n2 instanceof Box(Outer.Inner c, Shape s)) {
      System.out.println("n matched " + c + " " + s)
    } else {
      System.out.println("n no match")
    }
    // the same, as a nested record pattern: a null component still rejects it
    Object n3 = new Holder(new Outer.Inner(17))
    if (n3 instanceof Holder(Outer.Inner(int k))) {
      System.out.println("o matched " + k)
    } else {
      System.out.println("o no match")
    }
    Object n4 = new Holder(null)
    if (n4 instanceof Holder(Outer.Inner(int k))) {
      System.out.println("o null matched " + k)
    } else {
      System.out.println("o null no match")
    }
  }
}
