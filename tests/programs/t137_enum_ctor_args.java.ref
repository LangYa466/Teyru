// The Java this test is the oracle for. Compiled with javac 25 and run to
// produce t137_enum_ctor_args.expected; it is not part of the Teyru build.
enum Plain {
  RED,
  GREEN
}

enum Size {
  SMALL(1, "small"),
  LARGE(9, "large");

  private final int weight;
  private final String label;

  Size(int weight, String label) {
    this.weight = weight;
    this.label = label;
  }

  public int weight() {
    return weight;
  }

  public String describe() {
    return label + "(" + weight + ")";
  }
}

enum Op {
  ADD(1) {
    public int apply(int a, int b) {
      return a + b;
    }
  },
  MUL(2) {
    public int apply(int a, int b) {
      return a * b;
    }
  };

  private final int code;

  Op(int code) {
    this.code = code;
  }

  public int code() {
    return code;
  }

  public abstract int apply(int a, int b);
}

public class T137 {
  public static void main(String[] args) {
    System.out.println("== a constant with no arguments ==");
    for (Plain p : Plain.values()) {
      System.out.println(p + " " + p.ordinal() + " " + p.name());
    }
    System.out.println(Plain.valueOf("GREEN"));

    System.out.println("== arguments reach the constructor ==");
    for (Size s : Size.values()) {
      System.out.println(s + " " + s.weight() + " " + s.describe());
    }
    System.out.println(Size.SMALL.weight() + Size.LARGE.weight());
    System.out.println(Size.valueOf("LARGE").describe());

    System.out.println("== and a constant with a body ==");
    for (Op o : Op.values()) {
      System.out.println(o + " code=" + o.code() + " apply=" + o.apply(6, 7));
    }
    System.out.println(Op.ADD.code() + Op.MUL.code());
  }
}
