// A switch expression must cover every value: an enum selector that names all
// of its constants is exhaustive without a default, while a switch statement
// needs no default at all. javac accepts both and prints the same lines.
enum Color { RED, GREEN, BLUE }

class Main {
  static String name(Color c) {
    return switch (c) {
      case RED -> "r"
      case GREEN -> "g"
      case BLUE -> "b"
    }
  }

  // the same constants again, written the qualified way
  static String qualified(Color c) {
    return switch (c) {
      case Color.RED -> "R"
      case Color.GREEN -> "G"
      case Color.BLUE -> "B"
    }
  }

  static String fit(int n) {
    return switch (n) {
      case 1 -> "one"
      default -> "many"
    }
  }

  public static void main(String[] args) {
    System.out.println(name(Color.RED) + name(Color.GREEN) + name(Color.BLUE))
    System.out.println(qualified(Color.RED) + qualified(Color.BLUE))
    System.out.println(fit(1) + " " + fit(7))
    int n = 7
    switch (n) {
      case 1:
        System.out.println("one")
        break
    }
    System.out.println("done " + n)
  }
}
