/* A Boolean in a boolean context. `Boolean b = false; if (b)` used to take the
   then-branch, because the condition reached C as a pointer test and every
   Boolean is a non-null pointer. Every expected line is javac 25's output for
   this same program. */

package teyru

interface Fn<T, R> { R apply(T t) }

class T111 {
  static boolean id(boolean v) { return v }
  static <X> boolean generic(X flag) { return (Boolean) flag }

  public static void main(String[] args) {
    Boolean f = false
    Boolean t = true
    System.out.println("== if ==")
    if (f) { System.out.println("wrong") } else { System.out.println("f is false") }
    if (t) { System.out.println("t is true") } else { System.out.println("wrong") }
    System.out.println("== ternary ==")
    System.out.println(f ? "t" : "f")
    System.out.println(t ? "t" : "f")
    System.out.println(f ? (t ? "a" : "b") : "c")
    System.out.println("== negation and assignment ==")
    System.out.println(!f)
    System.out.println(!t)
    boolean c = f
    System.out.println(c)
    boolean d = t
    System.out.println(d)
    System.out.println(id(f))
    System.out.println(id(t))
    System.out.println(generic(t))
    System.out.println("== while and for ==")
    int n = 0
    Boolean go = true
    while (go) {
      n++
      if (n >= 3) { go = false }
    }
    System.out.println(n)
    int m = 0
    for (Boolean k = true : k : k = false) {
      m++
      if (m >= 2) { k = false }
    }
    System.out.println(m)
    System.out.println("== from a call ==")
    Fn<String, Boolean> isLong = s -> s.length() > 1
    System.out.println(isLong.apply("a"))
    System.out.println(isLong.apply("ab"))
    if (isLong.apply("abc")) { System.out.println("long") }
    if (!isLong.apply("x")) { System.out.println("short") }
    System.out.println("== valueOf and parse ==")
    System.out.println(Boolean.valueOf(false) ? "y" : "n")
    System.out.println(Boolean.parseBoolean("true") ? "y" : "n")
    System.out.println(Boolean.parseBoolean("nope") ? "y" : "n")
  }
}
