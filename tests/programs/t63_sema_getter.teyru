import lombok.AccessLevel
import lombok.Getter
import lombok.Setter

@Getter
@Setter
class Counter {
  static int made = 0
  int value = 4
  @Getter(AccessLevel.NONE) int hidden = 9

  Counter() {
    made++
  }
}

@Getter(AccessLevel.NONE)
class Quiet {
  int plain = 1
}

class Main {
  public static void main(String[] args) {
    Counter c = new Counter()
    System.out.println(c.getValue())
    System.out.println(Counter.getMade())
    System.out.println(c.hidden)
    c.setValue(8)
    System.out.println(c.getValue())
    System.out.println(Counter.made)
    Quiet q = new Quiet()
    System.out.println(q.plain)
  }
}
