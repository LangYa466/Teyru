// The whole web stack over a real socket.
//
// The server and the client are the same program, in one thread: the client
// connects first, which the kernel queues, and only then does the server
// accept. That is what makes a socket round trip testable in a language with no
// threads -- and it exercises everything the framework does except the parts
// that are already covered by t102 (routing, parameter binding, JSON).

import teyru.*

class Pet {
  String name
  int age
  Pet() {
    name = "?"
    age = -1
  }
  Pet(String n, int a) {
    name = n
    age = a
  }
}

@Service
class PetStore {
  private int lookups = 0
  Pet find(int id) {
    lookups++
    return new Pet("pet" + id, id * 10)
  }
  String stat() { return "lookups=" + lookups }
}

@RestController
@RequestMapping("/pets")
class PetController {
  @Autowired PetStore store

  @GetMapping("/{id}")
  Pet one(@PathVariable("id") int id) { return store.find(id) }

  @GetMapping("/stat")
  String stat() { return store.stat() }

  @GetMapping("")
  String list(@RequestParam(value = "q", defaultValue = "all") String q) { return "q=" + q }
}

class Main {
  public static void main(String[] args) {
    ApplicationContext ctx = Application.boot(args)
    Router router = Application.routerFrom(ctx)
    HttpServer server = new HttpServer(0, router, ctx)

    // port 0 asks the kernel for any free port, so the test never collides with
    // whatever else is running; bind is what turns it into a real number
    server.bind()
    int port = server.getPort()

    System.out.println("routes=" + router.size())

    exchange(server, port, "GET /pets/7 HTTP/1.1\r\nHost: x\r\n\r\n")
    exchange(server, port, "GET /pets?q=cat HTTP/1.1\r\nHost: x\r\n\r\n")
    exchange(server, port, "GET /pets/stat HTTP/1.1\r\nHost: x\r\n\r\n")
    exchange(server, port, "GET /nope HTTP/1.1\r\nHost: x\r\n\r\n")

    server.close()
  }

  // exchange is one client request against the server, in one thread: the
  // client connects and writes first (the kernel queues the connection), then
  // the server answers it, then the client reads what came back.
  static void exchange(HttpServer server, int port, String request) {
    Socket client = new Socket("127.0.0.1", port)
    client.setSoTimeout(5000)
    SocketOutputStream out = client.getOutputStream()
    out.write(request)
    out.flush()

    // idle 0 would answer only what is already waiting; a short wait keeps the
    // loop honest about there being exactly one connection
    int answered = server.serveIdle(200)

    SocketInputStream in = client.getInputStream()
    byte[] buf = new byte[4096]
    StringBuilder got = new StringBuilder()
    int n = in.read(buf, 0, 4096)
    while (n > 0) {
      got.append(Net.stringFrom(buf, 0, n))
      n = in.read(buf, 0, 4096)
    }
    client.close()

    String text = got.toString()
    int headEnd = text.indexOf("\r\n\r\n")
    String head = headEnd < 0 ? text : text.substring(0, headEnd)
    String body = headEnd < 0 ? "" : text.substring(headEnd + 4)
    System.out.println("answered=" + answered + " | " + firstLine(head) + " | " + body)
  }

  static String firstLine(String head) {
    int nl = head.indexOf("\n")
    return nl < 0 ? head : head.substring(0, nl - 1)
  }
}
