import lombok.*

// @Builder(toBuilder = true): toBuilder() copies the instance it is called on,
// so the fields the caller does not touch keep their values, and the object
// the copy came from is left alone.
@Builder(toBuilder = true)
@Getter
class Point {
  private int x
  private int y
  private String name
}

class Main {
  public static void main(String[] args) {
    Point p = Point.builder().x(1).y(2).name("origin").build()
    Point q = p.toBuilder().y(9).build()
    System.out.println(q.getX() + " " + q.getY() + " " + q.getName())
    System.out.println(p.getX() + " " + p.getY() + " " + p.getName())
  }
}
