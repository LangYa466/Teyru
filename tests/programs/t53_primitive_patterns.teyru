// JEP 507 has two rules, and the static type of the operand picks which one
// applies. A reference operand carries a box, and the box must be exactly the
// pattern's type: an Integer matches `int i` but not `long l`, even though the
// value would convert. A primitive operand only has to convert exactly, so
// `16777216 instanceof float` matches and 9007199254740993L does not convert to
// a double. Every expectation below is what javac 25 prints for the same
// program with --enable-preview.
class Main {
  static String rank(Object o) {
    return switch (o) {
      case int i when i > 100 -> "large int"
      case int i -> "int " + i
      case long l -> "long " + l
      case double d -> "double " + d
      default -> "other"
    }
  }

  static String flags(Object o) {
    if (o instanceof boolean b && b) {
      return "true"
    }
    if (o instanceof char c) {
      return "char " + (int) c
    }
    return "none"
  }

  public static void main(String[] args) {
    Object[] xs = {42, 300L, 1.5, "str"}
    for (Object o : xs) {
      System.out.println(rank(o))
    }

    System.out.println(flags(true))
    System.out.println(flags(false))
    System.out.println(flags(65))
    System.out.println(flags("x"))

    // exactness of the conversion decides, not the boxed class
    Object big = 16777217
    System.out.println((big instanceof float f) + " " + (big instanceof double d))
    System.out.println((16777216 instanceof float f2) + " " + (16777216 instanceof double d2))
    Object huge = 9007199254740993L
    System.out.println((huge instanceof double d3) + " " + (huge instanceof long l3))
    System.out.println(9007199254740992L instanceof double d4)

    // a value outside the target range does not match
    Object wide = 70000
    System.out.println((wide instanceof short s) + " " + (wide instanceof int i2))
    System.out.println((wide instanceof char c2) + " " + (65535 instanceof char c3))

    // null never matches
    Object nothing = null
    System.out.println(nothing instanceof int ni)
  }
}
