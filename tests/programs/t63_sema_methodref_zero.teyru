interface Maker {
  String make()
}

class Product {
  String name

  Product(String n) {
    this.name = n
  }

  String describe() {
    return "P:" + name
  }
}

class Main {
  static String tag() {
    return "static-tag"
  }

  public static void main(String[] args) {
    Product p = new Product("box")
    // a functional interface with no parameters still binds a receiver, a static
    // method and a lambda, none of which may be confused with the unbound form
    Maker bound = p::describe
    System.out.println(bound.make())
    Maker stat = Main::tag
    System.out.println(stat.make())
    Maker lam = () -> "lambda"
    System.out.println(lam.make())
  }
}
