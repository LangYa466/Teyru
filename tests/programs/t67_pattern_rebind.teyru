// A pattern in the condition of a loop binds its variable on every evaluation
// of that condition, not once when the loop is entered: Java assigns the
// binding in the condition and gives it the scope of the body.
record Point(int x, int y) {
}

record Line(Point from, Point to) {
}

class Main {
  static int calls = 0

  static int next() {
    calls++
    return calls - 1
  }

  public static void main(String[] args) {
    Object[] xs = {"a", "b", "c"}

    // 1. the binding follows every evaluation of a while condition
    int i = 0
    while (i < 3 && xs[i] instanceof String s) {
      System.out.println("while " + i + " " + s)
      i++
    }
    System.out.println("while i=" + i)

    // 2. the same for the condition of a for
    for (int j = 0 : j < 3 && xs[j] instanceof String t : j++) {
      System.out.println("for " + j + " " + t)
    }

    // 3. and for the condition of a do-while, which runs after the body
    Object[] ys = {"p", "qq", "rrr", "zz"}
    int k = 0
    do {
      System.out.println("do body " + k)
      k++
    } while (k < 4 && ys[k] instanceof String d && d.length() >= 2)
    System.out.println("do k=" + k)

    // 4. if binds once, as always
    if (xs[1] instanceof String f) {
      System.out.println("if " + f)
    }

    // 5. a source with a side effect runs once per evaluation of the condition
    Object[] zs = {"z0", "z1", "z2", "z3", "z4", "z5"}
    calls = 0
    int m = 0
    while (m < 3 && zs[next()] instanceof String w) {
      System.out.println("side " + w)
      m++
    }
    System.out.println("calls=" + calls + " m=" + m)

    // a failing evaluation still reads the source exactly once
    Object[] mixed = {"m0", Integer.valueOf(1), "m2", "m3"}
    calls = 0
    int n = 0
    while (n < 4 && mixed[next()] instanceof String q) {
      System.out.println("mixed " + q)
      n++
    }
    System.out.println("mixed calls=" + calls + " n=" + n)

    // 6. a record pattern in a loop condition rebinds its components
    Object[] pts = {new Point(1, 2), new Point(3, 4), "nope", new Point(5, 6)}
    int p = 0
    while (p < 4 && pts[p] instanceof Point(int x, int y)) {
      System.out.println("point " + x + "," + y)
      p++
    }
    System.out.println("p=" + p)

    Object[] lines = {new Line(new Point(1, 1), new Point(2, 2)),
                      new Line(new Point(3, 3), new Point(4, 4))}
    for (int r = 0 : r < 2 && lines[r] instanceof Line(Point(int fx, int fy), Point to) : r++) {
      System.out.println("line " + fx + "," + fy + " -> " + to.x() + "," + to.y())
    }

    // 7. two patterns in one condition are both rebound
    Object[] pair = {"a", "bb", "ccc"}
    int u = 0
    while (u < 3 && pair[u] instanceof String s1 && pair[u] instanceof Object o1) {
      System.out.println("multi " + s1 + "/" + (o1 != null))
      u++
    }
    System.out.println("u=" + u)

    // 8. a later operand of the condition reads the binding of an earlier one
    Object[] words = {"hi", "there", "", "x"}
    int v = 0
    while (v < 4 && words[v] instanceof String s2 && s2.length() > 1) {
      System.out.println("guard " + s2)
      v++
    }
    System.out.println("v=" + v)

    // 9. a conditional source rebinds on every evaluation
    Object p1 = "alpha"
    Object p2 = Integer.valueOf(3)
    int t = 0
    while (t < 2 && (t == 0 ? p1 : p2) instanceof String z) {
      System.out.println("ternary " + z)
      t++
    }
    System.out.println("ternary t=" + t)

    // a binding that goes stale is not reused as the type test
    Object slot = "first"
    int g = 0
    while (g < 3 && slot instanceof String h) {
      System.out.println("stale " + h)
      g++
      slot = Integer.valueOf(7)
    }
    System.out.println("g=" + g)
  }
}
