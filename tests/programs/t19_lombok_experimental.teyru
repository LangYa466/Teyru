import lombok.*
import lombok.experimental.*

interface Sayer {
  String say()
  int count()
}

class Speaker implements Sayer {
  public String say() {
    return "hello"
  }
  public int count() {
    return 3
  }
}

@FieldNameConstants
class Fields {
  private String userName
  private int userAge
  public String getUserName() {
    return userName
  }
}

@Value(staticConstructor = "of")
class Pair {
  int left
  int right
}

class Host {
  @Delegate
  private Sayer speaker = new Speaker()

  @Tolerate
  public String say() {
    return "custom"
  }

  @Helper
  class Helper1 {
    int twice(int v) {
      return v * 2
    }
  }
}

class Pizza2 {
  private String size
  public Pizza2() {
  }

  @Builder
  public Pizza2(@NonNull String size) {
    this.size = size
  }

  public String getSize() {
    return size
  }
}

class Main {
  public static void main(String[] args) {
    Pair p = Pair.of(1, 2)
    System.out.println(p.getLeft() + p.getRight())
    System.out.println(p)

    System.out.println(Fields.Fields.userName)
    System.out.println(Fields.Fields.userAge)

    Host h = new Host()
    System.out.println(h.say())
    System.out.println(h.count())

    Pizza2 pz = Pizza2.builder().size("large").build()
    System.out.println(pz.getSize())
  }
}
