// The Java this test is the oracle for. Compiled with javac 25 and run to
// produce t136_qualified_member.expected; it is not part of the Teyru build.
class Outer {
  int v;

  Outer(int v) {
    this.v = v;
  }

  class Inner {
    int get() {
      return v;
    }
  }

  static class Plain {
    int get() {
      return 7;
    }
  }
}

public class T136 {
  static Outer.Inner fromOutside(Outer o) {
    return o.new Inner();
  }

  public static void main(String[] args) {
    Outer o = new Outer(3);
    Outer.Inner a = o.new Inner();
    System.out.println(a.get());
    System.out.println(fromOutside(o).get());
    Outer.Inner b = o.new Inner();
    System.out.println(b.get());
    Outer.Plain p = new Outer.Plain();
    System.out.println(p.get());
  }
}
