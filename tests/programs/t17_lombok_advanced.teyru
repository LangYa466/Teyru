import lombok.*
import lombok.experimental.*
import lombok.extern.slf4j.*

@Value
class Money {
  String currency
  int amount
}

@Builder
@lombok.Getter
class Pizza {
  String name
  int size
  boolean cheese
}

@UtilityClass
class MathUtil {
  int doubleIt(int v) {
    return v * 2
  }
  int square(int v) {
    return v * v
  }
}

@Slf4j
class Service {
  public void run() {
    log.info("running")
  }
  @NonNull
  public String greet(@NonNull String who) {
    return "hi " + who
  }
}

class Person2 {
  @Getter
  private String name

  @Accessors(chain = true)
  public Person2 setName2(String n) {
    name = n
    return this
  }

  @With
  private int age

  public Person2() {
  }
  public Person2(String name, int age) {
    this.name = name
    this.age = age
  }
  public int getAge() {
    return age
  }
}

@lombok.Getter(lazy = true)
class Lazy {
  private String expensive = compute()
  static String compute() {
    return "computed"
  }
}

class Main {
  public static void main(String[] args) {
    Money m = new Money("TWD", 100)
    System.out.println(m.getCurrency() + m.getAmount())
    System.out.println(m)

    Pizza p = Pizza.builder().name("margherita").size(12).cheese(true).build()
    System.out.println(p.getName() + "/" + p.getSize() + "/" + p.isCheese())

    System.out.println(MathUtil.doubleIt(21))
    System.out.println(MathUtil.square(5))

    Service s = new Service()
    s.run()
    System.out.println(s.greet("world"))

    Person2 a = new Person2("x", 1)
    Person2 b = a.withAge(9)
    System.out.println(a.getAge() + " " + b.getAge())

    Lazy lz = new Lazy()
    System.out.println(lz.getExpensive())
  }
}
