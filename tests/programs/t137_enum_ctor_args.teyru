/* An enum constant may carry arguments, and they go to the enum's own
   constructor -- the one declared after the `:`. Nothing called it. A constant
   without a body dropped its arguments outright: `P(1)` answered `P.v() == 0`
   where javac answers 1. A constant with a body is a subclass of the enum, and
   the constructor that subclass was given took no arguments and chained to one
   that has them, passing none, so the generated C did not compile at all.

   Both shapes are here, and an enum with no arguments at all is the control.
   Every constant also reads back a field the constructor set, which is what a
   dropped argument changes.

   Expected output is javac 25's. */

package teyru

enum Plain {
  RED,
  GREEN
}

enum Size {
  SMALL(1, "small"),
  LARGE(9, "large")
  :
  private final int weight
  private final String label

  Size(int weight, String label) {
    this.weight = weight
    this.label = label
  }

  public int weight() {
    return weight
  }

  public String describe() {
    return label + "(" + weight + ")"
  }
}

enum Op {
  ADD(1) {
    public int apply(int a, int b) {
      return a + b
    }
  },
  MUL(2) {
    public int apply(int a, int b) {
      return a * b
    }
  }
  :
  private final int code

  Op(int code) {
    this.code = code
  }

  public int code() {
    return code
  }

  public abstract int apply(int a, int b)
}

class T137 {
  public static void main(String[] args) {
    System.out.println("== a constant with no arguments ==")
    for (Plain p : Plain.values()) {
      System.out.println(p + " " + p.ordinal() + " " + p.name())
    }
    System.out.println(Plain.valueOf("GREEN"))

    System.out.println("== arguments reach the constructor ==")
    for (Size s : Size.values()) {
      System.out.println(s + " " + s.weight() + " " + s.describe())
    }
    System.out.println(Size.SMALL.weight() + Size.LARGE.weight())
    System.out.println(Size.valueOf("LARGE").describe())

    System.out.println("== and a constant with a body ==")
    for (Op o : Op.values()) {
      System.out.println(o + " code=" + o.code() + " apply=" + o.apply(6, 7))
    }
    System.out.println(Op.ADD.code() + Op.MUL.code())
  }
}
