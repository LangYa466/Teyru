// System.exit(status) ends the program there and then: the statements after it
// never run, and the exit status is the status the program asks for (0 here, so
// the harness still counts the run as successful). Anything already printed is
// not lost -- exit() flushes the stdio buffers.
class Main {
  public static void main(String[] args) {
    System.out.println("before exit")
    System.err.println("stderr before exit")
    System.exit(0)
    System.out.println("after exit")
  }
}
