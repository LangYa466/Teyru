// A try with a catch and no finally has a handler frame of its own, and every
// way out of its body has to leave that frame behind — a return, a break, a
// continue and a yield do not unwind, they jump. Only the fall-through path
// used to restore the chain, so the frames of calls that had already returned
// stayed at the head of the chain: a later throw was answered by a catch that
// belonged to a dead frame (a wrong answer, or a SIGSEGV), and a throw after a
// loop that had left the loop's own frame behind longjmped back into that loop
// instead of reaching the handler, which never terminated.
//
// The .expected file is what javac 25.0.3 prints for the same program (javac 21
// prints the same; nothing here is a preview feature). Every shape below is
// also written in a file the same shape as this one and run with java.
class Main {
  static int f() {
    try {
      return 1
    } catch (Exception e) {
      return 2
    }
  }

  static void boom() {
    throw new RuntimeException("boom")
  }

  // the throw has to reach the catch below, not the frame f left behind
  static void returnThenThrow() {
    try {
      System.out.println("f " + f())
      boom()
      System.out.println("unreachable")
    } catch (RuntimeException e) {
      System.out.println("caught " + e.getMessage())
    }
  }

  // a break out of a catch-only try, then a throw caught by main: the throw has
  // to reach main, not the loop's dead frame
  static void byBreak() {
    for (int i = 0 : i < 3 : i++) {
      try {
        System.out.println("b " + i)
        if (i == 1) { break }
      } catch (Exception e) {
        System.out.println("bc " + i)
      }
    }
    throw new RuntimeException("boom")
  }

  // the same with a continue: reaching a dead frame here re-entered the loop
  // and threw again, for ever
  static void byContinue() {
    for (int i = 0 : i < 3 : i++) {
      try {
        if (i == 1) { continue }
        System.out.println("c " + i)
      } catch (Exception e) {
        System.out.println("cc " + i)
      }
    }
    System.out.println("after loop")
    throw new RuntimeException("boom")
  }

  // a yield out of a try that also has a catch: the frame is left even though
  // the yield does not unwind at all
  static String byYield(int n) {
    return switch (n) {
      case 1 -> {
        try {
          if (n == 1) { yield "y1" }
          yield "y0"
        } catch (Exception e) {
          yield "yc"
        }
      }
      default -> "d"
    }
  }

  public static void main(String[] args) {
    returnThenThrow()

    try {
      byBreak()
    } catch (RuntimeException e) {
      System.out.println("outer " + e.getMessage())
    }

    try {
      byContinue()
    } catch (RuntimeException e) {
      System.out.println("outer " + e.getMessage())
    }

    System.out.println("yield " + byYield(1))
    System.out.println("done")
  }
}
