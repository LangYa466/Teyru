== documents Gson accepts too ==
accept null | null
accept true | true
accept false | false
accept 0 | 0
accept -0 | -0
accept 1e5 | 1e5
accept -1.5E-3 | -1.5E-3
accept 10000000000000000000 | 10000000000000000000
accept 1e999 | 1e999
accept "" | ""
accept {} | {}
accept [] | []
accept [[[]]] | [[[]]]
accept {"":""} | {"":""}
accept [1,2] | [1,2]
accept "\uD83D\uDE00" | "😀"
accept "\ud83d\ude00" | "😀"
accept with whitespace | {"a":[1,2]}
