import teyru.*

/* The java.util containers, one contract at a time: what each one promises
 * about order, what it promises about equality, and what it returns when the
 * element is not there.
 *
 * The expectations in t96_util_containers.expected are the output of the same
 * program written with the JDK's java.util and run on Java 25, so a
 * disagreement here is a disagreement with the JDK -- including the HashMap
 * line, whose order comes from the JDK's hash spreading and bin layout. */

// a key type of the program's own: equals and hashCode have to agree or the
// map below cannot find what it stored
class Key {
  private int a
  private String b

  public Key(int a, String b) {
    this.a = a
    this.b = b
  }

  public boolean equals(Object o) {
    if (o == this) {
      return true
    }
    if (!(o instanceof Key)) {
      return false
    }
    Key k = (Key) o
    return a == k.a && b.equals(k.b)
  }

  public int hashCode() {
    return 31 * a + b.hashCode()
  }

  public String toString() {
    return a + ":" + b
  }
}

class Main {
  public static void main(String[] args) {
    // LinkedHashMap keeps insertion order, TreeMap keeps key order
    Map<String, Integer> linked = new LinkedHashMap<String, Integer>()
    linked.put("zebra", 1)
    linked.put("apple", 2)
    linked.put("mango", 3)
    System.out.println(linked.put("apple", 9))
    System.out.println(linked)
    System.out.println(linked.keySet())
    System.out.println(new ArrayList<Integer>(linked.values()))
    Map<String, Integer> tree = new TreeMap<String, Integer>()
    tree.put("zebra", 1)
    tree.put("apple", 9)
    tree.put("mango", 3)
    System.out.println(tree)
    System.out.println(tree.keySet())
    System.out.println(linked.equals(tree))
    System.out.println(linked.hashCode() == tree.hashCode())
    Map<String, Integer> lost = new HashMap<String, Integer>()
    lost.put("zebra", 1)
    lost.put("apple", 9)
    lost.put("mango", 3)
    System.out.println(lost)

    // HashSet dedups, LinkedHashSet remembers the first position
    Set<String> set = new HashSet<String>()
    System.out.println(set.add("b"))
    System.out.println(set.add("b"))
    set.add("a")
    set.add("c")
    System.out.println(set.size())
    System.out.println(set.contains("a"))
    Set<String> ordered = new LinkedHashSet<String>()
    ordered.add("b")
    ordered.add("a")
    ordered.add("b")
    System.out.println(ordered)
    System.out.println(set.equals(ordered))

    // TreeSet and its views
    TreeSet<Integer> numbers = new TreeSet<Integer>()
    numbers.add(5)
    numbers.add(1)
    numbers.add(9)
    numbers.add(3)
    numbers.add(7)
    System.out.println(numbers)
    System.out.println(numbers.first() + " " + numbers.last())
    System.out.println(numbers.ceiling(6) + " " + numbers.floor(6) + " " + numbers.higher(5) + " " + numbers.lower(5))
    SortedSet<Integer> head = numbers.headSet(5)
    SortedSet<Integer> tail = numbers.tailSet(5)
    SortedSet<Integer> sub = numbers.subSet(3, 7)
    System.out.println(head + " " + tail + " " + sub)
    System.out.println(numbers.headSet(5, true))
    System.out.println(numbers.tailSet(5, false))
    System.out.println(numbers.subSet(3, false, 7, true))
    System.out.println(numbers.descendingSet())
    SortedSet<Integer> view = numbers.headSet(5)
    numbers.add(2)
    System.out.println(view)
    System.out.println(numbers.pollFirst() + " " + numbers.pollLast())

    // ArrayDeque is both a stack and a queue
    Deque<String> stack = new ArrayDeque<String>()
    stack.push("a")
    stack.push("b")
    stack.push("c")
    System.out.println(stack)
    System.out.println(stack.pop())
    System.out.println(stack.peek())
    Deque<String> queue = new ArrayDeque<String>()
    queue.offer("one")
    queue.offer("two")
    queue.offer("three")
    System.out.println(queue)
    System.out.println(queue.poll())
    System.out.println(queue.pollLast())
    System.out.println(queue)
    System.out.println(queue.peekFirst() + " " + queue.peekLast())
    System.out.println(queue.isEmpty())

    // Arrays.sort with a comparator, and binarySearch
    String[] words = new String[]{"pear", "fig", "apple", "kiwi"}
    Arrays.sort(words, (a, b) -> a.length() - b.length())
    System.out.println(Arrays.toString(words))
    Arrays.sort(words)
    System.out.println(Arrays.toString(words))
    int[] nums = new int[]{9, 4, 7, 1, 4}
    Arrays.sort(nums)
    System.out.println(Arrays.toString(nums))
    System.out.println(Arrays.binarySearch(nums, 7))
    System.out.println(Arrays.binarySearch(nums, 4))
    System.out.println(Arrays.binarySearch(nums, 6))
    String[] names = new String[]{"ann", "bob", "cid"}
    System.out.println(Arrays.binarySearch(names, "bob"))
    System.out.println(Arrays.binarySearch(names, "zoe", (a, b) -> a.compareTo(b)))
    // a lambda's parameter types come from the target type, so a comparator
    // over Object needs the witness: see the note on Arrays.sort
    Comparator<Object> byHash = (a, b) -> a.hashCode() - b.hashCode()
    System.out.println(Arrays.binarySearch(new Object[]{"ann", "bob", "cid"}, "bob", byHash) >= -4)

    // Collections
    List<String> list = new ArrayList<String>()
    list.add("c")
    list.add("a")
    list.add("b")
    Collections.sort(list)
    System.out.println(list)
    Collections.<String>reverse(list)
    System.out.println(list)
    Collections.<String>swap(list, 0, 2)
    System.out.println(list)
    System.out.println(Collections.min(list) + " " + Collections.max(list))
    Comparator<String> reversed = Collections.reverseOrder()
    System.out.println(Collections.min(list, reversed).compareTo("") >= 0)
    System.out.println(Collections.frequency(list, "b"))
    System.out.println(Collections.disjoint(list, Arrays.asList("x", "y")))
    System.out.println(Collections.addAll(list, "d", "e") + " " + list)
    System.out.println(Collections.singletonList("only"))
    List<String> empty = Collections.emptyList()
    System.out.println(empty + " " + empty.isEmpty())
    Set<String> emptySet = Collections.emptySet()
    Map<String, String> emptyMap = Collections.emptyMap()
    System.out.println(emptySet + " " + emptyMap)
    System.out.println(Collections.nCopies(3, "x"))
    try {
      Collections.unmodifiableList(list).add("no")
      System.out.println("no throw")
    } catch (UnsupportedOperationException e) {
      System.out.println("unmodifiable")
    }

    // Objects
    System.out.println(Objects.equals(null, null))
    System.out.println(Objects.equals("a", "a"))
    System.out.println(Objects.hashCode(null))
    System.out.println(Objects.toString(null, "dflt"))
    System.out.println(Objects.hash("a", "b"))
    System.out.println(Objects.isNull(null) + " " + Objects.nonNull("x"))
    System.out.println(Objects.compare(3, 5, reversed(3, 5)))
    try {
      Objects.requireNonNull(null)
    } catch (NullPointerException e) {
      System.out.println("npe")
    }
    try {
      Objects.requireNonNull(null, "message here")
    } catch (NullPointerException e) {
      System.out.println(e.getMessage())
    }
    System.out.println(Objects.requireNonNull("ok"))
    System.out.println(Objects.requireNonNull("ok", "unused"))

    // Optional chains
    Optional<String> present = Optional.of("hello")
    System.out.println(present.isPresent() + " " + present.isEmpty())
    System.out.println(present.get())
    System.out.println(present.orElse("other"))
    System.out.println(present.orElseGet(() -> "made"))
    System.out.println(present.<Integer>map(s -> s.length()).orElse(-1))
    System.out.println(present.filter(s -> s.length() > 3).isPresent())
    System.out.println(present.filter(s -> s.length() > 9).isPresent())
    Optional<String> missing = Optional.empty()
    System.out.println(missing.isEmpty() + " " + missing.orElse("fallback"))
    System.out.println(missing.<Integer>map(s -> s.length()).orElse(-1))
    try {
      missing.get()
      System.out.println("no throw")
    } catch (NoSuchElementException e) {
      System.out.println("empty")
    }
    System.out.println(Optional.ofNullable(null).isEmpty())
    System.out.println(Optional.ofNullable("x").get())
    present.ifPresent(s -> System.out.println("seen " + s))

    // Map iteration and computeIfAbsent
    Map<String, List<String>> groups = new LinkedHashMap<String, List<String>>()
    String[] words2 = new String[]{"ant", "bee", "ape", "cow", "bat"}
    for (String w : words2) {
      groups.computeIfAbsent(w.substring(0, 1), k -> new ArrayList<String>()).add(w)
    }
    for (Map.Entry<String, List<String>> e : groups.entrySet()) {
      System.out.println(e.getKey() + " -> " + e.getValue())
    }
    Map<String, Integer> counts = new HashMap<String, Integer>()
    counts.put("a", 1)
    System.out.println(counts.computeIfAbsent("b", k -> 2) + " " + counts)
    System.out.println(counts.computeIfAbsent("a", k -> 99))
    System.out.println(counts.getOrDefault("zz", -1))

    // a user type as a key: equals and hashCode must agree
    Map<Key, String> byKey = new HashMap<Key, String>()
    byKey.put(new Key(1, "one"), "first")
    byKey.put(new Key(2, "two"), "second")
    System.out.println(byKey.get(new Key(1, "one")))
    System.out.println(byKey.containsKey(new Key(2, "two")))
    System.out.println(byKey.remove(new Key(2, "two")))
    System.out.println(byKey.size())
    Set<Key> keys = new HashSet<Key>()
    System.out.println(keys.add(new Key(1, "one")))
    System.out.println(keys.add(new Key(1, "one")))
    System.out.println(keys.size())
    System.out.println(new Key(3, "three").equals(new Key(3, "three")))
    System.out.println(new Key(3, "three").hashCode() == new Key(3, "three").hashCode())
  }

  // Objects.compare wants a comparator, and this dialect has no
  // Comparator.naturalOrder(): the JDK's own Collections.reverseOrder() is the
  // one factory java.util gives us
  private static Comparator<Integer> reversed(int a, int b) {
    return Collections.<Integer>reverseOrder()
  }
}
