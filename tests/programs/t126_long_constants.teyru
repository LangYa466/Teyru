/* A `static final long` used where its width matters.

   A constant field is inlined at each use, and the inlined text used to carry
   no suffix of its own: a value that fits in 32 bits became a C int, so
   `MASK << 63` shifted at 32-bit width and printed 1 where Java prints
   -9223372036854775808. Expected output is javac 25's for this same program. */

package teyru

class T126 {
  private static final long WORD_MASK = 0xffffffffffffffffL
  private static final long ONE = 1L
  private static final long HIGH = 0x7fffffffffffffffL
  private static final int SMALL = 7

  public static void main(String[] args) {
    System.out.println("== a long constant shifts as a long ==")
    System.out.println(WORD_MASK << 63)
    System.out.println(WORD_MASK << 1)
    System.out.println(WORD_MASK >> 1)
    System.out.println(WORD_MASK >>> 63)
    System.out.println(ONE << 40)
    System.out.println(HIGH >> 62)
    System.out.println("== an int constant stays an int ==")
    System.out.println(SMALL << 3)
    System.out.println(SMALL << 28)
    System.out.println("== and through a local ==")
    long m = WORD_MASK
    System.out.println(m << 63)
    System.out.println("== the same values written inline ==")
    System.out.println(0xffffffffffffffffL << 63)
    System.out.println(1L << 40)
    System.out.println("== a constant in other arithmetic ==")
    System.out.println(WORD_MASK + 1)
    System.out.println(ONE * 1000000000000L)
    System.out.println(WORD_MASK / 3)
    System.out.println(WORD_MASK | 0L)
    System.out.println(HIGH & WORD_MASK)
  }
}
