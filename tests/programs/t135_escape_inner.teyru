/* An object created by `x.new Inner()` holds x, and an object created by
   `new Inner()` inside a method of the class it is nested in holds `this`. Both
   were invisible to the escape analysis, which put the enclosing instance on
   the C stack and then let the created object outlive the frame that held it:
   AddressSanitizer reports the read as stack-use-after-scope, and without it
   the value read is whatever the stack slot was reused for.

   The two ways out are the two in here -- storing the object in a static field,
   and returning it from a method whose result goes to a static field -- and
   each is checked twice: once for the value the object reads back, and once by
   the run itself, since the bug is a bad read rather than a wrong answer.

   A local class and a static nested class are here as the controls: neither
   carries an enclosing instance, so both were always safe.

   Expected output is javac 25's. */



class T135 {
  static T135.Inner kept = null

  int v
  T135(int v) {
    this.v = v
  }

  class Inner {
    int get() {
      return v
    }
    String describe() {
      return "inner of " + v
    }
  }

  static class Plain {
    int get() {
      return 7
    }
  }

  Inner make() {
    return new Inner()
  }

  Inner makeQualified() {
    return this.new Inner()
  }

  public static void main(String[] args) {
    System.out.println("== an inner object made through a local ==")
    T135 a = new T135(12345)
    T135.Inner ia = a.new Inner()
    System.out.println(ia.get())
    System.out.println(ia.describe())
    kept = a.new Inner()
    System.out.println(kept.get())

    System.out.println("== an inner object returned from a method ==")
    T135 b = new T135(999)
    T135.Inner ib = b.make()
    System.out.println(ib.get())
    kept = b.make()
    System.out.println(kept.get())

    System.out.println("== and the same through this.new ==")
    T135 c = new T135(4242)
    kept = c.makeQualified()
    System.out.println(kept.get())

    System.out.println("== the controls ==")
    T135 d = new T135(5)
    System.out.println(d.new Inner().get())
    Plain p = new Plain()
    System.out.println(p.get())

    System.out.println("== the enclosing instances stay distinct ==")
    T135 e = new T135(1)
    T135 f = new T135(2)
    kept = e.new Inner()
    T135.Inner other = f.new Inner()
    System.out.println(kept.get() + " " + other.get() + " " + kept.get())
  }
}
