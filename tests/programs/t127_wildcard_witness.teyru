/* A `? super T` whose T is the enclosing method's type parameter, with an
   explicit witness.

   Inference has to substitute a wildcard's bound before the containment check:
   `Fn<? super T, U>` with T = String has to accept an `Fn<String, Integer>`, and
   left as written the check asks whether String is a subtype of the bare
   variable T, which is false for every argument -- so a named argument was
   refused even with `<String, Integer>` spelled out. A lambda worked all along,
   because a lambda is typed against the target rather than checked against it.
   Expected output is javac 25's. */

package teyru

interface Fn2<T, R> { R apply(T t) }

class Box<T> {
  private String tag
  Box(String tag) { this.tag = tag }
  String tag() { return tag }
}

class T127 {
  static <T, U> Box<T> sup(Fn2<? super T, U> f) { return new Box<T>("sup") }
  static <T, U> Box<T> ext(Fn2<T, ? extends U> f) { return new Box<T>("ext") }
  static <T> String via(Fn2<? super T, Integer> f, T v) { return "" + f.apply(v) }

  public static void main(String[] args) {
    Fn2<String, Integer> named = s -> s.length()
    System.out.println(T127.<String, Integer>sup(named).tag())
    System.out.println(T127.<String, Integer>sup(s -> s.length()).tag())
    System.out.println(T127.<String, Integer>ext(named).tag())
    System.out.println(T127.<String, Integer>ext(s -> s.length()).tag())
    System.out.println(T127.<String>via(named, "abcd"))
    System.out.println(T127.<String>via(s -> s.length() + 1, "abcd"))
  }
}
