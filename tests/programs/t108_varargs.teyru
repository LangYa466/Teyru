// Variable-arity calls, including the two shapes that were mis-compiled.
//
// A `T...` parameter is an array, and the call site has two spellings: the
// elements, or the array itself. The compiler has to tell them apart to know
// whether to pack -- and for a single element the two look identical in the
// argument count (`printf("%s", x)` and `printf("%s", new Object[]{x})` both
// pass one argument to a method with one non-array parameter).
//
// Two bugs came from guessing instead of knowing: the first vararg took the
// array's type instead of the element's (so a primitive was never boxed and
// `String.format("%d", 7)` handed the callee the number 7 where a pointer
// goes), and the virtual-dispatch path had no call node to consult, so it fell
// back to an argument-count heuristic that skipped packing whenever the vararg
// count happened to equal the parameter count.
//
// Expected output is javac 25's.

class Base {
  String take(String tag, Object... xs) {
    int n = 0
    for (Object x : xs) {
      n++
    }
    return tag + "/" + n
  }
}

class Sub extends Base {
}

class Main {
  public static void main(String[] args) {
    Sub v = new Sub()

    // virtual dispatch, with one, two and zero varargs
    System.out.println(v.take("one", "b"))
    System.out.println(v.take("two", "b", "c"))
    System.out.println(v.take("none"))

    // the array spelled out, which is the same call written the other way
    System.out.println(v.take("arr", new Object[]{"b", "c"}))

    // a primitive vararg, which is where the missing box showed
    System.out.printf("%s%n", "x")
    System.out.printf("[%5.2f]%n", 1.23456)
    System.out.printf("%s and %s%n", "a", "b")

    // and a static one, for the path that was already right
    System.out.println(mix("s", 1, 2, 3))
    System.out.println(mix("t"))
  }

  static int mix(String tag, int... xs) {
    int t = tag.length()
    for (int x : xs) {
      t += x
    }
    return t
  }
}
