// Overload resolution runs the JLS phases in order: strict (1), boxing (2),
// then variable arity (3). The strict match wins over the boxed one, and a
// value that cannot convert at all still reaches the varargs method.
class Main {
  static String f(int n) { return "int " + n }
  static String f(Integer n) { return "Integer " + n }
  static String f(int... ns) { return "varargs " + ns.length }

  public static void main(String[] args) {
    System.out.println(f(1))
    Integer boxed = 2
    System.out.println(f(boxed))
    System.out.println(f(3, 4, 5))
  }
}
