/* The java.lang surface the prelude implements, exercised the way a normal
   Java program does. Every line's output was taken from the same program run on
   javac 25, so the expectation file is Java's output and not this compiler's.
   Lines whose *source* differs from the Java original only to spell a name
   (teyru.Object where Java writes java.lang.Object) are marked package-name. */

package teyru

class MyErr extends RuntimeException {
  MyErr(String m, Throwable c) {
    super(m, c)
  }
}

class Point {
  int x
  Point(int x) {
    this.x = x
  }
}

class T94 {
  public static void main(String[] args) {
    Object nil = null
    System.out.println("== String ==")
    String s = "Hello, World"
    System.out.println(s.length())
    System.out.println(s.isEmpty())
    System.out.println("   \t\n".isBlank())
    System.out.println(s.charAt(0))
    System.out.println(s.charAt(11))
    System.out.println(s.substring(7))
    System.out.println(s.substring(0, 5))
    System.out.println(s.indexOf('o'))
    System.out.println(s.indexOf('o', 5))
    System.out.println(s.indexOf("World"))
    System.out.println(s.indexOf("zzz"))
    System.out.println(s.lastIndexOf('o'))
    System.out.println(s.lastIndexOf('o', 5))
    System.out.println(s.lastIndexOf("l"))
    System.out.println(s.startsWith("Hell"))
    System.out.println(s.startsWith("llo", 2))
    System.out.println(s.endsWith("rld"))
    System.out.println(s.contains("o, W"))
    System.out.println(s.contains("nope"))
    System.out.println("ab".concat("cd"))
    System.out.println("ab".repeat(3))
    System.out.println("  x  ".strip() + "|")
    System.out.println("  x  ".stripLeading() + "|")
    System.out.println("  x  ".stripTrailing() + "|")
    System.out.println("  x  ".trim() + "|")
    System.out.println("aBc".toUpperCase() + " " + "aBc".toLowerCase())
    System.out.println("a-b-c".replace('-', '+'))
    System.out.println("a-b-c".replace("b", "XY"))
    System.out.println("abc".equals("abc"))
    System.out.println("abc".equalsIgnoreCase("ABC"))
    System.out.println("abc".compareTo("abd"))
    System.out.println("abc".compareTo("ab"))
    System.out.println("abc".compareToIgnoreCase("ABD"))
    System.out.println("abc".hashCode())
    System.out.println("abc".intern() == "abc")
    System.out.println(String.valueOf(42))
    System.out.println(String.valueOf(42L))
    System.out.println(String.valueOf(true))
    System.out.println(String.valueOf('z'))
    System.out.println(String.valueOf(3.5f))
    System.out.println(String.valueOf(3.5))
    System.out.println(String.valueOf(3.0))
    System.out.println(String.valueOf(nil))
    System.out.println(String.valueOf(new char[] {'a', 'b'}))
    System.out.println(String.valueOf(new char[] {'a', 'b', 'c'}, 1, 2))
    System.out.println(String.copyValueOf(new char[] {'x', 'y'}))
    System.out.println(String.copyValueOf(new char[] {'a', 'b', 'c'}, 1, 2))
    System.out.println(String.join("-", "a", "b", "c"))
    char[] chars = "hello".toCharArray()
    System.out.println(chars.length + " " + chars[1])
    String[] parts = "a,b,,c".split(",")
    System.out.println(parts.length + " " + parts[2].isEmpty())
    String[] lim = "a,b,c,d".split(",", 2)
    System.out.println(lim.length + " " + lim[1])
    System.out.println("n=" + 5 + " f=" + 2.5)
    System.out.println(new StringBuilder().append(true).append('c').append(7).append(2L).append(1.5).append(2.5f).toString())
    System.out.println("== StringBuilder ==")
    StringBuilder sb = new StringBuilder("abc")
    sb.append("de").append(12)
    System.out.println(sb.toString())
    sb.insert(0, "X").insert(0, 9)
    System.out.println(sb.toString())
    System.out.println(sb.charAt(1))
    sb.setCharAt(0, 'Z')
    System.out.println(sb.toString())
    sb.deleteCharAt(1)
    System.out.println(sb.toString())
    sb.delete(1, 3)
    System.out.println(sb.toString())
    sb.replace(0, 2, "Q")
    System.out.println(sb.toString())
    System.out.println(sb.reverse().toString())
    System.out.println(sb.length() + " " + sb.isEmpty())
    System.out.println(sb.indexOf("Q") + " " + sb.lastIndexOf("Q"))
    sb.setLength(2)
    System.out.println(sb.toString())
    sb.append("zzz")
    System.out.println(sb.substring(1) + " " + sb.substring(0, 2))
    System.out.println(sb.capacity() >= sb.length())
    sb.ensureCapacity(100)
    System.out.println(sb.capacity() >= 100)
    System.out.println(new StringBuilder().append(new char[] {'p', 'q'}).toString())
    System.out.println("== StringBuffer ==")
    StringBuffer sf = new StringBuffer("ab")
    sf.append("cd").append(3).insert(0, "!").reverse()
    System.out.println(sf.toString())
    sf.setLength(2)
    System.out.println(sf.toString() + " " + sf.length() + " " + sf.isEmpty())
    System.out.println("== Math ==")
    System.out.println(Math.abs(-7) + " " + Math.abs(-7L) + " " + Math.abs(-1.5f) + " " + Math.abs(-1.5))
    System.out.println(Math.max(3, 9) + " " + Math.min(3, 9))
    System.out.println(Math.max(3L, 9L) + " " + Math.min(3L, 9L))
    System.out.println(Math.max(1.5f, 2.5f) + " " + Math.min(1.5, 2.5))
    System.out.println(Math.sqrt(9.0))
    System.out.println(Math.cbrt(27.0))
    System.out.println(Math.pow(2.0, 10.0))
    System.out.println(Math.exp(0.0))
    System.out.println(Math.log(1.0))
    System.out.println(Math.log10(1000.0))
    System.out.println(Math.sin(0.0))
    System.out.println(Math.cos(0.0))
    System.out.println(Math.tan(0.0))
    System.out.println(Math.atan2(1.0, 1.0))
    System.out.println(Math.hypot(3.0, 4.0))
    System.out.println(Math.toRadians(180.0))
    System.out.println(Math.toDegrees(Math.PI))
    System.out.println(Math.floor(-1.5) + " " + Math.ceil(-1.5))
    System.out.println(Math.rint(2.5) + " " + Math.rint(3.5))
    System.out.println(Math.signum(-3.5) + " " + Math.signum(0.0))
    System.out.println(Math.round(2.5) + " " + Math.round(-2.5) + " " + Math.round(2.5f))
    System.out.println(Math.floorDiv(7, 2) + " " + Math.floorMod(7, 2))
    System.out.println(Math.floorDiv(-7, 2) + " " + Math.floorMod(-7, 2))
    System.out.println(Math.floorDiv(7L, 2L) + " " + Math.floorMod(7L, -2L))
    System.out.println(Math.PI + " " + Math.E)
    System.out.println(Math.random() >= 0.0 && Math.random() < 1.0)
    System.out.println(Math.max(2.0, Double.NaN) + " " + Math.min(2.0, Double.NaN))
    System.out.println("== Character ==")
    System.out.println(Character.isDigit('7') + " " + Character.isDigit('x'))
    System.out.println(Character.isLetter('x') + " " + Character.isLetter('7'))
    System.out.println(Character.isLetterOrDigit('7') + " " + Character.isLetterOrDigit(' '))
    System.out.println(Character.isAlphabetic('q') + " " + Character.isAlphabetic('1'))
    System.out.println(Character.isUpperCase('A') + " " + Character.isUpperCase('a'))
    System.out.println(Character.isLowerCase('a') + " " + Character.isLowerCase('A'))
    System.out.println(Character.isWhitespace(' ') + " " + Character.isWhitespace('a'))
    System.out.println(Character.toUpperCase('a') + " " + Character.toLowerCase('A'))
    System.out.println(Character.getNumericValue('7') + " " + Character.getNumericValue('a'))
    System.out.println(Character.digit('f', 16) + " " + Character.digit('f', 10))
    System.out.println(Character.compare('a', 'b'))
    System.out.println(Character.toString('c'))
    System.out.println(Character.valueOf('c').charValue())
    System.out.println(Character.valueOf('c').hashCode() == Character.hashCode('c'))
    System.out.println("== boxes ==")
    System.out.println(Integer.valueOf(5) + " " + Integer.valueOf("17") + " " + Integer.valueOf("ff", 16))
    System.out.println(Integer.parseInt("42") + " " + Integer.parseInt("-7") + " " + Integer.parseInt("111", 2))
    System.out.println(Long.parseLong("9000000000") + " " + Double.parseDouble("1.25") + " " + Float.parseFloat("0.5"))
    System.out.println(Byte.parseByte("-12") + " " + Short.parseShort("300") + " " + Boolean.parseBoolean("TRUE"))
    System.out.println(Integer.valueOf(7).intValue() + " " + Integer.valueOf(7).longValue() + " " + Integer.valueOf(7).doubleValue())
    System.out.println(Double.valueOf(2.75).intValue() + " " + Integer.valueOf(300).byteValue() + " " + Integer.valueOf(300).shortValue())
    System.out.println(Integer.valueOf(1).equals(Integer.valueOf(1)) + " " + Integer.valueOf(1).equals(Long.valueOf(1)))
    System.out.println(Integer.valueOf(1).compareTo(Integer.valueOf(2)) + " " + Integer.compare(3, 3))
    System.out.println(Integer.MIN_VALUE + " " + Integer.MAX_VALUE)
    System.out.println(Long.MIN_VALUE + " " + Long.MAX_VALUE)
    System.out.println(Byte.MIN_VALUE + " " + Byte.MAX_VALUE + " " + Short.MIN_VALUE + " " + Short.MAX_VALUE)
    System.out.println(Character.MIN_VALUE + 0 + " " + (Character.MAX_VALUE + 0))
    System.out.println(Double.MAX_VALUE + " " + Float.MAX_VALUE)
    System.out.println(Integer.toString(255) + " " + Integer.toString(255, 16))
    System.out.println(Integer.toBinaryString(10) + " " + Integer.toOctalString(10) + " " + Integer.toHexString(255))
    System.out.println(Integer.toHexString(-1) + " " + Integer.toBinaryString(-1))
    System.out.println(Integer.toUnsignedString(-1) + " " + Long.toHexString(-1L))
    System.out.println(Integer.bitCount(7) + " " + Long.bitCount(255L))
    System.out.println(Integer.numberOfLeadingZeros(1) + " " + Integer.numberOfTrailingZeros(8))
    System.out.println(Integer.highestOneBit(100) + " " + Integer.lowestOneBit(100))
    System.out.println(Integer.reverse(1) + " " + Integer.reverseBytes(1))
    System.out.println(Integer.rotateLeft(1, 4) + " " + Integer.rotateRight(16, 4))
    System.out.println(Integer.signum(-3) + " " + Integer.sum(2, 3) + " " + Integer.compareUnsigned(-1, 1))
    System.out.println(Long.toUnsignedString(-1L) + " " + Long.numberOfLeadingZeros(1L) + " " + Long.reverse(1L))
    System.out.println(Double.isNaN(Double.NaN) + " " + Double.isInfinite(Double.POSITIVE_INFINITY) + " " + Double.isFinite(1.0))
    System.out.println(Float.isNaN(Float.NaN) + " " + Float.isInfinite(Float.NEGATIVE_INFINITY))
    System.out.println(Double.doubleToLongBits(1.0) + " " + Double.longBitsToDouble(4607182418800017408L))
    System.out.println(Float.floatToIntBits(1.0f) + " " + Float.intBitsToFloat(1065353216))
    System.out.println(Double.toString(1.0) + " " + Double.toString(0.1) + " " + Float.toString(2.5f))
    System.out.println(Double.compare(1.0, 2.0) + " " + Double.compare(Double.NaN, 1.0) + " " + Double.compare(1.0, 1.0))
    System.out.println(Double.max(1.0, 2.0) + " " + Double.min(1.0, 2.0) + " " + Double.sum(1.5, 2.5))
    System.out.println(Float.MAX_VALUE + " " + Float.MIN_VALUE + " " + Float.NaN)
    System.out.println(Double.POSITIVE_INFINITY + " " + Double.NEGATIVE_INFINITY)
    System.out.println(Integer.hashCode(9) + " " + Long.hashCode(9L) + " " + Double.hashCode(1.0) + " " + Boolean.hashCode(true) + " " + Character.hashCode('c'))
    System.out.println(Boolean.valueOf(true) + " " + Boolean.toString(false) + " " + Boolean.compare(true, false))
    System.out.println(Boolean.logicalAnd(true, false) + " " + Boolean.logicalOr(true, false) + " " + Boolean.logicalXor(true, true))
    System.out.println(Byte.toUnsignedInt((byte) -1) + " " + Short.toUnsignedInt((short) -1) + " " + Byte.toUnsignedLong((byte) -1))
    Number nn = Integer.valueOf(3)
    System.out.println(nn.intValue() + " " + nn.doubleValue())
    System.out.println("== Object ==")
    Object o = new Object()
    System.out.println(o.getClass().getName().endsWith("Object"))
    System.out.println(o.equals(o) + " " + o.equals(new Object()))
    System.out.println(o.toString().startsWith(o.getClass().getName() + "@"))
    System.out.println(o.hashCode() == System.identityHashCode(o))
    Point p = new Point(3)
    System.out.println(p.getClass().getName().endsWith("Point"))
    System.out.println("abc".getClass().getName().endsWith("String"))
    System.out.println(Integer.valueOf(1).getClass().getName().endsWith("Integer"))
    System.out.println("== System ==")
    System.out.println(System.currentTimeMillis() > 1600000000000L)
    System.out.println(System.nanoTime() != 0L)
    System.out.println(System.lineSeparator().length())
    System.out.println(System.getenv("TY_NO_SUCH_VAR_XYZ") == null)
    System.out.println(System.getProperty("no.such.key.xyz") == null)
    int[] src = {1, 2, 3, 4, 5}
    int[] dst = new int[5]
    System.arraycopy(src, 1, dst, 2, 3)
    System.out.println(dst[0] + "" + dst[2] + dst[3] + dst[4])
    String[] sss = new String[2]
    System.arraycopy(new String[] {"a", "b"}, 0, sss, 0, 2)
    System.out.println(sss[0] + sss[1])
    System.out.println("== errors ==")
    RuntimeException e = new RuntimeException("boom")
    System.out.println(e.getMessage())
    System.out.println(e.toString().endsWith("RuntimeException: boom"))
    System.out.println(e.getCause() == null)
    MyErr me = new MyErr("outer", e)
    System.out.println(me.getMessage() + " " + (me.getCause() == e))
    System.out.println(me instanceof RuntimeException)
    try {
      throw new IllegalStateException("state")
    } catch (RuntimeException caught) {
      System.out.println("caught " + caught.getMessage())
    } finally {
      System.out.println("finally")
    }
    try {
      int[] a = new int[2]
      System.out.println(a[5])
    } catch (ArrayIndexOutOfBoundsException caught) {
      System.out.println("aioobe")
    }
    int zero = 0
    try {
      System.out.println(1 / zero)
    } catch (ArithmeticException caught) {
      System.out.println("div: " + caught.getMessage())
    }
    try {
      Object x = "s"
      Integer y = (Integer) x
      System.out.println(y)
    } catch (ClassCastException caught) {
      System.out.println("cce")
    }
    try {
      Integer.parseInt("nope")
    } catch (NumberFormatException caught) {
      System.out.println("nfe: " + caught.getMessage())
    }
  }
}
