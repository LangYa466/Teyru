// A pattern binds a variable whose scope is the rest of the expression, so it
// can appear in a local variable's initializer, not only in a controlling
// expression. The emitted C has to declare it before the statement that reads
// it; it used to name a variable that was never declared.
class Main {
  static boolean nonEmpty(Object o) {
    boolean b = o instanceof String s && s.length() > 0
    return b
  }

  static int lengthOrZero(Object o) {
    int n = o instanceof String s ? s.length() : 0
    return n
  }

  public static void main(String[] args) {
    System.out.println(nonEmpty("hi"))
    System.out.println(nonEmpty(""))
    System.out.println(nonEmpty(Integer.valueOf(3)))
    System.out.println(nonEmpty(null))
    System.out.println(lengthOrZero("abcd"))
    System.out.println(lengthOrZero(Integer.valueOf(1)))
  }
}
