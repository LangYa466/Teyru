// The Lombok features that used to be accepted and ignored.
//
// Each of these was checked against what Lombok documents -- its feature pages,
// and the "vanilla java" expansion they show: a @NonNull field is a required
// constructor argument and a check in the generated setter, @Tolerate makes
// Lombok generate the member it would otherwise step aside for,
// onlyExplicitlyIncluded reads the per-field @Include, @Getter(lazy) computes
// once, @StandardException copies the cause's message, and @Helper lets a
// method-local class be called without an instance written out for it.

import lombok.*
import lombok.experimental.*

@Data
class Person {
  @NonNull String name
  int age
}

class Box {
  @Setter @Getter @NonNull String label
}

class Manual {
  static String checked(@NonNull String x) {
    return x
  }
}

class Overloads {
  @Setter String text

  @Tolerate
  public void setText(int n) {
    text = "n" + n
  }
}

@ToString(onlyExplicitlyIncluded = true)
@EqualsAndHashCode(onlyExplicitlyIncluded = true)
class Tagged {
  @ToString.Include @EqualsAndHashCode.Include String key = "k"
  String other = "o"
}

@Builder(setterPrefix = "with")
@Getter
class Prefixed {
  String name
  int age
}

@Builder(toBuilder = true)
class Doubled {
  int x
  @Builder.ObtainVia(method = "doubled") int y

  int doubled() {
    return y * 2
  }
}

class Factory {
  String label

  @Builder
  static Factory of(String label, int n) {
    Factory f = new Factory()
    f.label = label + n
    return f
  }
}

class Host {
  public int use(int arg1) {
    int localVar = 5

    @Helper
    class Helpers {
      int helperMethod(int arg) {
        return arg + localVar
      }
      int other() {
        return localVar * 2
      }
    }

    return helperMethod(10) + other() + arg1
  }
}

class Counter {
  static int calls = 0

  static int next() {
    calls++
    return calls
  }

  @Getter(lazy = true) private int value = next()
  @Getter(lazy = true) private String label = "v" + next()
}

@StandardException
class Boom extends RuntimeException {
}

class Main {
  public static void main(String[] args) {
    // @Data's constructor takes the @NonNull fields, and both it and the
    // generated setter reject null
    Person p = new Person("ada")
    p.setAge(3)
    System.out.println(p)
    try {
      new Person(null)
    } catch (NullPointerException e) {
      System.out.println("ctor: " + e.getMessage())
    }
    try {
      p.setName(null)
    } catch (NullPointerException e) {
      System.out.println("setter: " + e.getMessage())
    }

    // a field-level @NonNull reaches the generated setter, and a @NonNull
    // parameter reaches the method that declares it
    Box b = new Box()
    b.setLabel("x")
    System.out.println(b.getLabel())
    try {
      b.setLabel(null)
    } catch (NullPointerException e) {
      System.out.println("field: " + e.getMessage())
    }
    try {
      Manual.checked(null)
    } catch (NullPointerException e) {
      System.out.println("param: " + e.getMessage())
    }

    // @Tolerate: the generated setter exists beside the one the program wrote
    Overloads o = new Overloads()
    o.setText("hi")
    System.out.println(o.text)
    o.setText(3)
    System.out.println(o.text)

    // onlyExplicitlyIncluded keeps the fields marked @Include
    System.out.println(new Tagged())

    // a builder's setterPrefix raises the name it prefixes
    Prefixed pref = Prefixed.builder().withName("ada").withAge(3).build()
    System.out.println(pref.getName() + " " + pref.getAge())

    // ObtainVia(method = ...) is how toBuilder reads a value out of the instance
    Doubled d = Doubled.builder().x(1).y(5).build()
    System.out.println(d.x + " " + d.y)
    Doubled copy = d.toBuilder().build()
    System.out.println(copy.x + " " + copy.y)

    // a method-level @Builder, and a @Helper local class
    System.out.println(Factory.builder().label("f").n(2).build().label)
    System.out.println(new Host().use(1))

    // a lazy getter computes once, and works for a primitive field
    Counter c = new Counter()
    System.out.println(c.getValue() + " " + c.getValue() + " calls=" + Counter.calls)
    System.out.println(c.getLabel() + " calls=" + Counter.calls)

    // @StandardException copies the cause's message
    try {
      throw new RuntimeException("boom")
    } catch (RuntimeException e) {
      Boom boom = new Boom(e)
      System.out.println("[" + boom.getMessage() + "] cause=" + (boom.getCause() == e))
    }
  }
}
