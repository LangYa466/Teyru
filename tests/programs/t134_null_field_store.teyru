/* Java tests the receiver of a field *store* for null, the same way it tests
   the receiver of a load. Only the load was tested here, so `b.v = 5` on a null
   `b` was a segmentation fault -- exit 139, no catchable exception, nothing a
   program could defend against -- while `int x = b.v` threw NullPointerException
   as it should. The store goes through the same test now, which also covers the
   compound assignments, the updates, and a null anywhere along the receiver.

   Expected output is javac 25's. */

package teyru

class Box {
  public int v = 0
}

class Holder {
  public Box box = null
}

class T134 {
  static String tryStore(Box b) {
    try {
      b.v = 5
      return "stored " + b.v
    } catch (NullPointerException e) {
      return "NPE on store"
    }
  }

  static String tryLoad(Box b) {
    try {
      return "loaded " + b.v
    } catch (NullPointerException e) {
      return "NPE on load"
    }
  }

  static String tryCompound(Box b) {
    try {
      b.v += 5
      return "compounded " + b.v
    } catch (NullPointerException e) {
      return "NPE on compound assignment"
    }
  }

  static String tryUpdate(Box b) {
    try {
      b.v++
      return "updated " + b.v
    } catch (NullPointerException e) {
      return "NPE on update"
    }
  }

  public static void main(String[] args) {
    System.out.println("== the null cases ==")
    Box nil = null
    System.out.println(tryStore(nil))
    System.out.println(tryLoad(nil))
    System.out.println(tryCompound(nil))
    System.out.println(tryUpdate(nil))

    System.out.println("== a null further along the receiver ==")
    try {
      Holder h = null
      h.box.v = 1
      System.out.println("stored through a null holder")
    } catch (NullPointerException e) {
      System.out.println("NPE on store through a null holder")
    }
    try {
      Holder h = new Holder()
      h.box.v = 1
      System.out.println("stored through a null field")
    } catch (NullPointerException e) {
      System.out.println("NPE on store through a null field")
    }

    System.out.println("== and the same operations on a real object ==")
    Box b = new Box()
    System.out.println(tryStore(b))
    System.out.println(tryLoad(b))
    System.out.println(tryCompound(b))
    System.out.println(tryUpdate(b))
    b.v = 100
    System.out.println("assigned " + b.v)
    b.v += 1
    System.out.println("compounded " + b.v)
    b.v++
    System.out.println("updated " + b.v)
    System.out.println("postfix value " + (b.v++))
    System.out.println("after postfix " + b.v)
  }
}
