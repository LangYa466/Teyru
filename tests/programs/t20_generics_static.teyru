import static java.lang.Math.*

interface Holder {
  int LIMIT = 10
}

class Box<T> {
  private T v
  public Box(T v) {
    this.v = v
  }
  public <R> R map(Mapper<T, R> m) {
    return m.apply(v)
  }
}

interface Mapper<A, B> {
  B apply(A a)
}

class Outer2 {
  static class Nested {
    static String who() {
      return "nested"
    }
  }
}

class Main {
  static <T> T identity(T v) {
    return v
  }
  public static void main(String[] args) {
    System.out.println(Holder.LIMIT)
    System.out.println(max(3, 9))
    System.out.println(Outer2.Nested.who())

    Box<String> b = new Box<>("abc")
    int len = b.<Integer>map(s -> s.length())
    System.out.println(len)

    String s = Main.<String>identity("generic")
    System.out.println(s)
    System.out.println(identity(5))
  }
}
