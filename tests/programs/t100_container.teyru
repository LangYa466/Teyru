// The container: beans, injection by type, @Qualifier, @Primary, @Value,
// @Bean, constructor injection and @PostConstruct.
//
// Spring resolves all of this by reflection while the program starts. The
// compiler resolves it here instead -- it is the only thing that knows which
// classes implement an interface -- so the same wiring is checked before the
// program exists, and a missing bean or a dependency loop is a compile error
// (see TestDiagnostics) rather than a startup failure.

import teyru.*

@Repository
class UserRepo {
  private int saved = 0
  String save(String name) {
    saved++
    return "saved " + name + " #" + saved
  }
}

interface Greeter {
  String greet()
}

@Component
class English implements Greeter {
  public String greet() { return "hello" }
}

@Component
@Primary
class Chinese implements Greeter {
  public String greet() { return "nihao" }
}

@Component
class Loud implements Greeter {
  public String greet() { return "LOUD" }
}

@Service
class GreetingService {
  @Autowired UserRepo repo
  @Autowired Greeter greeter
  @Autowired @Qualifier("loud") Greeter loud
  @Value("${app.name:unnamed}") String appName

  String version
  private boolean started = false

  GreetingService(@Value("${app.version:1.0}") String version) {
    this.version = version
  }

  @PostConstruct
  void start() { started = true }

  String describe() {
    if (!started) { return "not started" }
    return appName + "@" + version + " " + greeter.greet() + " " + loud.greet()
  }

  String save(String n) { return repo.save(n) }
}

@Configuration
class Factory {
  @Bean int answer() { return 42 }
  @Bean("label") String label() { return "from @Bean" }
}

class Main {
  public static void main(String[] args) {
    ApplicationContext ctx = new ApplicationContext()
    ctx.setProperty("app.name", "demo")
    ctx.setProperty("app.version", "2.5")
    ctx.refresh()

    GreetingService s = (GreetingService) ctx.getBean(GreetingService.class)
    System.out.println(s.describe())
    System.out.println(s.save("ann"))
    System.out.println(s.save("bob"))

    // a second lookup answers with the same instance: a bean is a singleton
    GreetingService again = (GreetingService) ctx.getBean(GreetingService.class)
    System.out.println(s == again)

    // by name, by interface, and by a @Bean method's type
    System.out.println(ctx.getBean("userRepo").toString().isEmpty() == false)
    System.out.println(((Greeter) ctx.getBean(Greeter.class)).greet())
    System.out.println(ctx.getBean(Integer.class).toString())
    System.out.println(ctx.getBean(String.class).toString())
    System.out.println(ctx.beanCount())
    System.out.println(ctx.containsBean("nope"))
  }
}
