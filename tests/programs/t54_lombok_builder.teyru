import lombok.Builder
import lombok.SuperBuilder
import lombok.Singular
import lombok.Getter
import lombok.ToString

@SuperBuilder
@Getter
@ToString
class Animal {
  private String name
  private int legs
}

@SuperBuilder
@Getter
@ToString
class Dog extends Animal {
  private String breed
}

// @Builder.ObtainVia is read by toBuilder, which is where Lombok reads it:
// build() takes what the builder was given, and toBuilder copies an instance.
@Builder(toBuilder = true)
@Getter
class Order {
  private String id
  @Singular private List<String> items
  @Singular private Map<String, Integer> counts
  @Singular("tag") private List<String> tags
  @Builder.ObtainVia(field = "id") private String label
  private int total
}

class Main {
  public static void main(String[] args) {
    // @SuperBuilder: the subclass builder covers the inherited fields
    Dog d = Dog.builder().name("rex").legs(4).breed("lab").build()
    System.out.println(d)

    Animal a = Animal.builder().name("generic").legs(2).build()
    System.out.println(a)

    // @Singular: one at a time, a whole collection, or cleared
    Order o = Order.builder()
      .id("A1")
      .addItems("apple")
      .addItems("pear")
      .counts("apple", 2)
      .tag("urgent")
      .total(3)
      .build()
    System.out.println(o.getItems())
    System.out.println(o.getCounts().size())
    System.out.println(o.getTags())
    System.out.println(o.getId() + " " + o.getLabel() + " " + o.getTotal())

    // toBuilder copies an instance, and takes label from id because that is
    // what @Builder.ObtainVia(field = "id") says
    Order copy = o.toBuilder().build()
    System.out.println(copy.getId() + " " + copy.getLabel() + " " + copy.getTotal())

    // an untouched builder still builds a collection, never null
    Order empty = Order.builder().build()
    System.out.println(empty.getItems().size() + " " + empty.getCounts().size() + " " + empty.getTags().size())

    // the all-of form and the clear
    List<String> more = new ArrayList<String>()
    more.add("x")
    more.add("y")
    Order.OrderBuilder b = Order.builder().addItemsAll(more)
    System.out.println(b.build().getItems())
    System.out.println(b.clearItems().build().getItems().size())

    // the built list is a copy: changing it later does not touch the object
    List<String> nine = new ArrayList<String>()
    nine.add("z")
    Order o2 = Order.builder().addItemsAll(nine).build()
    nine.add("extra")
    System.out.println(o2.getItems().size() + " " + nine.size())
  }
}
