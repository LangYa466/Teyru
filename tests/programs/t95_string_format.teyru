/* String.format and System.out.printf, conversion by conversion. Every line of
   output was taken from this same program run on javac 25, so the expectation
   file is Java's output and not this compiler's.

   `Point` is a top-level class here where Java nests it. */

package teyru

class Point {
  int x
  Point(int x) { this.x = x }
  public String toString() { return "P(" + x + ")" }
}

class T95 {
  static void p(String s) { System.out.println("[" + s + "]") }
  public static void main(String[] args) {
    Object nil = null
    Point pt = new Point(7)
    System.out.println("== %s ==")
    p(String.format("%s", "abc"))
    p(String.format("%s", 42))
    p(String.format("%s", 1.5))
    p(String.format("%s", true))
    p(String.format("%s", pt))
    p(String.format("%s", nil))
    p(String.format("%S", "abc"))
    p(String.format("%S", nil))
    p(String.format("[%10s]", "abc"))
    p(String.format("[%-10s]", "abc"))
    p(String.format("[%.2s]", "abcdef"))
    p(String.format("[%10.2s]", "abcdef"))
    p(String.format("[%-10.2s]", "abcdef"))
    p(String.format("[%.2s]", nil))
    p(String.format("[%5s]", ""))
    p(String.format("[%s|%s]", "a", "b"))
    System.out.println("== %b %h ==")
    p(String.format("%b", true))
    p(String.format("%b", false))
    p(String.format("%b", nil))
    p(String.format("%b", "abc"))
    p(String.format("%b", pt))
    p(String.format("%B", "abc"))
    p(String.format("[%8b]", true))
    p(String.format("[%-8b]", true))
    p(String.format("%h", "abc"))
    p(String.format("%h", 12345))
    p(String.format("%h", nil))
    p(String.format("%H", "abc"))
    p(String.format("[%8h]", "abc"))
    System.out.println("== %c ==")
    p(String.format("%c", 'A'))
    p(String.format("%c", 'z'))
    p(String.format("%c", 97))
    p(String.format("%c", (byte) 66))
    p(String.format("%c", (short) 67))
    p(String.format("%C", 'a'))
    p(String.format("[%5c]", 'x'))
    p(String.format("[%-5c]", 'x'))
    p(String.format("%c", nil))
    p(String.format("%c%c%c", 'a', 'b', 'c'))
    System.out.println("== %d ==")
    p(String.format("%d", 0))
    p(String.format("%d", 42))
    p(String.format("%d", -42))
    p(String.format("%d", 9000000000L))
    p(String.format("%d", -9000000000L))
    p(String.format("%d", (byte) -7))
    p(String.format("%d", (short) 1234))
    p(String.format("%d", Integer.MIN_VALUE))
    p(String.format("%d", Long.MIN_VALUE))
    p(String.format("%d", Long.MAX_VALUE))
    p(String.format("[%8d]", 42))
    p(String.format("[%-8d]", 42))
    p(String.format("[%08d]", 42))
    p(String.format("[%08d]", -42))
    p(String.format("[%+d]", 42))
    p(String.format("[%+d]", -42))
    p(String.format("[% d]", 42))
    p(String.format("[% d]", -42))
    p(String.format("[%(d]", 42))
    p(String.format("[%(d]", -42))
    p(String.format("[%(10d]", -42))
    p(String.format("[%(010d]", -42))
    p(String.format("%d", nil))
    p(String.format("[%08d]", nil))
    p(String.format("[%+d]", nil))
    p(String.format("%,d", 1234567))
    p(String.format("%,d", -1234567))
    p(String.format("%,d", 1234567890123L))
    p(String.format("%,d", 100))
    p(String.format("%,d", 1000))
    p(String.format("[%,15d]", 1234567))
    p(String.format("[%,015d]", 1234567))
    System.out.println("== %o %x %X ==")
    p(String.format("%o", 8))
    p(String.format("%o", 255))
    p(String.format("%x", 255))
    p(String.format("%X", 255))
    p(String.format("%x", 0))
    p(String.format("%x", -1))
    p(String.format("%x", -1L))
    p(String.format("%o", -1))
    p(String.format("%#o", 8))
    p(String.format("%#o", 0))
    p(String.format("%#x", 255))
    p(String.format("%#X", 255))
    p(String.format("[%8x]", 255))
    p(String.format("[%-8x]", 255))
    p(String.format("[%08x]", 255))
    p(String.format("[%#08x]", 255))
    p(String.format("[%#010x]", 255))
    p(String.format("%x", nil))
    p(String.format("%X", nil))
    p(String.format("%x", 4294967296L))
    p(String.format("%o", 4294967296L))
    System.out.println("== %e %E ==")
    p(String.format("%e", 0.0))
    p(String.format("%e", 1.5))
    p(String.format("%e", -1.5))
    p(String.format("%e", 1234567.0))
    p(String.format("%e", 0.00012345))
    p(String.format("%.2e", 1234.5678))
    p(String.format("%.0e", 1234.5678))
    p(String.format("%E", 1.5))
    p(String.format("[%15e]", 1.5))
    p(String.format("[%-15e]", 1.5))
    p(String.format("[%015e]", 1.5))
    p(String.format("[%+e]", 1.5))
    p(String.format("[%(e]", -1.5))
    p(String.format("%e", 1.5f))
    p(String.format("%e", 123456789.0))
    p(String.format("%e", nil))
    System.out.println("== %f ==")
    p(String.format("%f", 0.0))
    p(String.format("%f", 1.5))
    p(String.format("%f", -1.5))
    p(String.format("%f", 1234567.891))
    p(String.format("%f", 0.000001))
    p(String.format("%f", 2.5))
    p(String.format("%.2f", 2.345))
    p(String.format("%.2f", 2.355))
    p(String.format("%.0f", 2.5))
    p(String.format("%.0f", 3.5))
    p(String.format("%.0f", -2.5))
    p(String.format("%.10f", 1.0 / 3.0))
    p(String.format("%f", 1.5f))
    p(String.format("[%12.3f]", 3.14159))
    p(String.format("[%-12.3f]", 3.14159))
    p(String.format("[%012.3f]", 3.14159))
    p(String.format("[%012.3f]", -3.14159))
    p(String.format("[%+012.3f]", 3.14159))
    p(String.format("[%(012.3f]", -3.14159))
    p(String.format("%,.2f", 1234567.891))
    p(String.format("%#.0f", 3.0))
    p(String.format("%f", nil))
    p(String.format("%f", Double.NaN))
    p(String.format("%f", Double.POSITIVE_INFINITY))
    p(String.format("%f", Double.NEGATIVE_INFINITY))
    p(String.format("[%08f]", Double.NaN))
    p(String.format("[%(f]", Double.NEGATIVE_INFINITY))
    p(String.format("[%+f]", Double.POSITIVE_INFINITY))
    System.out.println("== %g %G ==")
    p(String.format("%g", 0.0))
    p(String.format("%g", 1.0))
    p(String.format("%g", 1.5))
    p(String.format("%g", 1234567.0))
    p(String.format("%g", 0.00012345))
    p(String.format("%g", 100000.0))
    p(String.format("%g", 123456789.0))
    p(String.format("%.2g", 1234.5678))
    p(String.format("%.0g", 1234.5678))
    p(String.format("%G", 0.00012345))
    p(String.format("[%12g]", 1.5))
    p(String.format("[%-12g]", 1.5))
    p(String.format("[%012g]", 1.5))
    p(String.format("[%+g]", 1.5))
    p(String.format("[%(g]", -1.5))
    p(String.format("%g", nil))
    System.out.println("== %a ==")
    p(String.format("%a", 0.0))
    p(String.format("%a", 1.0))
    p(String.format("%a", 3.0))
    p(String.format("%a", -3.0))
    p(String.format("%a", 0.5))
    p(String.format("%A", 1.0))
    p(String.format("[%15a]", 1.0))
    p(String.format("%f %e %g %a", 1.0, 1.0, 1.0, 1.0))
    p(String.format("%a", nil))
    System.out.println("== literals ==")
    p(String.format("no specifiers at all"))
    p(String.format("100%% sure"))
    p(String.format("a%sb%dc", "x", 2))
    System.out.print("line one")
    System.out.printf("%nline two%n")
    System.out.printf("%s-%d%n", "tag", 3)
    System.out.printf("[%5.2f]%n", 1.23456)
    System.out.printf("%s%n", nil)
    System.out.println("== errors ==")
    try { String.format("%d", "x") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%c", 1L) } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%f", 1) } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%d", 'a') } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%x", 1.0) } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%d") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%s %d", "a") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%q", "x") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%,x", 1) } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%+s", "x") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%05s", "x") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%#s", "x") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%.3d", 1) } catch (Exception e) { p(e.getMessage()) }
    p(String.format("%h", 1.5))
    p(String.format("%h", 1234567890123L))
    p(String.format("%h", true))
    System.out.println("== argument index ==")
    p(String.format("%3$s %1$s", "a", "b", "c"))
    p(String.format("%1$.2f", 1.005))
    p(String.format("%2$d %% %1$x", 255, 8))
    p(String.format("%s %1$s", "a"))
    p(String.format("[%2$8.3f]", 1234.5678, 1.5))
    System.out.println("== errors, continued ==")
    try { String.format("%-s", "x") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%-d", 1) } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%5n") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%-n") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%0%") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%.3n") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%-05d", 1) } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%  s", "x") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%--s", "x") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%(x", 1) } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%.2c", 65) } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%,%") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%2$d", 9) } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%(s", "x") } catch (Exception e) { p(e.getMessage()) }
    try { String.format("%8$s", "x") } catch (Exception e) { p(e.getMessage()) }
  }
}
