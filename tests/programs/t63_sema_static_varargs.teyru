class Main {
  static int sum(int... xs) {
    int total = 0
    for (int x : xs) {
      total += x
    }
    return total
  }

  static String join(String sep, String... parts) {
    String out = ""
    for (int i = 0 : i < parts.length : i++) {
      if (i > 0) {
        out += sep
      }
      out += parts[i]
    }
    return out
  }

  public static void main(String[] args) {
    int[] values = {10, 20, 30}
    String[] words = {"a", "b"}
    // a type-name receiver must pass the array itself, like an unqualified call does
    System.out.println(Main.sum(values))
    System.out.println(sum(values))
    System.out.println(Main.sum(1, 2, 3))
    System.out.println(Main.sum())
    System.out.println(Main.join("-", words))
    System.out.println(Main.join("-", "x", "y"))
  }
}
