import static Tool.sum

interface Fold {
  default int fold(int... xs) {
    int counted = 0
    for (int x : xs) {
      counted += x
    }
    return counted
  }
}

class Tool {
  static int sum(int... xs) {
    int total = 0
    for (int x : xs) {
      total += x
    }
    return total
  }
}

class Main implements Fold {
  public static void main(String[] args) {
    int[] values = {4, 5, 6}
    System.out.println(sum(values))
    System.out.println(Tool.sum(values))
    System.out.println(new Main().viaInner(values))
    System.out.println(new Main().foldDirect(values))
  }

  static int total(int... xs) {
    int sum = 0
    for (int x : xs) {
      sum += x
    }
    return sum
  }

  int viaInner(int[] values) {
    return new Inner().call(values)
  }

  int foldDirect(int[] values) {
    return Fold.super.fold(values)
  }

  class Inner {
    int call(int[] values) {
      return total(values)
    }
  }
}
