/* `outer.new Inner()` names a member type of the qualifier's class, not a name
   in the lexical scope, so the checker rewrites it to the class's full name
   before resolving it. The full name carries the package -- `pkg.Outer.Inner`
   -- and the lookup could not read that shape: it tried each dotted segment
   against the class table on its own, so `pkg.Outer` was never tried and the
   instantiation failed with `cannot find type pkg.Outer.Inner`. The same
   program without a package declaration compiled, because then the full name
   is just `Outer.Inner` and its head resolves.

   So this file must keep its package declaration: that is what the test is.

   Expected output is javac 25's. */

package teyru

class Outer {
  int v
  Outer(int v) {
    this.v = v
  }
  class Inner {
    int get() {
      return v
    }
  }
  static class Plain {
    int get() {
      return 7
    }
  }
}

class T136 {
  static Outer.Inner fromOutside(Outer o) {
    return o.new Inner()
  }

  public static void main(String[] args) {
    Outer o = new Outer(3)
    Outer.Inner a = o.new Inner()
    System.out.println(a.get())
    System.out.println(fromOutside(o).get())
    Outer.Inner b = o.new Inner()
    System.out.println(b.get())
    Outer.Plain p = new Outer.Plain()
    System.out.println(p.get())
  }
}
