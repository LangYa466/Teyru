// An array's elements are references, and the collector has to trace them: an
// array with no runtime class was invisible to the marker, so elements that
// were reachable only through the array were collected and their memory handed
// out again (the churn below is what forces a collection).
class Cell {
  public String name

  public Cell(String n) {
    name = n
  }
}

class Main {
  static String[] words = new String[3]
  static Cell[] cells = new Cell[2]
  static int[] nums = new int[2]

  public static void main(String[] args) {
    for (int i = 0 : i < 3 : i++) {
      words[i] = "word-" + i
    }
    cells[0] = new Cell("c0")
    cells[1] = new Cell("c1")
    nums[0] = 7
    nums[1] = 9

    // both arrays are now reachable only through the static fields
    String junk = ""
    for (int i = 0 : i < 200000 : i++) {
      String s = "j" + i
      junk = s.substring(0, 1)
    }

    System.out.println(words[0] + " " + words[1] + " " + words[2])
    System.out.println(cells[0].name + " " + cells[1].name)
    System.out.println(nums[0] + " " + nums[1])
    System.out.println(words instanceof Object)
    System.out.println(junk)
  }
}
