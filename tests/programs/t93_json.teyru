import com.google.gson.*

// Documents the tree API from lib/10_json.teyru by walking, building, printing
// and round-tripping JSON.
//
// Every line below was produced by running the same program against the real
// com.google.gson 2.10.0 jar, so the expectations are Gson's output and not
// this library's. The cases where the two deliberately differ -- the strict
// parser, the numeric edge cases -- are in t93_json_strict instead, each marked
// with what Gson answers.
class Main {
  public static void main(String[] args) {
    String doc = """
      {
        "name": "Teyru",
        "stars": 3,
        "pi": 3.14,
        "ratio": 1.5e+10,
        "tiny": -2.5E-3,
        "zero": 0,
        "big": 10000000000000000000,
        "ok": true,
        "off": false,
        "none": null,
        "empty": {},
        "list": [],
        "tags": ["a", "b"],
        "nested": {"deep": [{"n": 1}, {"n": 2}]},
        "unicode": "café 中文 😀",
        "esc": "q\\"b\\\\s\\/t\\b\\f\\n\\r\\t\\u0000\\u001f",
        "html": "<a href='x'>&</a>",
        "u2028": "a\\u2028b"
      }"""

    JsonObject root = JsonParser.parseString(doc).getAsJsonObject()

    System.out.println("== walk ==")
    System.out.println("size | " + root.size())
    System.out.println("name | " + root.get("name").getAsString())
    System.out.println("stars | " + root.get("stars").getAsInt())
    System.out.println("ok | " + root.get("ok").getAsBoolean())
    System.out.println("has none | " + root.has("none"))
    System.out.println("has missing | " + root.has("missing"))
    System.out.println("keys | " + root.keySet())
    System.out.println("entries | " + root.entrySet())
    System.out.println("tags | " + root.getAsJsonArray("tags"))
    System.out.println("tag2 | " + root.getAsJsonArray("tags").get(1).getAsString())
    System.out.println("deep | " + root.getAsJsonObject("nested").getAsJsonArray("deep").get(1).getAsJsonObject().get("n").getAsInt())
    System.out.println("empty size | " + root.getAsJsonObject("empty").size())
    System.out.println("list size | " + root.getAsJsonArray("list").size())
    System.out.println("isJsonObject | " + root.isJsonObject() + " " + root.get("stars").isJsonObject())
    System.out.println("isJsonPrimitive | " + root.get("stars").isJsonPrimitive() + " " + root.isJsonPrimitive())
    System.out.println("isJsonArray | " + root.get("tags").isJsonArray())
    System.out.println("isJsonNull | " + root.get("none").isJsonNull() + " " + root.get("zero").isJsonNull())

    // JsonArray is Iterable, so the enhanced for walks it the way it walks a
    // Java List
    StringBuilder joined = new StringBuilder()
    for (JsonElement tag : root.getAsJsonArray("tags")) {
      joined.append(tag.getAsString())
      joined.append("+")
    }
    System.out.println("iterated | " + joined)

    // the entrySet walk, with getKey/getValue standing in for Map.Entry
    for (JsonMember member : root.entrySet()) {
      if (member.getKey().equals("stars")) {
        System.out.println("entry | " + member.getKey() + " -> " + member.getValue().getAsInt())
      }
    }

    System.out.println("== escapes ==")
    System.out.println("esc | " + root.get("esc").toString())
    // 14 characters: q " b \ s / t and the eight escapes after them. The count
    // is the same in both languages because every one of them decodes to ASCII
    System.out.println("esc length | " + root.get("esc").getAsString().length())
    System.out.println("unicode | " + root.get("unicode").toString())
    System.out.println("html | " + root.get("html").toString())
    System.out.println("u2028 | " + root.get("u2028").toString())
    System.out.println("escaped key | " + JsonParser.parseString("{\"a\\\"b\":1}").toString())
    System.out.println("escaped solidus | " + JsonParser.parseString("\"a\\/b\"").toString())

    // every character the writer has a short form for, and every other control
    // character, which becomes \u00xx
    StringBuilder control = new StringBuilder()
    for (int c = 0 : c <= 31 : c++) {
      control.append((char) c)
    }
    System.out.println("control | " + new JsonPrimitive(control.toString()).toString())
    System.out.println("del | " + new JsonPrimitive("").toString())

    System.out.println("== numbers ==")
    // the shapes JSON writes numbers in, kept as written and converted on
    // demand
    String[] shapes = {"1", "0", "-2.5E-3", "1e5", "100000.0", "1E2", "0.1", "3.141592653589793"}
    for (String shape : shapes) {
      JsonPrimitive n = JsonParser.parseString(shape).getAsJsonPrimitive()
      System.out.println("num " + shape + " | keep=" + n + " str=" + n.getAsString() + " int=" + n.getAsInt() + " long=" + n.getAsLong() + " dbl=" + n.getAsDouble() + " num=" + n.getAsNumber())
    }
    // these three only survive as text, or convert differently from Gson; see
    // t93_json_strict for what Gson answers
    System.out.println("big | " + root.get("big") + " str=" + root.get("big").getAsString() + " dbl=" + root.get("big").getAsDouble())
    System.out.println("ratio | " + root.get("ratio") + " long=" + root.get("ratio").getAsLong())
    System.out.println("constructed | " + new JsonPrimitive(5) + " " + new JsonPrimitive(1.0) + " " + new JsonPrimitive(7L) + " " + new JsonPrimitive(true) + " " + new JsonPrimitive('x'))

    // a string primitive is coerced, and refuses what Java refuses
    System.out.println("coerce | " + new JsonPrimitive("12").getAsInt() + " " + new JsonPrimitive("-12").getAsLong() + " " + new JsonPrimitive("12").getAsDouble() + " " + new JsonPrimitive("TRUE").getAsBoolean() + " " + new JsonPrimitive("true").getAsBoolean() + " " + new JsonPrimitive("yes").getAsBoolean())
    try {
      System.out.println("coerce bad | " + new JsonPrimitive("12.5").getAsInt())
    } catch (IllegalArgumentException ex) {
      System.out.println("coerce bad | " + ex.getMessage())
    }
    try {
      System.out.println("coerce blank | " + new JsonPrimitive(" 13 ").getAsInt())
    } catch (IllegalArgumentException ex) {
      System.out.println("coerce blank | " + ex.getMessage())
    }

    System.out.println("== pretty ==")
    Gson pretty = new GsonBuilder().setPrettyPrinting().create()
    System.out.println(pretty.toJson(root))
    System.out.println("pretty empty | " + pretty.toJson(new JsonObject()))
    System.out.println("pretty empty array | " + pretty.toJson(new JsonArray()))
    System.out.println("pretty mixed | " + pretty.toJson(JsonParser.parseString("[1,[2,{}],[]]")))
    System.out.println("pretty flat | " + pretty.toJson(JsonParser.parseString("{\"a\":1}")))

    System.out.println("== gson defaults ==")
    Gson gson = new Gson()
    System.out.println("default | " + gson.toJson(root))
    System.out.println("html escaped | " + gson.toJson(JsonParser.parseString("{\"a\":\"<&>'\\\"\"}")))
    System.out.println("html kept | " + new GsonBuilder().disableHtmlEscaping().create().toJson(JsonParser.parseString("{\"a\":\"<&>'\\\"\"}")))
    System.out.println("nulls kept | " + new GsonBuilder().serializeNulls().create().toJson(JsonParser.parseString("{\"a\":1,\"b\":null}")))
    System.out.println("nulls dropped | " + gson.toJson(JsonParser.parseString("{\"a\":1,\"b\":null}")))
    System.out.println("toString keeps nulls | " + JsonParser.parseString("{\"a\":1,\"b\":null}").toString())
    System.out.println("fromJson | " + gson.fromJson("{\"a\":[1,2]}").getAsJsonObject().getAsJsonArray("a").size())
    System.out.println("fromJson empty | " + gson.fromJson(""))
    System.out.println("fromJson null | " + gson.fromJson("null"))

    System.out.println("== build ==")
    JsonObject built = new JsonObject()
    built.addProperty("s", "x")
    built.addProperty("i", 7)
    built.addProperty("bool", true)
    built.addProperty("d", 1.5)
    built.addProperty("ch", 'z')
    built.addProperty("nothing", (String) null)
    built.add("arr", JsonParser.parseString("[1,2]"))
    System.out.println("built | " + built)
    System.out.println("built size | " + built.size())
    System.out.println("built isEmpty | " + built.isEmpty() + " " + new JsonObject().isEmpty())
    System.out.println("built prim | " + built.getAsJsonPrimitive("i").getAsInt())
    System.out.println("built arr | " + built.getAsJsonArray("arr").size())
    try {
      // getAsJsonObject(String) is a cast, so asking for the wrong one is a
      // ClassCastException rather than an IllegalStateException
      System.out.println("built obj | " + built.getAsJsonObject("arr"))
    } catch (ClassCastException ex) {
      // Gson's message names com.google.gson.JsonArray, a name this package
      // cannot print; only the class of the exception is compared
      System.out.println("built obj | ClassCastException")
    }
    System.out.println("built remove | " + built.remove("nothing") + " -> " + built)

    // LinkedTreeMap order: insertion order, replacement keeps the position,
    // remove-and-re-add moves the member to the end
    JsonObject order = new JsonObject()
    order.addProperty("b", 1)
    order.addProperty("a", 2)
    order.addProperty("c", 3)
    System.out.println("order | " + order)
    order.addProperty("b", 9)
    System.out.println("replaced | " + order)
    order.remove("a")
    System.out.println("removed | " + order)
    order.addProperty("a", 4)
    System.out.println("re-added | " + order)

    JsonArray arr = new JsonArray()
    arr.add(true)
    arr.add('c')
    arr.add(1)
    arr.add(2.5)
    arr.add("s")
    arr.add(JsonNull.INSTANCE)
    System.out.println("array | " + arr)
    System.out.println("array size | " + arr.size() + " isEmpty=" + arr.isEmpty())
    System.out.println("array get | " + arr.get(2))
    System.out.println("array set | " + arr.set(0, new JsonPrimitive("first")) + " -> " + arr)
    System.out.println("array contains | " + arr.contains(new JsonPrimitive("s")) + " " + arr.contains(new JsonPrimitive("no")))
    System.out.println("array remove | " + arr.remove(0) + " -> " + arr)
    System.out.println("array set null | " + arr.set(0, null) + " -> " + arr)
    System.out.println("array of one | " + JsonParser.parseString("[5]").getAsJsonArray().getAsInt())
    JsonArray many = new JsonArray()
    many.addAll(JsonParser.parseString("[1,2]").getAsJsonArray())
    System.out.println("array addAll | " + many)

    System.out.println("== null ==")
    System.out.println("INSTANCE | " + JsonNull.INSTANCE)
    System.out.println("parsed null is INSTANCE | " + (JsonNull.INSTANCE == JsonParser.parseString("null")))
    System.out.println("null isJsonPrimitive | " + JsonNull.INSTANCE.isJsonPrimitive())
    System.out.println("null isJsonNull | " + JsonNull.INSTANCE.isJsonNull())
    System.out.println("null equals | " + JsonNull.INSTANCE.equals(new JsonNull()) + " " + JsonNull.INSTANCE.equals(JsonParser.parseString("null")))
    System.out.println("null copy | " + JsonNull.INSTANCE.deepCopy())
    try {
      System.out.println("null built | " + new JsonPrimitive((String) null))
    } catch (NullPointerException ex) {
      System.out.println("null built | NullPointerException")
    }
    try {
      System.out.println("null getAsString | " + JsonNull.INSTANCE.getAsString())
    } catch (UnsupportedOperationException ex) {
      // Gson's message names com.google.gson.JsonNull, a name this package
      // cannot print; only the class of the exception is compared
      System.out.println("null getAsString | UnsupportedOperationException")
    }
    try {
      System.out.println("null getAsInt | " + JsonNull.INSTANCE.getAsInt())
    } catch (UnsupportedOperationException ex) {
      System.out.println("null getAsInt | UnsupportedOperationException")
    }
    try {
      System.out.println("object as string | " + root.getAsString())
    } catch (UnsupportedOperationException ex) {
      System.out.println("object as string | UnsupportedOperationException")
    }
    try {
      System.out.println("not an object | " + root.get("stars").getAsJsonObject())
    } catch (IllegalStateException ex) {
      System.out.println("not an object | " + ex.getMessage())
    }
    try {
      System.out.println("two elements | " + JsonParser.parseString("[1,2]").getAsJsonArray().getAsInt())
    } catch (IllegalStateException ex) {
      System.out.println("two elements | " + ex.getMessage())
    }

    System.out.println("== equality and round trip ==")
    JsonObject copy = (JsonObject) root.deepCopy()
    System.out.println("copy equals | " + copy.equals(root) + " same object=" + (copy == root))
    System.out.println("copy hash | " + (copy.hashCode() == root.hashCode()))
    System.out.println("array equals | " + JsonParser.parseString("[1,2]").equals(JsonParser.parseString("[1,2]")))
    System.out.println("array ne | " + JsonParser.parseString("[1,2]").equals(JsonParser.parseString("[2,1]")))
    System.out.println("order insensitive | " + JsonParser.parseString("{\"a\":1,\"b\":2}").equals(JsonParser.parseString("{\"b\":2,\"a\":1}")))
    System.out.println("order insensitive hash | " + (JsonParser.parseString("{\"a\":1,\"b\":2}").hashCode() == JsonParser.parseString("{\"b\":2,\"a\":1}").hashCode()))
    System.out.println("primitive equals | " + new JsonPrimitive(1).equals(new JsonPrimitive(1.0)) + " " + new JsonPrimitive(1).equals(new JsonPrimitive("1")))
    System.out.println("nested equals | " + JsonParser.parseString("{\"a\":[1,{\"b\":null}]}").equals(JsonParser.parseString("{\"a\":[1,{\"b\":null}]}")))

    String once = root.toString()
    String twice = JsonParser.parseString(once).toString()
    System.out.println("stable | " + once.equals(twice))
    String[] roundTrip = {"{}", "[]", "[1,[2,[3]]]", "{\"a\":{\"b\":{\"c\":[null,true]}}}", "\"\"", "[[[[[]]]]]", "{\"a\":1,\"a\":2}", "1e5", "-0"}
    for (String text : roundTrip) {
      System.out.println("round trip " + text + " | " + JsonParser.parseString(text).toString())
    }
    System.out.println("round trip doc | " + JsonParser.parseString(once).getAsJsonObject().getAsJsonObject("nested").getAsJsonArray("deep").get(0).getAsJsonObject().get("n").getAsInt())
  }
}
