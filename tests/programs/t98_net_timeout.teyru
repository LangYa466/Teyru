// The part of the layer that has to be told apart, and the reason it exists.
//
// A read that waits forever cannot be distinguished from a peer that is merely
// slow, and a server that hangs cannot be tested, so setSoTimeout gives every
// wait a deadline. What matters here is what a deadline looks like when it
// expires: a socket timeout raises SocketTimeoutException, while a peer that
// has closed raises nothing and returns the end of the stream. Folding the two
// together -- returning 0 for a timeout, say -- turns a slow client into a
// closed connection, and every request that is still arriving is answered as
// though it were complete.

class Main {
  public static void main(String[] args) {
    ServerSocket server = new ServerSocket(0)
    server.setSoTimeout(2000)
    int port = server.getLocalPort()
    Socket client = new Socket("127.0.0.1", port)
    client.setSoTimeout(150)
    Socket conn = server.accept()
    conn.setSoTimeout(150)
    SocketInputStream in = client.getInputStream()

    // Nothing has been sent and nothing is coming: this is the timeout.
    try {
      in.read()
      System.out.println("timeout: NOT RAISED")
    } catch (SocketTimeoutException e) {
      System.out.println("timeout: " + (e.getMessage().contains("read")))
    }

    // A deadline covers one read, not the whole exchange, so the socket is
    // still usable afterwards -- and the byte that arrives now is read normally.
    conn.getOutputStream().write("x")
    System.out.println("after timeout: " + (in.read() == 120))

    // The server shuts down its writing side: the client reads the end of the
    // stream, which is not an exception and not a timeout. The connection stays
    // open in the other direction, which is what makes this the half close a
    // request-response protocol needs.
    conn.shutdownOutput()
    System.out.println("half close is eof: " + (in.read() == -1))
    client.getOutputStream().write("answer\n")
    System.out.println("still readable: " + conn.getInputStream().readLine())

    // The same distinction on a second connection, in the order that proves it:
    // close first, and the read that follows answers -1 without waiting for the
    // deadline to expire.
    Socket c2 = new Socket("127.0.0.1", port)
    c2.setSoTimeout(2000)
    Socket s2 = server.accept()
    s2.close()
    long before = System.currentTimeMillis()
    System.out.println("closed peer is eof: " + (c2.getInputStream().read() == -1))
    System.out.println("closed peer did not wait: " + (System.currentTimeMillis() - before < 1000))

    // readLine says the same thing a different way: null, not "" and not an
    // exception, so that a serving loop can be a while loop.
    System.out.println("readLine at eof: " + (c2.getInputStream().readLine() == null))

    // An accept with nothing pending times out rather than blocking forever,
    // which is the only reason a single-threaded program can ever stop serving.
    ServerSocket quiet = new ServerSocket(0)
    quiet.setSoTimeout(150)
    try {
      quiet.accept()
      System.out.println("accept timeout: NOT RAISED")
    } catch (SocketTimeoutException e) {
      System.out.println("accept timeout: " + (e.getMessage().contains("accept")))
    }
    quiet.close()

    // A connect to a port that was just released: the kernel refuses it, and a
    // refusal is a failure and not an end of stream. The listener is closed
    // first, or the port would still be bound and the connect would succeed --
    // which is exactly what a first draft of this test did.
    ServerSocket deadPort = new ServerSocket(0)
    int dead = deadPort.getLocalPort()
    deadPort.close()
    try {
      Socket never = new Socket("127.0.0.1", dead)
      System.out.println("refused: NOT RAISED")
      never.close()
    } catch (SocketException e) {
      System.out.println("refused: " + e.getMessage().contains("connect to"))
    }

    client.close()
    c2.close()
    conn.close()
    server.close()
  }
}
