// Every Lombok annotation Teyru supports, used once in one program.
import lombok.*
import lombok.experimental.*
import lombok.extern.java.*
import lombok.extern.jackson.*

// --- @Getter / @Setter / @ToString / @EqualsAndHashCode / @Accessors
@Getter
@Setter
@ToString
@EqualsAndHashCode
@AllArgsConstructor
@Accessors(chain = true)
@FieldDefaults(level = AccessLevel.PRIVATE)
class Account {
  String owner
  @NonNull String email
}

// --- @Data (getter + setter + required ctor + toString + equals)
@Data
class Point {
  private int x
  private int y
}

// --- @Value with a static constructor
@Value(staticConstructor = "of")
class Pair {
  int left
  int right
}

// --- constructor annotations
@NoArgsConstructor
@AllArgsConstructor
class Sizes {
  @Getter private int width
  @Getter @Setter private int height
}

@RequiredArgsConstructor
class Required {
  private final String id
  @NonNull private String note
  public String describe() {
    return id + "/" + note
  }
}

// --- @Builder with @Builder.Default and @Builder.ObtainVia
// @Builder.ObtainVia says how toBuilder obtains a value "given an instance"
// (Lombok's javadoc): build() reads what the builder was given, and only
// toBuilder reads the object being copied.
@Builder(toBuilder = true)
@Getter
class Request {
  private String url
  @Builder.Default private int retries = 3
  @Builder.ObtainVia(field = "url") private String tag
}

// --- @SuperBuilder over a hierarchy, with @Singular
@SuperBuilder
@Getter
class Node {
  private String name
}

@SuperBuilder
@Getter
@ToString
class Leaf extends Node {
  @Singular private List<String> values
}

// --- @With
@AllArgsConstructor
@Getter
class Config {
  private String host
  @With private int port
}

// --- @UtilityClass, @StandardException, @Locked, @Synchronized, @Log
@UtilityClass
class Maths {
  public int twice(int v) {
    return v * 2
  }
}

@StandardException
class ItemError extends RuntimeException {
}

@Log
class Worker {
  private final Object lock = new Object()

  @Locked("lock")
  public int locked() {
    return 1
  }

  @Synchronized
  public int synced() {
    return 2
  }
}

// --- @ExtensionMethod
class Extensions {
  public static String shout(String s) {
    return s.toUpperCase() + "!"
  }
}

@ExtensionMethod({Extensions.class})
class Shouter {
  public String loud(String s) {
    return s.shout()
  }
}

// --- @FieldNameConstants
@FieldNameConstants
class Person {
  private String userName
  private int userAge
}

// --- @Delegate, @Helper, @Tolerate, @NonFinal, @PackagePrivate, @Var
interface Sayer {
  String say()
}

class Speaker implements Sayer {
  public String say() {
    return "hello"
  }
}

class Delegating implements Sayer {
  @Delegate private Speaker inner = new Speaker()
}

@Tolerate
class Tolerant {
  private int v
  public Tolerant() {
  }
  @Tolerate public Tolerant(int v) {
    this.v = v
  }
  public int getV() {
    return v
  }
}

@NonFinal
class Open {
  @PackagePrivate int seen = 7
}

class Host {
  @Helper
  class Helper1 {
    public int value() {
      return 5
    }
  }

  public int use() {
    @Var int x = 1
    return x + new Helper1().value()
  }
}

@Jacksonized
class Jsonish {
  private int n
}

class Main {
  public static void main(String[] args) {
    Account a = new Account("ada", "ada@example.com")
    a.setOwner("grace").setEmail("grace@example.com")
    System.out.println(a.getOwner() + " " + a.getEmail())
    System.out.println(a.equals(new Account("grace", "grace@example.com")))

    Point p = new Point()
    p.setX(3)
    p.setY(2)
    System.out.println(p + " " + p.getX() + p.getY())

    Pair pair = Pair.of(4, 5)
    System.out.println(pair.getLeft() + pair.getRight())

    System.out.println(new Sizes().getWidth() + " " + new Sizes(8, 9).getHeight())
    System.out.println(new Required("id", "note").describe())

    Request r = Request.builder().url("u").build()
    System.out.println(r.getUrl() + " " + r.getRetries() + " " + r.getTag())
    Request copied = r.toBuilder().build()
    System.out.println(copied.getUrl() + " " + copied.getRetries() + " " + copied.getTag())

    Leaf leaf = Leaf.builder().name("n").addValues("a").addValues("b").build()
    System.out.println(leaf + " " + leaf.getName() + " " + leaf.getValues())

    Config c = new Config("host", 1).withPort(2)
    System.out.println(c.getHost() + " " + c.getPort())

    System.out.println(Maths.twice(21))
    System.out.println(new ItemError("boom").getMessage())
    System.out.println(new Worker().locked() + new Worker().synced())
    System.out.println(new Shouter().loud("quiet"))
    System.out.println(Person.Fields.userName + " " + Person.Fields.userAge)
    System.out.println(new Delegating().say())
    System.out.println(new Tolerant(9).getV())
    System.out.println(new Open().seen)
    System.out.println(new Host().use())

    try {
      new Required("id", null)
    } catch (NullPointerException e) {
      System.out.println("nonnull: " + e.getMessage())
    }

    System.out.println(cleanupRan())
  }

  @SneakyThrows
  static String cleanupRan() {
    @Cleanup AutoCloseable res = new Quiet()
    return "cleanup done"
  }
}

class Quiet implements AutoCloseable {
  public void close() {
  }
  public String toString() {
    return "quiet"
  }
}
