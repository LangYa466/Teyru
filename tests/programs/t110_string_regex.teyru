/* String's five regex methods -- split (both arities and all three sign
   cases of the limit), matches, replaceAll and replaceFirst -- now that these
   delegate to lib/21's engine instead of answering only literal patterns.
   Every expected line was produced by this same program on javac 25. */

package teyru
class Rxs {
  static void p(String s) { System.out.println("[" + s + "]") }
  static void arr(String[] a) {
    String r = "" + a.length + ":"
    for (String s : a) { r = r + "<" + s + ">" }
    System.out.println(r)
  }
  public static void main(String[] args) {
    System.out.println("a,b,c".split(",").length)
    arr("a,b,c".split(","))
    arr(",a".split(","))
    arr("a,".split(","))
    arr("a,,".split(","))
    arr("".split(","))
    arr("a".split(""))
    arr("abc".split(""))
    arr("a1b22c".split("[0-9]+"))
    arr("a1b22c".split("[0-9]+", 2))
    arr("a1b22c".split("[0-9]+", -1))
    arr("a,,b".split(",", -1))
    arr("a,b,,".split(",", 3))
    arr("aXbXc".split("X", 1))
    arr("no-match".split("z"))
    arr("a.b.c".split("\\."))
    System.out.println("abc123".matches("[a-z]+[0-9]+"))
    System.out.println("abc".matches("b"))
    System.out.println("hello world".replaceAll("[aeiou]", "*"))
    System.out.println("hello world".replaceFirst("[aeiou]", "*"))
    System.out.println("a1b2".replaceAll("[0-9]", "#"))
    System.out.println("aaa".replaceAll("a", "bb"))
    System.out.println("cost $5".replaceAll("\\$", "USD "))
  }
}
