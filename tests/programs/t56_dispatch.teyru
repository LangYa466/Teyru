// A native method that a subclass may override must still dispatch through the
// vtable: Object.toString, hashCode and equals are all native, and all three are
// meant to be overridden.
class Named {
  public int x

  public Named(int x) {
    this.x = x
  }

  public String toString() {
    return "Named(" + x + ")"
  }

  public boolean equals(Object o) {
    if (!(o instanceof Named)) {
      return false
    }
    return ((Named) o).x == x
  }

  public int hashCode() {
    return x * 1000
  }
}

class Plain {
  public int x

  public Plain(int x) {
    this.x = x
  }
}

class Main {
  public static void main(String[] args) {
    // through a super-typed receiver
    Object o = new Named(3)
    System.out.println(o.toString())
    System.out.println(o.hashCode())
    Object same = new Named(3)
    System.out.println(o.equals(same))

    // a class that overrides nothing must not loop or crash
    Plain p = new Plain(1)
    Object po = p
    System.out.println("plain ok " + (p.hashCode() == po.hashCode()))
    System.out.println("plain eq " + (p.equals(p) && !p.equals(new Plain(2))))

    // the container operations depend on this dispatch
    Map<String, Integer> byKey = new HashMap<String, Integer>()
    String runtimeKey = "a" + "b"
    byKey.put(new String(runtimeKey), 7)
    System.out.println("map " + byKey.get(new String("ab")))

    ArrayList<Named> names = new ArrayList<Named>()
    names.add(new Named(5))
    System.out.println("list " + names.contains(new Named(5)) + " " + names.indexOf(new Named(5)))

    // keys that collide must not evict each other
    Map<String, Integer> many = new HashMap<String, Integer>()
    for (int i = 0 : i < 100 : i++) {
      many.put("key" + i, i)
    }
    int found = 0
    for (int i = 0 : i < 100 : i++) {
      if (many.get("key" + i) != null && many.get("key" + i) == i) {
        found++
      }
    }
    System.out.println("collisions " + found + " size " + many.size())
    many.put("key0", 999)
    System.out.println("replace " + many.get("key0") + " size " + many.size())

    // addAll onto itself terminates and doubles the list
    ArrayList<String> self = new ArrayList<String>()
    self.add("x")
    self.add("y")
    self.addAll(self)
    System.out.println("self " + self)
  }
}
