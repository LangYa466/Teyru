// A @RequestBody parameter of a class type, read out of the request body.
//
// Spring chooses a message converter from the request's Content-Type; here the
// parameter's type is known at build time, so the converter is the binding the
// compiler already generated for that class. A String parameter still keeps the
// body as it arrived.
//
// The framework has no Java twin to run, so unlike the standard-library tests
// this expectation file is written by hand rather than produced by javac. What
// it does share with them is that the object being read and written is bound by
// the same pass, so a field the binding cannot map is a compile error.

import teyru.*

class Todo {
  int id
  String text
  boolean done
  Todo() {
    id = 0
    text = ""
    done = false
  }
}

record Note(String title, int priority) { }

@Service
class Book {
  private List<Todo> items = new ArrayList<Todo>()
  Todo add(Todo t) {
    t.id = items.size() + 1
    items.add(t)
    return t
  }
  Todo get(int id) {
    for (Todo t : items) {
      if (t.id == id) { return t }
    }
    return null
  }
}

@RestController
@RequestMapping("/todos")
class TodoController {
  @Autowired Book book

  @PostMapping("")
  Todo create(@RequestBody Todo t) {
    return book.add(t)
  }

  @GetMapping("/{id}")
  Todo one(@PathVariable("id") int id) {
    return book.get(id)
  }

  @PostMapping("/raw")
  String raw(@RequestBody String body) {
    return "raw:" + body
  }

  @PostMapping("/note")
  Note note(@RequestBody Note n) {
    return new Note(n.title().toUpperCase(), n.priority() + 1)
  }
}

class Main {
  public static void main(String[] args) {
    ApplicationContext ctx = Application.boot(args)
    Router router = Application.routerFrom(ctx)
    HttpServer server = new HttpServer(8080, router, ctx)
    System.out.println("routes=" + router.size())

    say(server, "POST /todos HTTP/1.1\r\nHost: x\r\nContent-Length: 45\r\n\r\n{\"text\":\"buy milk\",\"done\":false,\"id\":9}")
    say(server, "GET /todos/1 HTTP/1.1\r\nHost: x\r\n\r\n")
    say(server, "POST /todos/raw HTTP/1.1\r\nHost: x\r\nContent-Length: 7\r\n\r\nnot-json")
    say(server, "POST /todos/note HTTP/1.1\r\nHost: x\r\nContent-Length: 34\r\n\r\n{\"title\":\"ship it\",\"priority\":3}")
  }

  static void say(HttpServer server, String raw) {
    HttpResponse res = server.handle(HttpParser.parse(raw))
    System.out.println(res.status + " [" + res.contentType + "] " + res.body)
  }
}
