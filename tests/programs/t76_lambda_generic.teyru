// A lambda argument cannot name the type argument of a generic method, so the
// method's U is inferred from the type the call must produce. javac prints the
// same result for this program.
interface Fn<T, U> {
  U apply(T t)
}

class Box<T> {
  T v

  Box(T v) {
    this.v = v
  }

  public <U> Box<U> map(Fn<T, U> f) {
    return new Box<U>(f.apply(v))
  }
}

class Main {
  static int len(String s) {
    return s.length()
  }

  public static void main(String[] args) {
    Box<String> b = new Box<String>("hi")
    Box<Integer> c = b.map(s -> len(s))
    System.out.println(c.v)
  }
}
