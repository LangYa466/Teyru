// The Java this test is the oracle for. Compiled with javac 25 and run to
// produce t133_arrow_blocks.expected; it is not part of the Teyru build.
public class T133 {
  static String describe(int n) {
    return switch (n) {
      case 1 -> {
        yield "expr block one";
      }
      case 2 -> "expr two";
      default -> {
        yield "expr other";
      }
    };
  }

  static String pick(int n) {
    try {
      switch (n) {
        case 1 -> throw new IllegalStateException("arrow throw");
        case 2 -> {
          System.out.println("  block two ran");
        }
        default -> System.out.println("  block other ran");
      }
    } catch (IllegalStateException e) {
      return "caught " + e.getMessage();
    }
    return "no throw";
  }

  public static void main(String[] args) {
    System.out.println("== a block body stops where it is ==");
    for (int n = 1; n <= 3; n++) {
      switch (n) {
        case 1 -> {
          System.out.println("  one");
        }
        case 2 -> {
          System.out.println("  two");
        }
        default -> {
          System.out.println("  other");
        }
      }
      System.out.println("after n=" + n);
    }

    System.out.println("== a colon body still falls through ==");
    for (int n = 1; n <= 2; n++) {
      switch (n) {
        case 1:
          System.out.println("  colon one");
        case 2:
          System.out.println("  colon two");
          break;
        default:
          System.out.println("  colon other");
      }
    }

    System.out.println("== an arrow is not required to be the last thing ==");
    for (int n = 1; n <= 3; n++) {
      switch (n) {
        case 1 -> System.out.println("  plain one");
        case 2 -> System.out.println("  plain two");
        default -> System.out.println("  plain other");
      }
    }

    System.out.println("== switch expressions ==");
    for (int n = 1; n <= 3; n++) {
      System.out.println(describe(n));
    }

    System.out.println("== an arrow throw ==");
    System.out.println(pick(1));
    System.out.println(pick(2));
    System.out.println(pick(3));
  }
}
