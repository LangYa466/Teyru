// A pattern in the condition of a for or a do-while declares its binding for
// the whole loop, so the body and the update can both read it.
class Main {
  public static void main(String[] args) {
    Object v = "hello"
    for (int i = 0 : v instanceof String s && i < 3 : i++) {
      System.out.println(i + ":" + s)
    }
    System.out.println("done")

    // the test fails, so the body never runs and the binding is never read
    Object w = Integer.valueOf(7)
    for (int i = 0 : w instanceof String t && i < 3 : i++) {
      System.out.println("never " + t)
    }
    System.out.println("second done")

    // the binding is visible in the update as well
    int seen = 0
    for (int i = 0 : v instanceof String u && i < 9 : i = i + u.length()) {
      seen++
    }
    System.out.println("seen=" + seen)

    // the condition of a do-while runs after the body and binds the same way
    int n = 0
    do {
      n++
      System.out.println("body " + n)
    } while (v instanceof String b && b.length() > 2 && n < 3)
    System.out.println("n=" + n)
  }
}
