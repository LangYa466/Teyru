// The java.util classes the library was missing: StringTokenizer, Random,
// UUID, BitSet, Properties, and the range forms of the Arrays helpers -- the
// same program as t117_util_misc.java.ref, which is what produced
// t117_util_misc.expected on javac 25.
//
// Nothing printed here comes from the clock or from randomUUID itself: the
// generator is driven from fixed seeds and every UUID is parsed from a fixed
// string, so the run is reproducible. The Properties round trip writes into a
// mkdtemp directory whose path is never printed.

// The range forms of sort, fill, binarySearch and deepHashCode are called on
// ArrayOps, not Arrays: Arrays is a closed class in the prelude and the range
// overloads could not be declared on it, so they live on ArrayOps beside it.
// Every other Arrays call below (asList, deepEquals, deepToString, hashCode)
// is the prelude's own.

import teyru.Files
import teyru.Path
import teyru.ArrayList
import teyru.Arrays
import teyru.BitSet
import teyru.Collections
import teyru.Comparator
import teyru.Enumeration
import teyru.List
import teyru.NoSuchElementException
import teyru.Properties
import teyru.Random
import teyru.Set
import teyru.StringTokenizer
import teyru.UUID

class Exposed extends Random {
    public Exposed(long s) {
        super(s)
    }

    public int nextBits(int bits) {
        return next(bits)
    }
}

class ByLen implements Comparator<String> {
    public int compare(String a, String b) {
        return a.length() - b.length()
    }
}

/* A comparator of Object applied to a String[]: Java's range forms take
 * Comparator<? super T>, and these take it too, so this has to compile on
 * both sides. */
class AnyCmp implements Comparator<Object> {
    public int compare(Object a, Object b) {
        return a.toString().length() - b.toString().length()
    }
}

/* Java's Properties.load(InputStream) reads ISO-8859-1, a byte per character,
   and Teyru has no way to open a file as a stream -- System.in is the only
   InputStream a program can reach. So the bytes are read with Files and handed
   to this, which is what load(InputStream) sees: read() answers 0..255 and
   then -1, exactly as the JDK's contract says. The other load, load(Path), is
   UTF-8 and is the one a Teyru program would normally use. */
class ByteStream extends InputStream {
  private byte[] data
  private int pos = 0

  public ByteStream(byte[] data) {
    this.data = data
  }

  public int read() {
    if (this.pos >= this.data.length) {
      return -1
    }
    int b = this.data[this.pos]
    this.pos = this.pos + 1
    return b & 0xff
  }
}

class Main {

  // ------------------------------------------------------------- strings

  public static void main(String[] args) {
    strings()
    randoms()
    uuids()
    bits()
    props()
    arrays()
  }

  static void dump(String label, StringTokenizer st) {
    StringBuilder sb = new StringBuilder()
    while (st.hasMoreTokens()) {
      sb.append("<").append(st.nextToken()).append(">")
    }
    System.out.println(label + " n=" + st.countTokens() + " " + sb.toString())
  }

  static void strings() {
    dump("default", new StringTokenizer("this is\ta test\n"))
    dump("comma", new StringTokenizer("this,is,a,test", ","))
    dump("empty", new StringTokenizer(""))
    dump("onlydelims", new StringTokenizer(",,,", ","))
    dump("lead", new StringTokenizer("   a  b ", " "))
    StringTokenizer rd = new StringTokenizer("a,b;c", ",;", true)
    String acc = ""
    while (rd.hasMoreTokens()) {
      acc = acc + "|" + rd.nextToken()
    }
    System.out.println("retdelims " + acc)
    StringTokenizer ch = new StringTokenizer("1,2 3-4", ", -")
    System.out.println("count0=" + ch.countTokens())
    System.out.println("t1=" + ch.nextToken())
    System.out.println("count1=" + ch.countTokens())
    System.out.println("t2=" + ch.nextToken(" -"))
    System.out.println("t3=" + ch.nextToken())
    System.out.println("count2=" + ch.countTokens())
    System.out.println("t4=" + ch.nextToken(","))
    try {
      System.out.println("t5=" + ch.nextToken())
    } catch (NoSuchElementException ex) {
      System.out.println("t5 threw nse")
    }
    System.out.println("count3=" + ch.countTokens())
    StringTokenizer e = new StringTokenizer("x")
    System.out.println("has=" + e.hasMoreElements() + " " + e.nextElement() + " " + e.hasMoreElements())
    try {
      e.nextToken()
      System.out.println("no throw")
    } catch (NoSuchElementException ex) {
      System.out.println("nse threw")
    }
    try {
      e.nextElement()
      System.out.println("no throw2")
    } catch (NoSuchElementException ex) {
      System.out.println("nse2 threw")
    }
    try {
      StringTokenizer n = new StringTokenizer(null, ",")
      System.out.println("nullstr " + n.hasMoreTokens())
    } catch (NullPointerException ex) {
      System.out.println("nullstr threw npe")
    }
    try {
      StringTokenizer nn = new StringTokenizer("a b", (String) null)
      System.out.println("nulld " + nn.countTokens() + " " + nn.nextToken())
    } catch (NullPointerException ex) {
      System.out.println("nulld threw npe")
    }
    StringTokenizer emp2 = new StringTokenizer("", ",")
    System.out.println("empty2 " + emp2.countTokens() + " " + emp2.hasMoreTokens())
    StringTokenizer ws = new StringTokenizer(" \r\n\f\tz")
    System.out.println("ws " + ws.countTokens() + " len=" + ws.nextToken().length() + " more=" + ws.hasMoreTokens())
    StringTokenizer multi = new StringTokenizer("::a::b:", ":")
    System.out.println("multi " + multi.countTokens() + " " + multi.nextToken() + " " + multi.nextToken())
    StringTokenizer c = new StringTokenizer("abc", "")
    System.out.println("emptydelim " + c.countTokens() + " " + c.nextToken())
    Enumeration<Object> en = new StringTokenizer("p q", " ")
    System.out.println("as-enum " + en.hasMoreElements() + " " + en.nextElement() + " " + en.nextElement())
  }

