// instanceof against the whole type graph, not just the class's own list.
//
// A class's interface list is what it *declares*. The interfaces beyond that
// come from the superclass chain and from the implemented interfaces' own
// super-interfaces, and `instanceof` has to follow both: Java answers true for
// `x instanceof Collection` on a value whose class says `implements List` and
// whose List says `extends Collection`.

interface A { String a() }

interface B extends A { String b() }

interface C extends B { String c() }

class Impl implements C {
  public String a() { return "a" }
  public String b() { return "b" }
  public String c() { return "c" }
}

class Base implements A {
  public String a() { return "base" }
}

class Derived extends Base {
}

class Main {
  public static void main(String[] args) {
    Object o = new Impl()
    System.out.println(o instanceof A)
    System.out.println(o instanceof B)
    System.out.println(o instanceof C)

    // an interface a superclass implements is the subclass's too
    Object d = new Derived()
    System.out.println(d instanceof A)
    System.out.println(d instanceof Base)

    // and a cast follows the same answer
    A asA = (A) o
    System.out.println(asA.a())

    Object n = null
    System.out.println(n instanceof A)

    // a class that does not implement it still answers false
    System.out.println(o instanceof String)
  }
}
