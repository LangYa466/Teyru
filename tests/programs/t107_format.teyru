// String.format, and the varargs bug it was hiding.
//
// Every conversion below goes through a variable-arity call with an Object
// array, and the compiler used to give the *first* vararg the array's type
// instead of the element's. The argument was therefore never boxed: a bare 7
// was stored where a pointer goes, and the formatter read address 0x7. The
// crash looked like a bug in the formatter and was a bug in the call.
//
// The expected output is javac 25's, byte for byte, so the conversions, the
// flags, the width and the precision are checked against Java rather than
// against what this implementation happens to print.

class Main {
  public static void main(String[] args) {
    System.out.println(String.format("%d", 7))
    System.out.println(String.format("%x", 255))
    System.out.println(String.format("%s=%d", "a", 1))
    System.out.println(String.format("%,d", 1234567))
    System.out.println(String.format("%5.2f", 3.14159))
    System.out.println(String.format("%b", true))
    System.out.println(String.format("%c", 65))
    System.out.println(String.format("%-6s|", "ab"))
    System.out.println(String.format("%08.3f", 3.14159))
    System.out.println(String.format("%d%%", 50))
    System.out.println(String.format("%s and %s and %s", "x", 1, 2.5))
    System.out.println(String.format("%o", 8))
    System.out.println(String.format("%X", 255))
    System.out.println(String.format("%+d", 3))
    System.out.println(String.format("%.2s", "abcdef"))
  }
}
