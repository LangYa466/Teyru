// The socket layer, exercised end to end in one process.
//
// There are no threads in this language, so the client and the server are the
// same thread taking turns. That works because connect completes the handshake
// before accept is ever called: a finished connection waits in the listening
// socket's backlog until the program asks for it, which is why the order below
// -- connect, then accept -- does not deadlock. Every wait carries a deadline
// as well, so a mistake in this file fails the test instead of hanging the
// suite, which has no timeout of its own.

class Main {
  public static void main(String[] args) {
    // Port 0 asks the kernel for a free port, which is what keeps this test
    // from colliding with anything else running on the machine.
    ServerSocket server = new ServerSocket(0)
    server.setSoTimeout(2000)
    int port = server.getLocalPort()
    System.out.println("port: " + (port > 0 && port <= 65535))

    Socket client = new Socket("127.0.0.1", port)
    client.setSoTimeout(2000)
    Socket conn = server.accept()
    conn.setSoTimeout(2000)
    System.out.println("connected: " + client.isConnected() + " " + conn.isConnected())

    // A response written the way a response is written: a line at a time, with
    // the terminator the protocol wants, ending in the blank line that says the
    // headers are over.
    SocketOutputStream out = conn.getOutputStream()
    out.write("HTTP/1.1 200 OK\r\n")
    out.write("Content-Length: 5\r\n")
    out.write("\r\n")
    out.write("hello")
    out.flush()

    SocketInputStream in = client.getInputStream()
    System.out.println(in.readLine())
    System.out.println(in.readLine())
    System.out.println("blank: " + (in.readLine().length() == 0))
    // The body is bytes, not lines: readFully is the call that says so.
    byte[] body = new byte[5]
    in.readFully(body, 0, 5)
    System.out.println("body: " + Net.stringFrom(body, 0, 5))

    // ... and the client answers on the same connection, which is the whole
    // point of keeping it open.
    client.getOutputStream().write("GET /\n")
    System.out.println("request: " + conn.getInputStream().readLine())

    System.out.println("remote: " + conn.getRemoteAddress().startsWith("127.0.0.1:"))
    System.out.println("local: " + conn.getLocalAddress().startsWith("127.0.0.1:"))

    // Closing one side is the end of the stream for the other, and read()
    // reports it as -1 -- the same value a caller would see for a socket that
    // timed out if the layer had been careless about the distinction.
    client.close()
    System.out.println("client closed: " + client.isClosed())
    System.out.println("eof: " + (conn.getInputStream().read() == -1))

    conn.close()
    server.close()
    System.out.println("server closed: " + server.isClosed())

    // A second bind of the same port immediately after is the TIME_WAIT case:
    // without SO_REUSEADDR this is an "address already in use" failure on a
    // port nothing is listening on.
    ServerSocket again = new ServerSocket(port)
    System.out.println("rebound: " + (again.getLocalPort() == port))
    again.close()
  }
}
