// Intersection bounds and bounded type arguments.
//
// `<T extends A & B>` has the members of every bound, not only the leftmost:
// erasure is A, but `both(t)` may still call B's methods. And a primitive
// argument to a bounded parameter has to be boxed at the call site -- the C
// signature is erased (`C_teyru_Number*`), so `new Bag<Integer>(7)` passes a
// boxed Integer where the erasure expects a pointer.

interface Ident {
  String id()
}

interface Fixed {
  String fixed()
}

class Thing implements Ident, Fixed {
  public String id() { return "i" }
  public String fixed() { return "f" }
}

class Bag<T extends Number> {
  T v
  Bag(T v) { this.v = v }
  int half() { return v.intValue() / 2 }
}

class Main {
  public static void main(String[] args) {
    Thing t = new Thing()
    System.out.println(both(t))
    System.out.println(new Bag<Integer>(7).half())

    // a primitive argument to a bounded method type parameter
    System.out.println(pick(3, 9))

    // the bound's own members are reachable, and a field from either bound
    System.out.println(thing.id() + thing.fixed())
  }

  static Thing thing = new Thing()

  static <T extends Ident & Fixed> String both(T t) {
    return t.id() + "/" + t.fixed()
  }

  static <T extends Comparable<T>> T pick(T a, T b) {
    return a.compareTo(b) >= 0 ? a : b
  }
}
