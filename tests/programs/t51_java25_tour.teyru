// A tour of the Java 25 language surface, one feature per block.
import teyru.*
import static java.lang.Math.*

sealed interface Shape permits Circle, Square, Dot {
  double area()
}

record Circle(double r) implements Shape {
  public double area() {
    return 3.0 * r * r
  }
}

record Square(double side) implements Shape {
  public double area() {
    return side * side
  }
}

record Dot() implements Shape {
  public double area() {
    return 0.0
  }
}

enum Rank {
  LOW, MID, HIGH

  :

  public String label() {
    return this == HIGH ? "high" : "low"
  }
}

class Flexible {
  private int value

  public Flexible(int v) {
    if (v < 0) {
      throw new IllegalArgumentException("negative")
    }
    this.value = v
  }

  public int get() {
    return value
  }
}

interface Greeter {
  default String greet(String who) {
    return "hi " + who
  }
  static Greeter plain() {
    return new Greeter() {
    }
  }
}

class Main {
  // 1. pattern switch with guards, record patterns and null
  static String describe(Object o) {
    return switch (o) {
      case Circle(double r) when r > 10.0 -> "big circle"
      case Circle(double r) -> "circle " + r
      case Square(double s) -> "square " + s
      case Dot() -> "dot"
      case String s when s.isEmpty() -> "empty string"
      case String s -> "string " + s.length()
      case null -> "null"
      default -> "other"
    }
  }

  public static void main(String[] args) {
    // 2. sealed hierarchy + record patterns
    System.out.println(describe(new Circle(20.0)))
    System.out.println(describe(new Circle(1.0)))
    System.out.println(describe(new Square(2.0)))
    System.out.println(describe(new Dot()))
    System.out.println(describe(""))
    System.out.println(describe("abcd"))
    System.out.println(describe(null))
    System.out.println(describe(7))

    // 3. flexible constructor bodies (statements before super)
    System.out.println(new Flexible(4).get())
    try {
      new Flexible(-1)
    } catch (IllegalArgumentException e) {
      System.out.println("rejected")
    }

    // 4. unnamed variable in catch and for-each
    try {
      throw new IllegalStateException("ignored")
    } catch (RuntimeException _) {
      System.out.println("caught")
    }
    int[] xs = {1, 2, 3}
    int n = 0
    for (var _ : xs) {
      n++
    }
    System.out.println("iterations " + n)

    // 5. text blocks
    String block = """
      first
      second
      """
    System.out.println(block.trim())

    // 6. switch expression with yield and arrow
    int day = 3
    String kind = switch (day) {
      case 1, 7 -> "weekend"
      case 2, 3, 4, 5, 6 -> "weekday"
      default -> {
        yield "unknown"
      }
    }
    System.out.println(kind)

    // 7. enum with body and static import
    System.out.println(Rank.HIGH.label() + " " + Rank.LOW.label())
    System.out.println(abs(-3))

    // 8. interface default + static + anonymous class
    System.out.println(Greeter.plain().greet("there"))

    // 9. enhanced instanceof with binding
    Object o = "hello"
    if (o instanceof String s && s.length() > 3) {
      System.out.println("long " + s)
    }

    // 10. var and val inference, diamond, generic method
    var list = new java.util.ArrayList<String>()
    val count = 2
    System.out.println(count)
  }
}
