/* A null selector throws, in every shape a switch can take, and so does a null
   monitor. Java tests both (JLS 14.11.2 and 14.19) and the lowering read the
   pointer instead: an enum switch answered with whatever ordinal lay at
   address zero and fell through to default, so an exhaustive switch
   expression printed null; `synchronized (null)` entered the block and ran its
   body.

   A `case null` is the one shape that takes a null selector, and a type
   pattern does not -- a pattern switch throws too unless it has that case.

   Expected output is javac 25's, byte for byte. */

package teyru

class T139 {
  public static void main(String[] args) {
    System.out.println("== a constant switch over a String ==")
    String s = null
    try {
      String r = switch (s) {
        case "a" -> "A"
        default -> "other"
      }
      System.out.println("string: " + r)
    } catch (NullPointerException e) {
      System.out.println("string: NPE")
    }

    System.out.println("== an exhaustive switch over an enum ==")
    Color c = null
    try {
      String r = switch (c) {
        case RED -> "r"
        case GREEN -> "g"
      }
      System.out.println("enum: " + r)
    } catch (NullPointerException e) {
      System.out.println("enum: NPE")
    }

    System.out.println("== a pattern switch, which does not catch null ==")
    Object o = null
    try {
      String r = switch (o) {
        case String x -> "str"
        default -> "default"
      }
      System.out.println("pattern: " + r)
    } catch (NullPointerException e) {
      System.out.println("pattern: NPE")
    }

    System.out.println("== a switch over a box ==")
    Integer box = null
    try {
      String r = switch (box) {
        case 1 -> "one"
        default -> "other"
      }
      System.out.println("box: " + r)
    } catch (NullPointerException e) {
      System.out.println("box: NPE")
    }

    System.out.println("== case null is the shape that takes it ==")
    String n = null
    System.out.println("case null: " + switch (n) {
      case null -> "null case"
      default -> "default"
    })

    System.out.println("== and nothing changes when the selector is not null ==")
    Object p = "hi"
    System.out.println("non-null pattern: " + switch (p) {
      case String x -> "str:" + x
      default -> "default"
    })
    String q = "a"
    System.out.println("non-null string: " + switch (q) {
      case "a" -> "A"
      default -> "other"
    })
    Integer one = 1
    System.out.println("non-null box: " + switch (one) {
      case 1 -> "one"
      default -> "other"
    })

    System.out.println("== a null monitor ==")
    Object mon = null
    try {
      synchronized (mon) { System.out.println("locked a null monitor") }
    } catch (NullPointerException e) {
      System.out.println("synchronized: NPE")
    }
    Object real = new Object()
    synchronized (real) { System.out.println("synchronized: locked") }
  }
}

enum Color {
  RED,
  GREEN
}
