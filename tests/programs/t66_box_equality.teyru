// Boxed primitives compare the way Java compares them: value equality for the
// integral and character types, and the bit pattern for the floating point
// ones, so the two zeros differ and NaN equals itself.
class Main {
  public static void main(String[] args) {
    Integer i1 = 7
    Integer i2 = 7
    System.out.println(i1.equals(i2) + " " + (i1.compareTo(i2) == 0))

    Long l1 = 5L
    Long l2 = 9L
    System.out.println(l1.equals(5L) + " " + (l1.compareTo(l2) < 0))

    Float f1 = 1.5f
    Float f2 = 1.5f
    System.out.println(f1.equals(f2) + " " + (f1.compareTo(f2) == 0))
    System.out.println(f1.equals(1.5) + " " + Float.valueOf(0.0f).equals(Float.valueOf(-0.0f)))

    Character c1 = 'x'
    Character c2 = 'y'
    System.out.println(c1.equals('x') + " " + (c1.compareTo(c2) < 0))

    Double z = 0.0
    Double nz = -0.0
    System.out.println(z.equals(nz) + " " + z.compareTo(nz))
    System.out.println(Double.valueOf(0.0).equals(Double.valueOf(0.0)))

    Double nan = 0.0 / 0.0
    System.out.println(nan.equals(nan) + " " + (nan.compareTo(nan) == 0))

    Boolean b = true
    System.out.println(b.equals(true) + " " + b.equals(false))

    Object dummy = new Object()
    System.out.println(i1.equals(dummy) + " " + i1.equals(null))
  }
}
