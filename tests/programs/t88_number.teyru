// java.lang.Number: the six conversions a numeric wrapper has, for a receiver
// typed as Number. The expectations are javac 25's output for the same
// program, byte for byte.
class Main {
  public static void main(String[] args) {
    Number[] ns = {Byte.valueOf((byte) -3), Short.valueOf((short) 300), Integer.valueOf(70000),
                   Long.valueOf(5000000000L), Float.valueOf(2.5f), Double.valueOf(-1.75)}
    for (Number n : ns) {
      System.out.println(n.intValue() + " " + n.longValue() + " " + n.doubleValue() + " " +
                         n.floatValue() + " " + n.byteValue() + " " + n.shortValue())
    }
    Number only = Integer.valueOf(42)
    System.out.println(only.intValue() + 1)
    System.out.println(only.doubleValue() / 2)
  }
}
