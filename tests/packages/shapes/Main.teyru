// Two packages that each declare a Widget, plus the one this file declares:
// a simple name belongs to its package, so all three coexist and an import
// chooses between them.
import a.Widget

class Main {
  String tag = "main"

  public static void main(String[] args) {
    System.out.println(Widget.of("x").describe())
    System.out.println(b.Widget.kind())
    System.out.println(new Same().who())
  }
}

class Same {
  String who() { return "same file" }
}
