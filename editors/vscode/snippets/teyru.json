{
  "Class": {
    "prefix": "class",
    "body": [
      "${1:public} class ${2:Name} {",
      "\t$0",
      "}"
    ],
    "description": "Class declaration (no semicolons anywhere in Teyru)"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "${1:public} interface ${2:Name} {",
      "\t$0",
      "}"
    ],
    "description": "Interface declaration"
  },
  "Record": {
    "prefix": "record",
    "body": [
      "${1:public} record ${2:Name}(${3:Type} ${4:field}) ${5:implements ${6:Shape}} {",
      "\t$0",
      "}"
    ],
    "description": "Record declaration (components go in the record header)"
  },
  "Sealed interface": {
    "prefix": "sealed",
    "body": [
      "sealed interface ${1:Shape} permits ${2:Circle}, ${3:Square} {",
      "\t$0",
      "}"
    ],
    "description": "Sealed interface with a permits clause"
  },
  "Enum with members": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:A}, ${3:B}",
      "",
      "\t:",
      "",
      "\t$0",
      "}"
    ],
    "description": "Enum: constants, then a lone colon, then the members"
  },
  "Enum constants only": {
    "prefix": "enumconst",
    "body": [
      "enum ${1:Name} {",
      "\t${2:A}, ${3:B}, ${4:C}",
      "}"
    ],
    "description": "Enum with constants only"
  },
  "main method": {
    "prefix": "main",
    "body": [
      "${1:public} static void main(String[] args) {",
      "\t$0",
      "}"
    ],
    "description": "Entry point"
  },
  "Classic for (colon header)": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0 : ${1:i} < ${2:n} : ${1:i}++) {",
      "\t$0",
      "}"
    ],
    "description": "Teyru's for header is init : condition : update, separated by colons"
  },
  "Infinite loop": {
    "prefix": "forloop",
    "body": [
      "for ( : : ) {",
      "\t$0",
      "}"
    ],
    "description": "Infinite loop: an empty three-part for header"
  },
  "for-each": {
    "prefix": "foreach",
    "body": [
      "for (${1:Type} ${2:item} : ${3:items}) {",
      "\t$0",
      "}"
    ],
    "description": "Enhanced for (same colon character as the three-part header)"
  },
  "Switch expression (arrow + yield)": {
    "prefix": "switch",
    "body": [
      "${1:String} ${2:result} = switch (${3:value}) {",
      "\tcase ${4:CONST} -> ${5:\"a\"}",
      "\tcase ${6:OTHER} -> {",
      "\t\tyield ${7:\"b\"}",
      "\t}",
      "\tdefault -> {",
      "\t\tyield ${8:\"c\"}",
      "\t}",
      "}"
    ],
    "description": "Switch expression with arrow cases and a yield block"
  },
  "Pattern switch with when guards": {
    "prefix": "switchwhen",
    "body": [
      "return switch (${1:o}) {",
      "\tcase ${2:Integer} ${3:i} when ${3:i} > ${4:0} -> ${5:\"positive\"}",
      "\tcase ${6:String} ${7:s} when ${7:s}.isEmpty() -> ${8:\"empty\"}",
      "\tcase null -> ${9:\"null\"}",
      "\tdefault -> ${10:\"other\"}",
      "}"
    ],
    "description": "Pattern switch with when guards, a null case and a default"
  },
  "try / catch / finally": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$0",
      "} catch (${1:RuntimeException} ${2:e}) {",
      "\tSystem.out.println(${2:e})",
      "} finally {",
      "\t",
      "}"
    ],
    "description": "Try statement with catch and finally"
  },
  "try with resources": {
    "prefix": "tryres",
    "body": [
      "try (${1:Res} ${2:a} = new ${1:Res}(${3:\"a\"})",
      "     ${1:Res} ${4:b} = new ${1:Res}(${5:\"b\"})) {",
      "\t$0",
      "}"
    ],
    "description": "Try with resources: resources are separated by newlines, not semicolons"
  },
  "Property (get / set)": {
    "prefix": "prop",
    "body": [
      "${1:public} ${2:int} ${3:value} {",
      "\tget {",
      "\t\treturn field",
      "\t}",
      "\tset {",
      "\t\tfield = value",
      "\t}",
      "}"
    ],
    "description": "Native Teyru property with get and set accessors"
  },
  "Property (get only)": {
    "prefix": "propget",
    "body": [
      "${1:public} ${2:int} ${3:value} {",
      "\tget {",
      "\t\treturn ${4:field}",
      "\t}",
      "}"
    ],
    "description": "Read-only property"
  },
  "native method": {
    "prefix": "native",
    "body": [
      "${1:public} static native ${2:int} ${3:name}(${4:int a, int b})"
    ],
    "description": "Native method: body implemented in C, declared here without one"
  },
  "package declaration": {
    "prefix": "package",
    "body": [
      "package ${1:teyru}"
    ],
    "description": "Package declaration (the standard library lives in package teyru)"
  },
  "import": {
    "prefix": "import",
    "body": [
      "import ${1:java.util.List}"
    ],
    "description": "Import declaration"
  }
}
