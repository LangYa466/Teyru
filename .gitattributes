* text=auto eol=lf
*.teyru text eol=lf
*.expected text eol=lf

# GitHub shows every .teyru file as Java until linguist ships a Teyru
# definition: the syntax is Java-like, so Java is the closest grammar to
# highlight with, and without this the language bar and the diffs for the whole
# repository would be empty. The editors/ directory has the real grammars
# (VS Code TextMate, tree-sitter) to use instead.
*.teyru linguist-language=Java
*.teyru diff=java
*.expected linguist-detectable=false
*.args linguist-detectable=false

# The tree-sitter parser is generated from grammar.js by the tree-sitter CLI,
# and the headers beside it are copied from tree-sitter itself. parser.c alone
# is 113k lines: without these markers linguist counts it as C and the language
# bar reports a C project with a Go compiler attached. Marking them generated
# also collapses them in pull request diffs, which is what a file nobody edits
# by hand should do.
editors/tree-sitter-teyru/src/parser.c linguist-generated=true
editors/tree-sitter-teyru/src/node-types.json linguist-generated=true
editors/tree-sitter-teyru/src/grammar.json linguist-generated=true
editors/tree-sitter-teyru/src/tree_sitter/* linguist-vendored=true
