* text=auto eol=lf
*.teyru text eol=lf
*.expected text eol=lf

# GitHub shows every .teyru file as Java until linguist ships a Teyru
# definition: the syntax is Java-like, so Java is the closest grammar to
# highlight with, and without this the language bar and the diffs for the whole
# repository would be empty. The editors/ directory has the real grammars
# (VS Code TextMate, tree-sitter) to use instead.
*.teyru linguist-language=Java
*.teyru diff=java
*.expected linguist-detectable=false
*.args linguist-detectable=false
