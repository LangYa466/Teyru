  public static double[] copyOfRange(double[] original, int from, int to) {
    checkRange(original.length, from, to)
    double[] out = new double[to - from]
    for (int i = from : i < to : i++) {
      out[i - from] = original[i]
    }
    return out
  }

  public static <T> T[] copyOfRange(T[] original, int from, int to) {
    checkRange(original.length, from, to)
    Object[] out = new Object[to - from]
    for (int i = from : i < to : i++) {
      out[i - from] = original[i]
    }
    return (T[]) out
  }

  /* Java's range rules: from must be inside the array and not past to, while
     to may run past the end, in which case the copy is padded -- with zero
     for a primitive array and with null for an object one, which is what the
     untouched elements of the array above already hold. */
  private static void checkRange(int length, int from, int to) {
    if (from < 0 || from > length || from > to) {
      throw new IllegalArgumentException("from " + from + ", to " + to + ", length " + length)
    }
  }

  // --------------------------------------------------------------- printing

  public static String toString(int[] a) {
    if (a == null) {
      return "null"
    }
    StringBuilder sb = new StringBuilder()
    sb.append("[")
    for (int i = 0 : i < a.length : i++) {
      if (i > 0) {
        sb.append(", ")
      }
      sb.append(a[i])
    }
    sb.append("]")
    return sb.toString()
  }

