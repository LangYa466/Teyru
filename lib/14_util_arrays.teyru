  }

  public static String deepToString(boolean[][] a) {
    if (a == null) {
      return "null"
    }
    String[] rendered = new String[a.length]
    for (int i = 0 : i < a.length : i++) {
      rendered[i] = toString(a[i])
    }
    return rows(rendered)
  }

  // the brackets and separators every deepToString shares; a null row is the
  // string "null", which is what the row's own toString returns for it
  private static String rows(String[] rendered) {
    StringBuilder sb = new StringBuilder()
    sb.append("[")
    for (int i = 0 : i < rendered.length : i++) {
      if (i > 0) {
        sb.append(", ")
      }
      sb.append(rendered[i])
    }
    sb.append("]")
    return sb.toString()
  }

  /* An element that is itself an array is printed as an array, one level at a
     time. Java also breaks a cycle by printing "[...]" for an array that is
     already being printed; that bookkeeping is not here, so a self-referencing
     array does not terminate (docs/language.md §13). */
  private static void deepAppend(StringBuilder sb, Object[] a) {
    sb.append("[")
    for (int i = 0 : i < a.length : i++) {
      if (i > 0) {
        sb.append(", ")
      }
      Object o = a[i]
      if (o instanceof Object[]) {
        deepAppend(sb, (Object[]) o)
      } else {
        sb.append(o)
      }
    }
    sb.append("]")
  }

  // ---------------------------------------------------------------- asList

  /* Java's asList: a fixed-size list backed by the array it was given, so
     `asList(a).set(0, x)` writes into a. Java's List.of is the copying one,
     and is not here. */
  public static <T> List<T> asList(T... a) {
    return new ArrayAsList<T>(a)
  }
}

/* The List Arrays.asList returns. Every method that would change the length
   throws, as Java's does; set() writes through to the array. */
class ArrayAsList<T> implements List<T>, Collection<T> {
  private T[] a

  public ArrayAsList(T[] array) {
    a = array
  }

  public int size() {
    return a.length
  }

  public boolean isEmpty() {
    return a.length == 0
  }

  public T get(int i) {
    checkIndex(i)
    return a[i]
  }

  public T set(int i, T e) {
    checkIndex(i)
    T old = a[i]
    a[i] = e
    return old
  }

  public int indexOf(Object o) {
    for (int i = 0 : i < a.length : i++) {
      if (Objects.equals(o, a[i])) {
        return i
      }
    }
    return -1
  }

  public int lastIndexOf(Object o) {
    for (int i = a.length - 1 : i >= 0 : i--) {
      if (Objects.equals(o, a[i])) {
        return i
      }
    }
    return -1
  }

  public boolean contains(Object o) {
    return indexOf(o) >= 0
  }

  public Object[] toArray() {
    Object[] out = new Object[a.length]
    for (int i = 0 : i < a.length : i++) {
      out[i] = a[i]
    }
    return out
  }

  public boolean containsAll(Collection<?> c) {
    for (Object o : c) {
      if (!contains(o)) {
        return false
      }
    }
    return true
  }

  /* removeAll and retainAll are inherited from AbstractCollection in Java,
     where they remove through an iterator whose remove() throws -- so a
     removal throws and a no-op returns false. Same here. */
  public boolean removeAll(Collection<?> c) {
    if (!changedBy(c, false)) {
      return false
    }
    throw new UnsupportedOperationException("removeAll")
  }

  public boolean retainAll(Collection<?> c) {
    if (!changedBy(c, true)) {
      return false
    }
    throw new UnsupportedOperationException("retainAll")
  }

  private boolean changedBy(Collection<?> c, boolean keep) {
    for (int i = 0 : i < a.length : i++) {
      if (c.contains(a[i]) == keep) {
        return true
      }
    }
    return false
  }

  public boolean add(T e) {
    throw new UnsupportedOperationException("add")
  }

  public void add(int index, T element) {
    throw new UnsupportedOperationException("add")
  }

  public boolean addAll(Collection<? extends T> c) {
    // Java's AbstractCollection returns false for an empty collection without
    // ever reaching the iterator that throws
    if (c.isEmpty()) {
      return false
    }
    throw new UnsupportedOperationException("addAll")
  }

  public boolean addAll(int index, Collection<? extends T> c) {
    throw new UnsupportedOperationException("addAll")
  }

  public T remove(int index) {
    throw new UnsupportedOperationException("remove")
  }

  public boolean remove(Object o) {
    throw new UnsupportedOperationException("remove")
  }

  public void clear() {
    throw new UnsupportedOperationException("clear")
  }

  public Iterator<T> iterator() {
    return listIterator()
  }

  public ListIterator<T> listIterator() {
    return new ArrayAsListIterator<T>(this, a, 0)
  }

  public ListIterator<T> listIterator(int index) {
    checkIndexForAdd(index)
    return new ArrayAsListIterator<T>(this, a, index)
  }

  public List<T> subList(int from, int to) {
    if (from < 0 || to > a.length || from > to) {
      throw new IndexOutOfBoundsException("from " + from + ", to " + to + ", size " + a.length)
    }
    return new ListSubList<T>(this, from, to)
  }

  public boolean equals(Object o) {
    if (o == this) {
      return true
    }
    if (!(o instanceof List)) {
      return false
    }
    List<Object> other = (List<Object>) o
    if (other.size() != a.length) {
      return false
    }
    Iterator<Object> it = other.iterator()
    for (int i = 0 : i < a.length : i++) {
      if (!Objects.equals(a[i], it.next())) {
        return false
      }
    }
    return true
  }

  public int hashCode() {
    int h = 1
    for (int i = 0 : i < a.length : i++) {
      h = 31 * h + Objects.hashCode(a[i])
    }
    return h
  }

  public String toString() {
    return CollectionSupport.toString(this)
  }

  private void checkIndex(int i) {
    if (i < 0 || i >= a.length) {
      throw new IndexOutOfBoundsException("index " + i + ", size " + a.length)
    }
  }

  private void checkIndexForAdd(int i) {
    if (i < 0 || i > a.length) {
      throw new IndexOutOfBoundsException("index " + i + ", size " + a.length)
    }
  }
}

class ArrayAsListIterator<T> implements ListIterator<T>, Iterator<T> {
  private ArrayAsList<T> list
  private T[] a
  private int cursor
  private int lastRet = -1

  public ArrayAsListIterator(ArrayAsList<T> l, T[] array, int index) {
    list = l
    a = array
    cursor = index
  }

  public boolean hasNext() {
    return cursor < a.length
  }

  public T next() {
    if (!hasNext()) {
      throw new NoSuchElementException("no more elements")
    }
    T v = a[cursor]
    lastRet = cursor
    cursor++
    return v
  }

  public boolean hasPrevious() {
    return cursor > 0
  }

  public T previous() {
    if (!hasPrevious()) {
      throw new NoSuchElementException("no more elements")
    }
    cursor--
    lastRet = cursor
    return a[cursor]
  }

  public int nextIndex() {
    return cursor
  }

  public int previousIndex() {
    return cursor - 1
  }

  public void remove() {
    throw new UnsupportedOperationException("remove")
  }

  public void set(T e) {
    if (lastRet < 0) {
      throw new IllegalStateException("set() before next()")
    }
    a[lastRet] = e
  }

  public void add(T e) {
    throw new UnsupportedOperationException("add")
  }
}
