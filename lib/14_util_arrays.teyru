  }

  public static int binarySearch(float[] a, float key) {
    int lo = 0
    int hi = a.length - 1
    while (lo <= hi) {
      int mid = (lo + hi) >>> 1
      float v = a[mid]
      if (v < key) {
        lo = mid + 1
      } else if (v > key) {
        hi = mid - 1
      } else {
        return mid
      }
    }
    return -(lo + 1)
  }

  public static int binarySearch(double[] a, double key) {
    int lo = 0
    int hi = a.length - 1
    while (lo <= hi) {
      int mid = (lo + hi) >>> 1
      double v = a[mid]
      if (v < key) {
        lo = mid + 1
      } else if (v > key) {
        hi = mid - 1
      } else {
        return mid
      }
    }
    return -(lo + 1)
  }

  public static int binarySearch(Object[] a, Object key) {
    int lo = 0
    int hi = a.length - 1
    while (lo <= hi) {
      int mid = (lo + hi) >>> 1
      int c = compareNatural(a[mid], key)
      if (c < 0) {
        lo = mid + 1
      } else if (c > 0) {
        hi = mid - 1
      } else {
        return mid
      }
    }
    return -(lo + 1)
  }

  public static <T> int binarySearch(T[] a, T key, Comparator<T> c) {
    int lo = 0
    int hi = a.length - 1
    while (lo <= hi) {
      int mid = (lo + hi) >>> 1
      int r = compareObjects(a[mid], key, c)
      if (r < 0) {
        lo = mid + 1
      } else if (r > 0) {
        hi = mid - 1
      } else {
        return mid
      }
    }
    return -(lo + 1)
  }

  // -------------------------------------------------------------- equality

  public static boolean equals(int[] a, int[] b) {
    if (a == b) {
      return true
    }
    if (a == null || b == null || a.length != b.length) {
      return false
    }
    for (int i = 0 : i < a.length : i++) {
      if (a[i] != b[i]) {
        return false
      }
    }
    return true
  }

  public static boolean equals(long[] a, long[] b) {
    if (a == b) {
      return true
    }
    if (a == null || b == null || a.length != b.length) {
      return false
    }
    for (int i = 0 : i < a.length : i++) {
      if (a[i] != b[i]) {
        return false
      }
    }
    return true
  }

  public static boolean equals(short[] a, short[] b) {
    if (a == b) {
      return true
    }
    if (a == null || b == null || a.length != b.length) {
      return false
    }
    for (int i = 0 : i < a.length : i++) {
      if (a[i] != b[i]) {
        return false
      }
    }
    return true
  }

  public static boolean equals(char[] a, char[] b) {
    if (a == b) {
      return true
    }
    if (a == null || b == null || a.length != b.length) {
      return false
    }
    for (int i = 0 : i < a.length : i++) {
      if (a[i] != b[i]) {
        return false
      }
    }
    return true
  }

  public static boolean equals(byte[] a, byte[] b) {
    if (a == b) {
      return true
    }
    if (a == null || b == null || a.length != b.length) {
      return false
    }
    for (int i = 0 : i < a.length : i++) {
      if (a[i] != b[i]) {
        return false
      }
    }
    return true
  }

  public static boolean equals(boolean[] a, boolean[] b) {
    if (a == b) {
      return true
    }
    if (a == null || b == null || a.length != b.length) {
      return false
    }
    for (int i = 0 : i < a.length : i++) {
      if (a[i] != b[i]) {
        return false
      }
    }
    return true
  }

  /* The floating-point pairs are the ones where != is not the same as
     not-equal: NaN is not equal to itself, so two arrays holding NaN are
     equal if and only if Float.floatToIntBits agrees, which is how the JDK
     writes it too. */
  public static boolean equals(float[] a, float[] b) {
    if (a == b) {
      return true
    }
    if (a == null || b == null || a.length != b.length) {
      return false
    }
    for (int i = 0 : i < a.length : i++) {
      if (Float.valueOf(a[i]).hashCode() != Float.valueOf(b[i]).hashCode()) {
        return false
      }
    }
    return true
  }

  public static boolean equals(double[] a, double[] b) {
    if (a == b) {
      return true
    }
    if (a == null || b == null || a.length != b.length) {
      return false
    }
    for (int i = 0 : i < a.length : i++) {
      if (Double.valueOf(a[i]).hashCode() != Double.valueOf(b[i]).hashCode()) {
        return false
      }
    }
    return true
  }

  public static boolean equals(Object[] a, Object[] b) {
    if (a == b) {
      return true
    }
    if (a == null || b == null || a.length != b.length) {
      return false
    }
    for (int i = 0 : i < a.length : i++) {
      if (!Objects.equals(a[i], b[i])) {
        return false
      }
    }
    return true
  }

  /* deepEquals, for arrays whose elements are themselves arrays.
   *
   * Java decides "is this element an array" from the runtime element type. It
   * cannot be decided that way here: every Teyru array is one class
   * (docs/language.md §13), so `x instanceof Object[]` answers true for an
   * int[] as well -- and reading one as Object[] reinterprets its ints as
   * pointers, which is memory corruption, not a wrong answer. What IS known
   * statically is the element type at the call site, so the primitive 2-D
   * overloads below take the arrays Java would have reached through this one,
   * and this one is left with the object arrays it can read. */
  public static boolean deepEquals(Object[] a, Object[] b) {
    if (a == b) {
      return true
    }
    if (a == null || b == null || a.length != b.length) {
      return false
    }
    for (int i = 0 : i < a.length : i++) {
      Object x = a[i]
      Object y = b[i]
      if (x == y) {
        continue
      }
      if (x == null || y == null) {
        return false
      }
      if (x instanceof Object[] && y instanceof Object[]) {
        if (!deepEquals((Object[]) x, (Object[]) y)) {
          return false
        }
      } else if (!x.equals(y)) {
        return false
      }
    }
    return true
  }

  /* The primitive 2-D overloads. Each one is the shape Java reaches by
     recursing, written out so that the element read is typed: `a[i]` on an
     int[][] is an int[], which equals() can compare, where the same read
     through an Object[] would not be an int[]. */
  public static boolean deepEquals(int[][] a, int[][] b) {
    if (a == b) {
      return true
    }
    if (a == null || b == null || a.length != b.length) {
      return false
    }
    for (int i = 0 : i < a.length : i++) {
      if (!equals(a[i], b[i])) {
        return false
      }
    }
    return true
  }

  public static boolean deepEquals(long[][] a, long[][] b) {
    if (a == b) {
      return true
    }
    if (a == null || b == null || a.length != b.length) {
