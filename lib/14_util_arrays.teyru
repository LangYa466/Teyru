  public static char[] copyOf(char[] original, int newLength) {
    char[] out = new char[newLength]
    int n = original.length < newLength ? original.length : newLength
    for (int i = 0 : i < n : i++) {
      out[i] = original[i]
    }
    return out
  }

  public static byte[] copyOf(byte[] original, int newLength) {
    byte[] out = new byte[newLength]
    int n = original.length < newLength ? original.length : newLength
    for (int i = 0 : i < n : i++) {
      out[i] = original[i]
    }
    return out
  }

  public static boolean[] copyOf(boolean[] original, int newLength) {
    boolean[] out = new boolean[newLength]
    int n = original.length < newLength ? original.length : newLength
    for (int i = 0 : i < n : i++) {
      out[i] = original[i]
    }
    return out
  }

  public static float[] copyOf(float[] original, int newLength) {
    float[] out = new float[newLength]
    int n = original.length < newLength ? original.length : newLength
    for (int i = 0 : i < n : i++) {
      out[i] = original[i]
    }
    return out
  }

  public static double[] copyOf(double[] original, int newLength) {
    double[] out = new double[newLength]
    int n = original.length < newLength ? original.length : newLength
    for (int i = 0 : i < n : i++) {
      out[i] = original[i]
    }
    return out
  }

  /* The generic form, which the dialect can express: the array a caller gets
     back has the element type the compiler asked for, because a T[] here is
     an Object[] at run time and no element check is made on store -- exactly
     the hole Java's own generic arrays have, and why an int[] can never be
     passed to this method. */
  public static <T> T[] copyOf(T[] original, int newLength) {
    Object[] out = new Object[newLength]
    int n = original.length < newLength ? original.length : newLength
    for (int i = 0 : i < n : i++) {
      out[i] = original[i]
    }
    return (T[]) out
  }

  public static int[] copyOfRange(int[] original, int from, int to) {
    checkRange(original.length, from, to)
    int[] out = new int[to - from]
    for (int i = from : i < to : i++) {
      out[i - from] = original[i]
    }
    return out
  }

  public static long[] copyOfRange(long[] original, int from, int to) {
    checkRange(original.length, from, to)
    long[] out = new long[to - from]
    for (int i = from : i < to : i++) {
      out[i - from] = original[i]
    }
    return out
  }

  public static short[] copyOfRange(short[] original, int from, int to) {
    checkRange(original.length, from, to)
    short[] out = new short[to - from]
    for (int i = from : i < to : i++) {
      out[i - from] = original[i]
    }
    return out
  }

  public static char[] copyOfRange(char[] original, int from, int to) {
    checkRange(original.length, from, to)
    char[] out = new char[to - from]
    for (int i = from : i < to : i++) {
      out[i - from] = original[i]
    }
    return out
  }

  public static byte[] copyOfRange(byte[] original, int from, int to) {
    checkRange(original.length, from, to)
    byte[] out = new byte[to - from]
    for (int i = from : i < to : i++) {
      out[i - from] = original[i]
    }
    return out
  }

  public static boolean[] copyOfRange(boolean[] original, int from, int to) {
    checkRange(original.length, from, to)
    boolean[] out = new boolean[to - from]
    for (int i = from : i < to : i++) {
      out[i - from] = original[i]
    }
    return out
  }

  public static float[] copyOfRange(float[] original, int from, int to) {
    checkRange(original.length, from, to)
    float[] out = new float[to - from]
    for (int i = from : i < to : i++) {
