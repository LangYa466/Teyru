  public static int binarySearch(byte[] a, byte key) {
    int lo = 0
    int hi = a.length - 1
    while (lo <= hi) {
      int mid = (lo + hi) >>> 1
      byte v = a[mid]
      if (v < key) {
        lo = mid + 1
      } else if (v > key) {
        hi = mid - 1
      } else {
