  public static String deepToString(Object[] a) {
    if (a == null) {
      return "null"
    }
    StringBuilder sb = new StringBuilder()
    deepAppend(sb, a)
    return sb.toString()
  }

  /* The primitive 2-D overloads, for the reason deepEquals has them: the
     element type is known at the call site and nowhere else, and a nested
     primitive array read through an Object[] is memory corruption rather than
     a wrong answer. Java reaches these arrays through deepToString(Object[]);
     the result is the same string. */
  public static String deepToString(int[][] a) {
    if (a == null) {
      return "null"
    }
    String[] rendered = new String[a.length]
    for (int i = 0 : i < a.length : i++) {
      rendered[i] = toString(a[i])
    }
    return rows(rendered)
  }

  public static String deepToString(long[][] a) {
    if (a == null) {
      return "null"
    }
    String[] rendered = new String[a.length]
    for (int i = 0 : i < a.length : i++) {
      rendered[i] = toString(a[i])
    }
    return rows(rendered)
  }

  public static String deepToString(double[][] a) {
