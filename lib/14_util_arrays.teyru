package teyru

/* java.util.Arrays.
 *
 * Every method that Java writes once per primitive type is written once per
 * primitive type here too, because that is what the overload set is: `sort`
 * on an int[] and `sort` on an Object[] are different methods with different
 * behaviour, not one generic method with a widening conversion.
 *
 * The sorts are merge sorts. Java's primitive sorts are dual-pivot quicksort
 * and its object sorts are TimSort; both are unstable and stable respectively
 * in ways this library does not reproduce. What is reproduced is what a caller
 * can see: `sort(Object[])` and `sort(T[], Comparator)` are stable, and the
 * primitive sorts put the array in ascending order.
 *
 * Not here, and each for a reason worth naming: the streams and spliterators
 * (there is no java.util.stream to return them in), the parallel sorts (no
 * threads), `setAll` (a generator lambda per element type for a method nothing
 * else needs), the range forms `sort(a, from, to)` and `fill(a, from, to, v)`
 * (the JDK's own range checking, AIOOBE and IAE, for a shape the whole-array
 * forms already cover), and `mismatch`/`compare` (Java 9; they are a loop each,
 * but they were not asked for and nothing else in this library calls them).
 * `deepToString` and `deepEquals` also carry the per-primitive 2-D overloads
 * Java does not have -- see the note on deepEquals, it is a memory-safety
 * matter rather than an API preference.
 */

class Arrays {
  private Arrays() {
  }

  // ----------------------------------------------------------------- sorts

  public static void sort(int[] a) {
    int n = a.length
    int[] buf = new int[n]
    for (int w = 1 : w < n : w = w * 2) {
      for (int lo = 0 : lo < n : lo = lo + 2 * w) {
        int mid = lo + w < n ? lo + w : n
        int hi = lo + 2 * w < n ? lo + 2 * w : n
        mergeInt(a, buf, lo, mid, hi)
      }
    }
  }

  private static void mergeInt(int[] a, int[] buf, int lo, int mid, int hi) {
    for (int i = lo : i < hi : i++) {
      buf[i] = a[i]
    }
    int i = lo
    int j = mid
    for (int k = lo : k < hi : k++) {
      if (i >= mid) {
        a[k] = buf[j]
        j++
      } else if (j >= hi) {
        a[k] = buf[i]
        i++
      } else if (buf[j] < buf[i]) {
        a[k] = buf[j]
        j++
      } else {
        a[k] = buf[i]
        i++
      }
    }
  }

  public static void sort(long[] a) {
    int n = a.length
    long[] buf = new long[n]
    for (int w = 1 : w < n : w = w * 2) {
      for (int lo = 0 : lo < n : lo = lo + 2 * w) {
        int mid = lo + w < n ? lo + w : n
        int hi = lo + 2 * w < n ? lo + 2 * w : n
        mergeLong(a, buf, lo, mid, hi)
      }
    }
  }

  private static void mergeLong(long[] a, long[] buf, int lo, int mid, int hi) {
    for (int i = lo : i < hi : i++) {
      buf[i] = a[i]
    }
    int i = lo
    int j = mid
    for (int k = lo : k < hi : k++) {
      if (i >= mid) {
        a[k] = buf[j]
        j++
      } else if (j >= hi) {
        a[k] = buf[i]
        i++
      } else if (buf[j] < buf[i]) {
        a[k] = buf[j]
        j++
      } else {
        a[k] = buf[i]
        i++
      }
    }
  }

  public static void sort(short[] a) {
    int n = a.length
    short[] buf = new short[n]
    for (int w = 1 : w < n : w = w * 2) {
      for (int lo = 0 : lo < n : lo = lo + 2 * w) {
        int mid = lo + w < n ? lo + w : n
        int hi = lo + 2 * w < n ? lo + 2 * w : n
        mergeShort(a, buf, lo, mid, hi)
      }
    }
  }

  private static void mergeShort(short[] a, short[] buf, int lo, int mid, int hi) {
    for (int i = lo : i < hi : i++) {
      buf[i] = a[i]
    }
    int i = lo
    int j = mid
    for (int k = lo : k < hi : k++) {
      if (i >= mid) {
        a[k] = buf[j]
        j++
      } else if (j >= hi) {
        a[k] = buf[i]
        i++
      } else if (buf[j] < buf[i]) {
        a[k] = buf[j]
        j++
      } else {
        a[k] = buf[i]
        i++
      }
    }
  }

  public static void sort(char[] a) {
    int n = a.length
    char[] buf = new char[n]
    for (int w = 1 : w < n : w = w * 2) {
      for (int lo = 0 : lo < n : lo = lo + 2 * w) {
        int mid = lo + w < n ? lo + w : n
        int hi = lo + 2 * w < n ? lo + 2 * w : n
        mergeChar(a, buf, lo, mid, hi)
      }
    }
  }

  private static void mergeChar(char[] a, char[] buf, int lo, int mid, int hi) {
    for (int i = lo : i < hi : i++) {
      buf[i] = a[i]
    }
    int i = lo
    int j = mid
    for (int k = lo : k < hi : k++) {
      if (i >= mid) {
        a[k] = buf[j]
        j++
      } else if (j >= hi) {
        a[k] = buf[i]
        i++
      } else if (buf[j] < buf[i]) {
        a[k] = buf[j]
        j++
      } else {
        a[k] = buf[i]
        i++
      }
    }
  }

  public static void sort(byte[] a) {
    int n = a.length
    byte[] buf = new byte[n]
    for (int w = 1 : w < n : w = w * 2) {
      for (int lo = 0 : lo < n : lo = lo + 2 * w) {
        int mid = lo + w < n ? lo + w : n
        int hi = lo + 2 * w < n ? lo + 2 * w : n
        mergeByte(a, buf, lo, mid, hi)
      }
    }
  }

  private static void mergeByte(byte[] a, byte[] buf, int lo, int mid, int hi) {
    for (int i = lo : i < hi : i++) {
      buf[i] = a[i]
    }
    int i = lo
    int j = mid
    for (int k = lo : k < hi : k++) {
      if (i >= mid) {
        a[k] = buf[j]
        j++
      } else if (j >= hi) {
        a[k] = buf[i]
        i++
      } else if (buf[j] < buf[i]) {
        a[k] = buf[j]
        j++
      } else {
        a[k] = buf[i]
        i++
      }
    }
  }

  public static void sort(float[] a) {
    int n = a.length
    float[] buf = new float[n]
    for (int w = 1 : w < n : w = w * 2) {
      for (int lo = 0 : lo < n : lo = lo + 2 * w) {
        int mid = lo + w < n ? lo + w : n
        int hi = lo + 2 * w < n ? lo + 2 * w : n
        mergeFloat(a, buf, lo, mid, hi)
      }
    }
  }

  private static void mergeFloat(float[] a, float[] buf, int lo, int mid, int hi) {
    for (int i = lo : i < hi : i++) {
      buf[i] = a[i]
    }
    int i = lo
    int j = mid
    for (int k = lo : k < hi : k++) {
      if (i >= mid) {
        a[k] = buf[j]
        j++
      } else if (j >= hi) {
        a[k] = buf[i]
        i++
      } else if (buf[j] < buf[i]) {
        a[k] = buf[j]
        j++
      } else {
        a[k] = buf[i]
        i++
      }
    }
  }

  public static void sort(double[] a) {
    int n = a.length
    double[] buf = new double[n]
    for (int w = 1 : w < n : w = w * 2) {
      for (int lo = 0 : lo < n : lo = lo + 2 * w) {
        int mid = lo + w < n ? lo + w : n
        int hi = lo + 2 * w < n ? lo + 2 * w : n
        mergeDouble(a, buf, lo, mid, hi)
      }
    }
  }

  private static void mergeDouble(double[] a, double[] buf, int lo, int mid, int hi) {
    for (int i = lo : i < hi : i++) {
      buf[i] = a[i]
    }
    int i = lo
    int j = mid
    for (int k = lo : k < hi : k++) {
      if (i >= mid) {
        a[k] = buf[j]
        j++
      } else if (j >= hi) {
        a[k] = buf[i]
        i++
      } else if (buf[j] < buf[i]) {
        a[k] = buf[j]
        j++
      } else {
        a[k] = buf[i]
        i++
      }
    }
  }

  /* Java's sort(Object[]) is a TimSort over Comparable elements and throws
     ClassCastException when two elements refuse to compare. The same contract
     with a merge sort: the cast below is where the ClassCastException comes
     from, and it is thrown from the comparison, as in the JDK. */
  public static void sort(Object[] a) {
    if (a.length < 2) {
      return
    }
    Object[] buf = new Object[a.length]
    mergeNatural(a, buf, 0, a.length)
  }

  public static <T> void sort(T[] a, Comparator<T> c) {
    if (a.length < 2) {
      return
    }
    Object[] buf = new Object[a.length]
    mergeObjects(a, buf, 0, a.length, c)
  }

  /* The natural ordering is a merge of its own rather than the same merge with
     a null comparator: a null literal gives the checker nothing to infer the
     comparator's type argument from, which is the one place in this file where
     the dialect's inference is weaker than Java's. */
  private static void mergeNatural(Object[] a, Object[] buf, int lo, int hi) {
    if (hi - lo < 2) {
      return
    }
    int mid = lo + (hi - lo) / 2
    mergeNatural(a, buf, lo, mid)
    mergeNatural(a, buf, mid, hi)
    if (compareNatural(a[mid - 1], a[mid]) <= 0) {
      return
    }
    for (int i = lo : i < hi : i++) {
      buf[i] = a[i]
    }
    int i = lo
    int j = mid
    for (int k = lo : k < hi : k++) {
      if (i >= mid) {
        a[k] = buf[j]
        j++
      } else if (j >= hi) {
        a[k] = buf[i]
        i++
      } else if (compareNatural(buf[j], buf[i]) < 0) {
        a[k] = buf[j]
        j++
      } else {
        a[k] = buf[i]
        i++
      }
    }
  }

  private static int compareNatural(Object a, Object b) {
    Comparable<Object> x = (Comparable<Object>) a
    return x.compareTo(b)
  }

  private static <T> void mergeObjects(Object[] a, Object[] buf, int lo, int hi, Comparator<T> c) {
    if (hi - lo < 2) {
      return
    }
    int mid = lo + (hi - lo) / 2
    mergeObjects(a, buf, lo, mid, c)
    mergeObjects(a, buf, mid, hi, c)
    if (compareObjects((T) a[mid - 1], (T) a[mid], c) <= 0) {
      return
    }
    // only the range being merged is copied out, so the recursion stays
    // in place and the array is written once per level
    for (int i = lo : i < hi : i++) {
      buf[i] = a[i]
    }
    int i = lo
    int j = mid
    for (int k = lo : k < hi : k++) {
      if (i >= mid) {
        a[k] = buf[j]
        j++
      } else if (j >= hi) {
        a[k] = buf[i]
        i++
      } else if (compareObjects((T) buf[j], (T) buf[i], c) < 0) {
        a[k] = buf[j]
        j++
      } else {
        a[k] = buf[i]
        i++
      }
    }
  }

  /* A null comparator means the natural ordering, as it does in Java. The
     dispatch is here rather than at the call site so that the comparator's
     type argument still comes from a variable, not from a null literal. */
  private static <T> int compareObjects(Object a, Object b, Comparator<T> c) {
    if (c == null) {
      return compareNatural(a, b)
    }
    return c.compare((T) a, (T) b)
  }

  // -------------------------------------------------------------- searches

  public static int binarySearch(int[] a, int key) {
    int lo = 0
    int hi = a.length - 1
    while (lo <= hi) {
      int mid = (lo + hi) >>> 1
      int v = a[mid]
      if (v < key) {
        lo = mid + 1
      } else if (v > key) {
        hi = mid - 1
      } else {
        return mid
      }
    }
    return -(lo + 1)
  }

  public static int binarySearch(long[] a, long key) {
    int lo = 0
    int hi = a.length - 1
    while (lo <= hi) {
      int mid = (lo + hi) >>> 1
      long v = a[mid]
      if (v < key) {
        lo = mid + 1
      } else if (v > key) {
        hi = mid - 1
      } else {
        return mid
      }
    }
    return -(lo + 1)
  }

  public static int binarySearch(short[] a, short key) {
    int lo = 0
    int hi = a.length - 1
    while (lo <= hi) {
      int mid = (lo + hi) >>> 1
      short v = a[mid]
      if (v < key) {
        lo = mid + 1
      } else if (v > key) {
        hi = mid - 1
      } else {
        return mid
      }
    }
    return -(lo + 1)
  }

  public static int binarySearch(char[] a, char key) {
    int lo = 0
    int hi = a.length - 1
