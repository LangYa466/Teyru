package teyru

// The annotations Gson's binding reads, and the runtime side of the binding.
//
// Gson binds an object to JSON by reflection, at the moment toJson/fromJson is
// called. This used to be the compiler's work -- it generated a reader and a
// writer per bound class and rewrote each call to use them -- and the binding
// now reads the class with java.lang.reflect instead (lib/27_json_binding.teyru),
// the way Gson does. What that buys is a class the compiler never saw bound
// still binding, and one less thing the compiler has to know about.
//
// The annotations below are the ones the binding reads: @SerializedName for a
// member's name. Gson's `alternate` is not declared -- an annotation element
// with an array default is not something this language's annotation syntax has,
// and an element without a default would have to be written at every use.

// @SerializedName renames a field in the JSON, as Gson's does.
//
// Gson's `alternate` is not declared: an annotation element with an array
// default is not something this language's annotation syntax has, and an
// element without a default would have to be written at every use.
@interface SerializedName {
  String value()
}

// @Expose marks the fields a GsonBuilder with excludeFieldsWithoutExposeAnnotation
// will bind. Without that builder setting it has no effect, as in Gson.
@interface Expose {
  boolean serialize() default true
  boolean deserialize() default true
}

// @Since and @Until gate a field on the version set with setVersion.
@interface Since {
  double value()
}

@interface Until {
  double value()
}

// @JsonAdapter names a class that does the binding for the annotated type or
// field. The compiler calls its read/write through the same generated code, so
// a hand-written adapter and a generated one are used the same way.
@interface JsonAdapter {
  String value()
}

// ---------------------------------------------------------------- adapters

// JsonReader2 reads one value of a type from a JsonElement. The compiler
// generates one per bound class; the name is a spelling of "reader" that cannot
// collide with a JsonReader the program declares itself.
interface JsonReader2 {
  Object read(JsonElement e)
}

// JsonWriter2 writes one value of a type as a JsonElement.
interface JsonWriter2 {
  JsonElement write(Object v)
}

// JsonBinding is where a class becomes JSON: one reader and one writer per
// class, built from the class itself the first time it is asked for (see
// lib/27_json_binding.teyru). A call whose type says nothing about the value --
// `toJson(someObject)` where the static type is Object -- answers from the
// object's own class, which is what Gson's reflection does.
class JsonBinding {
  private static Map<String, JsonReader2> readers = new HashMap<String, JsonReader2>()
  private static Map<String, JsonWriter2> writers = new HashMap<String, JsonWriter2>()

  /* One reader per class, built the first time the class is asked about by
     looking at its fields. The compiler used to generate these and register
     them; now the class answers for itself, which is what Gson does and what
     makes a class the compiler never saw bound bind anyway. */
  public static JsonReader2 reader(Class type) {
    if (type == null) {
      return null
    }
    JsonReader2 r = readers.get(type.getName())
    if (r == null) {
      r = new ReflectReader(type)
      readers.put(type.getName(), r)
    }
    return r
  }

  public static JsonWriter2 writer(Class type) {
    if (type == null) {
      return null
    }
    JsonWriter2 w = writers.get(type.getName())
    if (w == null) {
      w = new ReflectWriter(type)
      writers.put(type.getName(), w)
    }
    return w
  }

  // bound answers how many classes the binding has built a writer for. It was
  // how many the compiler registered; now it counts what has been asked for,
  // which answers the same question a program has -- is this class bound?
  public static int bound() {
    return writers.size()
  }

  // readFrom is fromJson with a class the call site knows. The type parameter
  // is the caller's: `Person p = JsonBinding.readFrom(json, Person.class)` needs
  // no cast, and the cast is erased like every other.
  public static <T> T readFrom(String json, Class type) {
    JsonReader2 r = reader(type)
    if (r == null) {
      throw new JsonParseException("no JSON binding for a null class")
    }
    return (T) r.read(JsonParser.parseString(json))
  }

  // writeTo is toJson for a value whose static type says nothing about it.
  public static JsonElement writeTo(Object v) {
    return JsonConvert.from(v)
  }
}
