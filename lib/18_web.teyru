package teyru

// The web layer: request parsing, routing and response writing.
//
// The parsing and the response are pure functions over strings, which is what
// makes them testable without a socket: `HttpParser.parse(raw)` turns a request
// as it arrives on the wire into an HttpRequest, and HttpRequest.respond()
// turns a status, headers and a body back into the bytes to write. The server
// itself is then a loop around those two, and the routing in between.
//
// The parser is deliberately strict about what a request must have and lenient
// about what it may omit, which is what the HTTP grammar asks for: a request
// line and a Host header are required, everything else is optional, and a
// malformed request gets a 400 rather than an exception the caller has to know
// about.

// ---------------------------------------------------------------- annotations

// @RequestMapping is the base path of a controller; on a method it names the
// path and the methods it answers.
@interface RequestMapping {
  String value() default ""
  String method() default ""
}

@interface GetMapping {
  String value() default ""
}

@interface PostMapping {
  String value() default ""
}

@interface PutMapping {
  String value() default ""
}

@interface DeleteMapping {
  String value() default ""
}

@interface PatchMapping {
  String value() default ""
}

// @RequestParam binds a query parameter (or a form field) to a parameter.
@interface RequestParam {
  String value() default ""
  String defaultValue() default ""
  boolean required() default true
}

// @PathVariable binds a {name} segment of the path to a parameter.
@interface PathVariable {
  String value() default ""
}

// @RequestBody hands the request body to the parameter as a string, or, when
// the parameter is an object, as the JSON it was parsed into.
@interface RequestBody {
  boolean required() default true
}

@interface RequestHeader {
  String value() default ""
  String defaultValue() default ""
}

// @ResponseBody marks a method's result as the response body rather than a view
// name. It is implied by @RestController, as in Spring.
@interface ResponseBody {}

// ---------------------------------------------------------------- messages

class HttpRequest {
  public String method = ""
  public String path = ""
  public String query = ""
  public String version = "HTTP/1.1"
  public String body = ""
  private List<String> headerNames = new ArrayList<String>()
  private List<String> headerValues = new ArrayList<String>()
  private List<String> cookieNames = new ArrayList<String>()
  private List<String> cookieValues = new ArrayList<String>()
  private List<String> formNames = new ArrayList<String>()
  private List<String> formValues = new ArrayList<String>()

  // cookie answers the value of a cookie, or "" when the request carries none.
  // A cookie's value is everything up to the first "; ", which is how a browser
  // writes the pairs of a Cookie header.
  public String cookie(String name) {
    for (int i = 0 : i < cookieNames.size() : i++) {
      if (cookieNames.get(i).equals(name)) {
        return cookieValues.get(i)
      }
    }
    return ""
  }

  public boolean hasCookie(String name) {
    return cookie(name).isEmpty() == false
  }

  public List<String> cookieNames() {
    return cookieNames
  }

  // readCookies splits the Cookie header into its pairs. It is separate from the
  // parser so a request built by hand -- a test, a proxy -- can be given them.
  public void readCookies() {
    String raw = header("Cookie")
    if (raw.isEmpty()) {
      return
    }
    for (String pair : raw.split(";")) {
      int eq = pair.indexOf('=')
      if (eq <= 0) {
        continue
      }
      cookieNames.add(pair.substring(0, eq).trim())
      cookieValues.add(pair.substring(eq + 1).trim())
    }
  }

  // readForm reads the body of an application/x-www-form-urlencoded request into
  // the same table a query string fills, which is what makes @RequestParam read
  // a form field and a query parameter the same way, as Spring's does.
  public void readForm() {
    if (header("Content-Type").toLowerCase().startsWith("application/x-www-form-urlencoded") == false) {
      return
    }
    for (String pair : body.split("&")) {
      if (pair.isEmpty()) {
        continue
      }
      int eq = pair.indexOf('=')
      if (eq < 0) {
        formNames.add(WebUtil.urldecode(pair))
        formValues.add("")
        continue
      }
      formNames.add(WebUtil.urldecode(pair.substring(0, eq)))
      formValues.add(WebUtil.urldecode(pair.substring(eq + 1)))
    }
  }

  // keepAlive answers whether the connection stays open after this request.
  // HTTP/1.1 keeps it open unless the client says close; HTTP/1.0 closes unless
  // the client says keep-alive, which is the one difference between the two
  // versions that a server has to honour.
  public boolean keepAlive() {
    String c = header("Connection").toLowerCase()
    if (version.equals("HTTP/1.0")) {
      return c.indexOf("keep-alive") >= 0
    }
    return c.indexOf("close") < 0
  }

  // expectsContinue answers whether the client asked to be told to go ahead
  // before it sends the body.
  public boolean expectsContinue() {
    return header("Expect").toLowerCase().indexOf("100-continue") >= 0
  }

  public void addHeader(String name, String value) {
    headerNames.add(name)
    headerValues.add(value)
  }

  // header answers with the first header of that name, or "" when there is
  // none. Header names are case-insensitive, which is why the lookup lowercases
  // both sides rather than comparing as written.
  public String header(String name) {
    String want = name.toLowerCase()
    for (int i = 0 : i < headerNames.size() : i++) {
      if (headerNames.get(i).toLowerCase().equals(want)) {
        return headerValues.get(i)
      }
    }
    return ""
  }

  public boolean hasHeader(String name) {
    return header(name).isEmpty() == false
  }

  // header answers with the default when the request carries no such header,
  // which is what @RequestHeader's defaultValue asks for. A header that is
  // present but empty is present: the caller sent it and meant nothing by it.

  public String header(String name, String fallback) {
    return hasHeader(name) ? header(name) : fallback
  }

  // param returns one query parameter, or the fallback when it is absent.
  public String param(String name, String fallback) {
    String v = paramOrNull(name)
    return v == null ? fallback : v
  }

  public String paramOrNull(String name) {
    String fromForm = formParam(name)
    if (fromForm != null) {
      return fromForm
    }
    if (query.isEmpty()) {
      return null
    }
    for (String pair : query.split("&")) {
      if (pair.isEmpty()) {
        continue
      }
      int eq = pair.indexOf("=")
      if (eq < 0) {
        if (pair.equals(name)) {
          return ""
        }
        continue
      }
      if (pair.substring(0, eq).equals(name)) {
        return WebUtil.urldecode(pair.substring(eq + 1))
      }
    }
    return null
  }

  private String formParam(String name) {
    for (int i = 0 : i < formNames.size() : i++) {
      if (formNames.get(i).equals(name)) {
        return formValues.get(i)
      }
    }
    return null
  }

  public String toString() {
    return method + " " + path + (query.isEmpty() ? "" : "?" + query) + " " + version
  }
}

// HttpStatus is the reason phrase for a status code. The response writer used to
// keep seven of them and call everything else "Unknown", which is not something
// a client can read: the table below is RFC 9110's, plus the ones that are still
// in use from the versions before it.
class HttpStatus {
  public static String reason(int code) {
    if (code == 100) { return "Continue" }
    if (code == 101) { return "Switching Protocols" }
    if (code == 200) { return "OK" }
    if (code == 201) { return "Created" }
    if (code == 202) { return "Accepted" }
    if (code == 203) { return "Non-Authoritative Information" }
    if (code == 204) { return "No Content" }
    if (code == 205) { return "Reset Content" }
    if (code == 206) { return "Partial Content" }
    if (code == 300) { return "Multiple Choices" }
    if (code == 301) { return "Moved Permanently" }
    if (code == 302) { return "Found" }
    if (code == 303) { return "See Other" }
    if (code == 304) { return "Not Modified" }
    if (code == 307) { return "Temporary Redirect" }
    if (code == 308) { return "Permanent Redirect" }
    if (code == 400) { return "Bad Request" }
    if (code == 401) { return "Unauthorized" }
    if (code == 402) { return "Payment Required" }
    if (code == 403) { return "Forbidden" }
    if (code == 404) { return "Not Found" }
    if (code == 405) { return "Method Not Allowed" }
    if (code == 406) { return "Not Acceptable" }
    if (code == 408) { return "Request Timeout" }
    if (code == 409) { return "Conflict" }
    if (code == 410) { return "Gone" }
    if (code == 411) { return "Length Required" }
    if (code == 412) { return "Precondition Failed" }
    if (code == 413) { return "Content Too Large" }
    if (code == 414) { return "URI Too Long" }
    if (code == 415) { return "Unsupported Media Type" }
    if (code == 416) { return "Range Not Satisfiable" }
    if (code == 417) { return "Expectation Failed" }
    if (code == 422) { return "Unprocessable Content" }
    if (code == 426) { return "Upgrade Required" }
    if (code == 428) { return "Precondition Required" }
    if (code == 429) { return "Too Many Requests" }
    if (code == 431) { return "Request Header Fields Too Large" }
    if (code == 500) { return "Internal Server Error" }
    if (code == 501) { return "Not Implemented" }
    if (code == 502) { return "Bad Gateway" }
    if (code == 503) { return "Service Unavailable" }
    if (code == 504) { return "Gateway Timeout" }
    if (code == 505) { return "HTTP Version Not Supported" }
    return "Unknown"
  }
}

class HttpResponse {
  // headerValueOf answers the value of a header this response carries, or "".
  // The setter is header(name, value), which is what a handler uses; reading one
  // back is a test's or a client's question, so it has a name of its own.
  public String headerValueOf(String name) {
    for (int i = 0 : i < headerNames.size() : i++) {
      if (headerNames.get(i).toLowerCase().equals(name.toLowerCase())) {
        return headerValues.get(i)
      }
    }
    return ""
  }

  public int status = 200
  public String contentType = "text/plain; charset=utf-8"
  public String body = ""
  private List<String> headerNames = new ArrayList<String>()
  private List<String> headerValues = new ArrayList<String>()
  private List<String> cookieNames = new ArrayList<String>()
  private List<String> cookieValues = new ArrayList<String>()
  private List<String> cookieAttrs = new ArrayList<String>()
  // chunkedBody asks for Transfer-Encoding: chunked rather than a length, which
  // is what a body of unknown length needs.
  public boolean chunkedBody = false

  public HttpResponse header(String name, String value) {
    headerNames.add(name)
    headerValues.add(value)
    return this
  }

  public String statusText() {
    return HttpStatus.reason(status)
  }

  // respond renders the bytes to write: the status line, the headers the
  // response must carry, then the body.
  //
  // It is respond("HTTP/1.1", false, false), which is a response that closes:
  // the caller that knows the request said what its writer needs -- the
  // protocol version, whether the connection stays open, and whether the method
  // takes a body -- calls the other one.
  public String respond() {
    return respond("HTTP/1.1", false, false)
  }

  // respond is the whole response, and the four things it has to get right:
  //
  //   * Content-Length, or a chunked body, so a client knows where the body
  //     ends; without either it waits for the close.
  //   * Connection: keep-alive when the request asked for it and the protocol
  //     allows it, and close otherwise -- a keep-alive a client did not ask for
  //     is a client waiting for a close that never comes.
  //   * no body at all for HEAD, which is a response whose headers are the
  //     answer and whose body the client is not sent.
  //   * no Content-Length for 204 and 304, which are defined not to have a
  //     body.
  public String respond(String version, boolean keepAlive, boolean head) {
    boolean chunked = chunkedBody && body.length() > 0
    StringBuilder b = new StringBuilder()
    b.append(version.isEmpty() ? "HTTP/1.1" : version).append(" ").append(status).append(" ").append(statusText()).append("\r\n")
    if (body.length() > 0 || carriesBody()) {
      b.append("Content-Type: ").append(contentType).append("\r\n")
    }
    if (chunked) {
      b.append("Transfer-Encoding: chunked\r\n")
    } else if (carriesBody()) {
      b.append("Content-Length: ").append(body.length()).append("\r\n")
    }
    for (int i = 0 : i < headerNames.size() : i++) {
      b.append(headerNames.get(i)).append(": ").append(headerValues.get(i)).append("\r\n")
    }
    for (int i = 0 : i < cookieNames.size() : i++) {
      b.append("Set-Cookie: ").append(cookieNames.get(i)).append("=").append(cookieValues.get(i))
      if (cookieAttrs.get(i).length() > 0) {
        b.append("; ").append(cookieAttrs.get(i))
      }
      b.append("\r\n")
    }
    b.append("Connection: ").append(keepAlive ? "keep-alive" : "close").append("\r\n")
    b.append("\r\n")
    if (head) {
      return b.toString()
    }
    if (chunked) {
      return b.toString() + chunked(body)
    }
    return b.toString() + body
  }

  // chunked renders a body as the chunks a client reads until the one of length
  // zero. Gson's own framing is not wanted here: a body handed over whole is one
  // chunk, which is what a response of unknown length needs when the length is
  // not what the writer knows.
  public static String chunked(String body) {
    if (body.length() == 0) {
      return "0\r\n\r\n"
    }
    return Integer.toHexString(body.length()) + "\r\n" + body + "\r\n0\r\n\r\n"
  }

  // carriesBody says whether this status has a body at all, which is what
  // decides whether Content-Type and Content-Length are written.
  public boolean carriesBody() {
    return status != 204 && status != 304 && status >= 200
  }

  // setCookie writes a Set-Cookie. The attributes are the string a caller wants
  // after the name and the value -- "Path=/; HttpOnly" -- because that is how
  // the header reads and there is nothing here that would understand them
  // better.
  public HttpResponse setCookie(String name, String value, String attributes) {
    cookieNames.add(name)
    cookieValues.add(value)
    cookieAttrs.add(attributes == null ? "" : attributes)
    return this
  }
}

// ---------------------------------------------------------------- parsing

class HttpParser {
  // parse reads one request. It throws IllegalArgumentException with a message
  // the caller can put in a 400 when the request cannot be understood.
  public static HttpRequest parse(String raw) {
    if (raw.isEmpty()) {
      throw new IllegalArgumentException("empty request")
    }
    int headEnd = raw.indexOf("\r\n\r\n")
    String head = headEnd >= 0 ? raw.substring(0, headEnd) : raw
    String body = headEnd >= 0 ? raw.substring(headEnd + 4) : ""
    List<String> lines = splitLines(head)
    if (lines.size() == 0) {
      throw new IllegalArgumentException("no request line")
    }
    HttpRequest req = new HttpRequest()
    parseRequestLine(req, lines.get(0))
    for (int i = 1 : i < lines.size() : i++) {
      String line = lines.get(i)
      int colon = line.indexOf(":")
      if (colon <= 0) {
        throw new IllegalArgumentException("malformed header: " + line)
      }
      req.addHeader(line.substring(0, colon).trim(), line.substring(colon + 1).trim())
    }
    // HTTP/1.1 requires Host; a request without one is refused rather than
    // routed to whatever the default would be.
    if (req.version.equals("HTTP/1.1") && req.hasHeader("Host") == false) {
      throw new IllegalArgumentException("HTTP/1.1 request without Host")
    }
    req.body = body
    req.readCookies()
    req.readForm()
    return req
  }

  private static void parseRequestLine(HttpRequest req, String line) {
    int sp1 = line.indexOf(" ")
    if (sp1 <= 0) {
      throw new IllegalArgumentException("malformed request line: " + line)
    }
    int sp2 = WebUtil.indexOfFrom(line, " ", sp1 + 1)
    if (sp2 < 0) {
      throw new IllegalArgumentException("malformed request line: " + line)
    }
    req.method = line.substring(0, sp1)
    String target = line.substring(sp1 + 1, sp2)
    req.version = line.substring(sp2 + 1)
    int q = target.indexOf("?")
    if (q >= 0) {
      req.path = target.substring(0, q)
      req.query = target.substring(q + 1)
    } else {
      req.path = target
    }
  }

  // splitLines splits on CRLF and tolerates a bare LF, which some clients send.
  private static List<String> splitLines(String head) {
    List<String> out = new ArrayList<String>()
    StringBuilder cur = new StringBuilder()
    for (int i = 0 : i < head.length() : i++) {
      char ch = head.charAt(i)
      if (ch == '\n') {
        String s = cur.toString()
        if (s.endsWith("\r")) {
          s = s.substring(0, s.length() - 1)
        }
        out.add(s)
        cur = new StringBuilder()
      } else {
        cur.append(ch)
      }
    }
    if (cur.length() > 0) {
      out.add(cur.toString())
    }
    return out
  }
}

// WebUtil holds the string helpers the web layer needs that the standard
// library does not have. Teyru has no free functions -- every method belongs to
// a class -- so they live here rather than at file scope.
class WebUtil {
  // urldecode turns %XX and + back into the characters they stand for. `+` is
  // a space in a query string, which is the one place it differs from a path.
  public static String urldecode(String s) {
  StringBuilder b = new StringBuilder()
  int i = 0
  while (i < s.length()) {
    char ch = s.charAt(i)
    if (ch == '+') {
      b.append(' ')
      i++
      continue
    }
    if (ch == '%' && i + 2 < s.length()) {
      int hi = hexDigit(s.charAt(i + 1))
      int lo = hexDigit(s.charAt(i + 2))
      if (hi >= 0 && lo >= 0) {
        b.append((char) (hi * 16 + lo))
        i += 3
        continue
      }
    }
    b.append(ch)
    i++
  }
  return b.toString()
}

  public static int hexDigit(char ch) {
    if (ch >= '0' && ch <= '9') { return (int) ch - (int) '0' }
    if (ch >= 'a' && ch <= 'f') { return (int) ch - (int) 'a' + 10 }
    if (ch >= 'A' && ch <= 'F') { return (int) ch - (int) 'A' + 10 }
    return -1
  }

  // splitRawLines splits a head on CRLF (or LF), which is what the header
  // reader needs before the request has been parsed into one.
  public static List<String> splitRawLines(String head) {
    List<String> out = new ArrayList<String>()
    int start = 0
    while (start <= head.length()) {
      int nl = indexOfFrom(head, "\n", start)
      if (nl < 0) {
        if (start < head.length()) {
          out.add(head.substring(start))
        }
        break
      }
      String line = head.substring(start, nl)
      if (line.endsWith("\r")) {
        line = line.substring(0, line.length() - 1)
      }
      out.add(line)
      start = nl + 1
    }
    return out
  }

  // indexOfFrom is String.indexOf(String, int), which the library does not have
  // yet: searching a suffix and adding the offset back gives the same answer
  // and does not depend on it arriving.
  public static int indexOfFrom(String s, String needle, int from) {
    if (from >= s.length()) {
      return -1
    }
    int i = s.substring(from).indexOf(needle)
    return i < 0 ? -1 : i + from
  }

  // splitPath splits a path on "/" and drops the empty pieces, so "/pets/" and
  // "/pets" are the same path and the leading slash is not a segment.
  public static List<String> splitPath(String path) {
    List<String> out = new ArrayList<String>()
    for (String s : path.split("/")) {
      if (s.isEmpty() == false) {
        out.add(s)
      }
    }
    return out
  }
}

// TypeMismatchException is what a request's text fails to become when it is
// converted into a handler parameter. Spring answers a path variable or a query
// parameter that does not fit the parameter's declared type with 400, not 500:
// the client named the wrong thing, the server did not break.
class TypeMismatchException extends RuntimeException {
  public TypeMismatchException(String message) {
    super(message)
  }
}

// WebConvert turns the text a request carries into a handler parameter.
//
// The compiler generates the call, so the parameter's type is known where the
// value is read and a client that sends "@@" where an int was declared gets a
// 400 from the server rather than a NumberFormatException nothing catches.
// Java's own parseXxx is what does the work: its NumberFormatException says
// what was wrong, and this only relabels it for the client.
class WebConvert {
  public static int toInt(String raw, String param) {
    try {
      return Integer.parseInt(raw)
    } catch (NumberFormatException e) {
      throw new TypeMismatchException(mismatch(raw, param, "int"))
    }
  }

  public static long toLong(String raw, String param) {
    try {
      return Long.parseLong(raw)
    } catch (NumberFormatException e) {
      throw new TypeMismatchException(mismatch(raw, param, "long"))
    }
  }

  public static double toDouble(String raw, String param) {
    try {
      return Double.parseDouble(raw)
    } catch (NumberFormatException e) {
      throw new TypeMismatchException(mismatch(raw, param, "double"))
    }
  }

  public static float toFloat(String raw, String param) {
    try {
      return Float.parseFloat(raw)
    } catch (NumberFormatException e) {
      throw new TypeMismatchException(mismatch(raw, param, "float"))
    }
  }

  public static short toShort(String raw, String param) {
    try {
      return Short.parseShort(raw)
    } catch (NumberFormatException e) {
      throw new TypeMismatchException(mismatch(raw, param, "short"))
    }
  }

  public static byte toByte(String raw, String param) {
    try {
      return Byte.parseByte(raw)
    } catch (NumberFormatException e) {
      throw new TypeMismatchException(mismatch(raw, param, "byte"))
    }
  }

  // mismatch builds the message a failed conversion carries, so the generated
  // conversions the compiler writes for an enum read the same as these.
  public static String mismatch(String raw, String param, String type) {
    return "failed to convert " + (raw == null ? "null" : "\"" + raw + "\"") +
      " to " + type + " for parameter \"" + param + "\""
  }
}

// ---------------------------------------------------------------- routing

// Handler answers one request. The compiler generates one per mapping method:
// it looks the controller bean up in the context, which is what makes a
// controller a singleton shared by every request, and fills the method's
// parameters from the request before calling it.
interface Handler {
  Object handle(ApplicationContext ctx, HttpRequest req, Map<String, String> vars)
}

class Route {
  public String method
  public String pattern
  public String beanName
  public Handler handler
  // segments is the pattern split on "/", with "{}" markers for the variable
  // ones; matching walks it rather than re-parsing the pattern per request.
  public List<String> segments
  public List<String> variables
}

// Router matches a request against the registered routes. The most specific
// match wins, as in Spring: a literal segment beats a variable one, so /pets/mine
// is not swallowed by /pets/{id} whatever order they were registered in.
class Router {
  private List<Route> routes = new ArrayList<Route>()

  public void add(String method, String pattern, String beanName, Handler handler) {
    Route r = new Route()
    r.method = method
    r.pattern = pattern
    r.beanName = beanName
    r.handler = handler
    addRoute(r)
  }

  // addRoute indexes a route the compiler prepared, which is how the
  // registrations in BeanRegistry reach the router.
  public void addRoute(Route r) {
    r.segments = WebUtil.splitPath(r.pattern)
    r.variables = new ArrayList<String>()
    for (String seg : r.segments) {
      if (seg.startsWith("{") && seg.endsWith("}")) {
        r.variables.add(seg.substring(1, seg.length() - 1))
      }
    }
    routes.add(r)
  }

  public int size() {
    return routes.size()
  }

  public List<Route> all() {
    return routes
  }

  // match answers with the route for a method and path, or null. It also fills
  // vars with the path variables it bound.
  public Route match(String method, String path, Map<String, String> vars) {
    List<String> want = WebUtil.splitPath(path)
    Route best = null
    int bestScore = -1
    for (Route r : routes) {
      if (r.method.equals(method) == false && r.method.equals("*") == false) {
        continue
      }
      int score = matchScore(r.segments, want, vars)
      if (score > bestScore) {
        bestScore = score
        best = r
      }
    }
    if (best == null) {
      return null
    }
    // bind again for the winner: the scan above tried every route against the
    // same map
    Map<String, String> bound = new HashMap<String, String>()
    matchScore(best.segments, want, bound)
    for (String v : best.variables) {
      String val = bound.get(v)
      vars.put(v, val == null ? "" : val)
    }
    return best
  }

  // matchScore answers with how well a pattern fits, or -1 for no fit. A
  // literal segment scores higher than a variable, which is what makes the
  // most specific route win.
  private int matchScore(List<String> pattern, List<String> want, Map<String, String> vars) {
    if (pattern.size() != want.size()) {
      return -1
    }
    int score = 0
    for (int i = 0 : i < pattern.size() : i++) {
      String p = pattern.get(i)
      if (p.startsWith("{") && p.endsWith("}")) {
        vars.put(p.substring(1, p.length() - 1), WebUtil.urldecode(want.get(i)))
        score += 1
        continue
      }
      if (p.equals(want.get(i)) == false) {
        return -1
      }
      score += 10
    }
    return score
  }
}

// ---------------------------------------------------------------- server

// HttpServer serves the routes on a port. Requests are handled one at a time:
// the language has no threads, so a second connection waits for the first to
// finish. That is honest about what it is -- a server for a program that
// answers requests, not one that serves a crowd -- and the shape is the one a
// thread-per-connection version needs.
class HttpServer {
  private int port
  private int boundPort = -1
  private ServerSocket listener = null
  private Router router
  private ApplicationContext ctx
  private boolean verbose = false
  private int served = 0
  // readTimeoutMs bounds how long one connection may take to send its request.
  // Ten seconds is generous for a request that is already written and short
  // enough that a stalled client does not hold the server for the afternoon.
  private int readTimeoutMs = 10000
  // The WebSockets this server answers, by path. A path is a WebSocket when it
  // was registered as one, which is what the upgrade checks.
  private List<String> socketPaths = new ArrayList<String>()
  private List<WebSocketHandler> socketHandlers = new ArrayList<WebSocketHandler>()

  public HttpServer addWebSocket(String path, WebSocketHandler handler) {
    socketPaths.add(path)
    socketHandlers.add(handler)
    return this
  }

  private WebSocketHandler socketAt(String path) {
    for (int i = 0 : i < socketPaths.size() : i++) {
      if (socketPaths.get(i).equals(path)) {
        return socketHandlers.get(i)
      }
    }
    return null
  }

  public HttpServer(int port, Router router, ApplicationContext ctx) {
    this.port = port
    this.router = router
    this.ctx = ctx
  }

  public HttpServer setVerbose(boolean v) {
    this.verbose = v
    return this
  }

  // getPort answers with the port the server is listening on. Before bind() it
  // is the port that was asked for; after it, the one the kernel gave, which is
  // what makes `new HttpServer(0, ...)` useful -- port 0 asks for any free
  // port, and only the bind knows which.
  public int getPort() { return boundPort >= 0 ? boundPort : port }

  // bind starts listening. serve and serveIdle call it themselves; a caller
  // that wants the port before serving -- a test that connects to itself --
  // calls it first.
  public void bind() {
    if (listener == null) {
      listener = new ServerSocket(port)
      boundPort = listener.getLocalPort()
    }
  }

  public void close() {
    if (listener != null) {
      listener.close()
      listener = null
    }
  }

  public int getServed() { return served }

  public Router getRouter() { return router }

  public void setRouter(Router r) { this.router = r }

  public ApplicationContext context() { return ctx }

  public void log(String line) {
    if (verbose) {
      System.out.println(line)
    }
  }

  // serve accepts connections and answers them, one at a time, until the
  // program ends.
  //
  // One at a time is not a limitation of this code but of the language: there
  // are no threads (docs/language.md §13), so a second client waits for the
  // first to finish. The shape is the one a thread-per-connection version needs
  // -- accept, read one request, answer it, close -- so adding threads later
  // changes where the loop runs, not what it does.
  public void serve() {
    bind()
    try {
      while (true) {
        Socket s = listener.accept()
        serveOne(s)
      }
    } finally {
      close()
    }
  }

  // serveIdle is serve with a deadline: it answers connections until none
  // arrives within idleMillis, then returns how many it answered.
  //
  // A program with no threads cannot be interrupted, so an accept that nobody
  // connects to would hang the process with no way back. Bounding the wait is
  // what makes a serving loop testable -- and it is the same mechanism Java's
  // ServerSocket.setSoTimeout gives a server that wants to check its own state
  // between connections.
  public int serveIdle(int idleMillis) {
    bind()
    listener.setSoTimeout(idleMillis)
    int answered = 0
    // The listener stays open across calls: a caller that serves in bursts --
    // accept what is waiting, do something else, come back -- must not have its
    // port closed between them, or the next client's connection is refused
    // before the loop gets a chance to bind again.
    while (true) {
      Socket s
      try {
        s = listener.accept()
      } catch (SocketTimeoutException e) {
        break
      }
      serveOne(s)
      answered++
    }
    return answered
  }

  // serveOne reads one request off a connection, answers it, and closes. A
  // client that connects and says nothing, or goes away mid-request, is not an
  // error the server reports: it is a connection that ends.
  private void serveOne(Socket s) {
    try {
      // A client that opens a connection and never finishes a request would
      // otherwise hold the only thread there is, forever.
      s.setSoTimeout(readTimeoutMs)
      SocketInputStream in = s.getInputStream()
      SocketOutputStream out = s.getOutputStream()
      // One connection answers as many requests as the client keeps sending:
      // HTTP/1.1 keeps a connection open unless either side says close, and a
      // browser sends a page and its assets down one.
      while (true) {
        String raw = readRequest(in, out)
        if (raw == null) {
          return
        }
        HttpRequest req = null
        HttpResponse res
        try {
          req = HttpParser.parse(raw)
          res = handle(req)
        } catch (IllegalArgumentException e) {
          // a request the parser refuses is the client's mistake, and the status
          // that says so is 400
          res = new HttpResponse()
          res.status = 400
          res.body = e.getMessage()
        }
        // An upgrade turns the connection into a WebSocket, and a WebSocket
        // never goes back to being HTTP: the frames are read until the peer
        // closes, and then the connection ends.
        WebSocketHandler ws = req == null ? null : socketAt(req.path)
        if (req != null && WebSocketUpgrade.wanted(req, req.path, ws != null)) {
          out.write(WebSocketUpgrade.response(req.header("Sec-WebSocket-Key")))
          out.flush()
          WebSocketConnection.run(s, in, out, new WebSocketSession(s, out, req.path), ws)
          return
        }
        boolean keep = req != null && req.keepAlive()
        boolean head = req != null && req.method.equals("HEAD")
        out.write(res.respond(req == null ? "HTTP/1.1" : req.version, keep, head))
        out.flush()
        if (keep == false) {
          return
        }
      }
    } catch (IOException e) {
      // a connection that failed is not a reason to stop serving
    } finally {
      s.close()
    }
  }

  // readRequest reads the head and the body off a stream and renders the
  // request the parser expects: the lines, a blank line, then the bytes.
  //
  // The body is read by length rather than by line, because a body is bytes and
  // may contain anything -- a line reader would stop at the first CRLF inside
  // it and hand a truncated document to the handler.
  private String readRequest(SocketInputStream in, SocketOutputStream out) {
    StringBuilder head = new StringBuilder()
    while (true) {
      String line = in.readLine()
      if (line == null) {
        // the connection ended before the blank line: nothing to answer, unless
        // a request line already arrived and the head was simply unterminated
        return head.length() == 0 ? null : head.toString()
      }
      if (line.isEmpty()) {
        break
      }
      head.append(line).append("\r\n")
    }
    String headText = head.toString()
    // A client that asked to be told to go ahead waits for the answer before it
    // sends the body, so the answer is written before anything is read.
    if (expectsContinue(headText)) {
      out.write("HTTP/1.1 100 Continue\r\n\r\n")
      out.flush()
    }
    if (chunkedBody(headText)) {
      return headText + "\r\n" + readChunked(in)
    }
    int len = contentLength(headText)
    if (len <= 0) {
      return headText
    }
    byte[] buf = new byte[len]
    int got = 0
    while (got < len) {
      int n = in.read(buf, got, len - got)
      if (n <= 0) {
        break
      }
      got += n
    }
    if (got == 0) {
      return headText
    }
    // The head already ends with CRLF -- every line was appended with one --
    // so a single CRLF more is the blank line that ends it. Adding two, as the
    // shape "head CRLF CRLF body" suggests, puts one CRLF of the head's into
    // the body and every POST arrives with a leading blank line.
    return headText + "\r\n" + Net.stringFrom(buf, 0, got)
  }

  // contentLength reads Content-Length out of a request head, or -1 when the
  // header is absent or unreadable. A head is not parsed here: the parser does
  // that, and this only needs one number out of it before deciding how much to
  // read.
  private int contentLength(String head) {
    for (String line : WebUtil.splitRawLines(head)) {
      int colon = line.indexOf(":")
      if (colon <= 0) {
        continue
      }
      if (line.substring(0, colon).trim().toLowerCase().equals("content-length")) {
        try {
          return Integer.parseInt(line.substring(colon + 1).trim())
        } catch (IllegalArgumentException e) {
          return -1
        }
      }
    }
    return -1
  }

  // expectsContinue reads Expect: 100-continue out of a request head.
  private boolean expectsContinue(String head) {
    return headerIs(head, "expect", "100-continue")
  }

  // chunkedBody reads Transfer-Encoding out of a request head.
  private boolean chunkedBody(String head) {
    return headerIs(head, "transfer-encoding", "chunked")
  }

  private boolean headerIs(String head, String name, String want) {
    for (String line : WebUtil.splitRawLines(head)) {
      int colon = line.indexOf(":")
      if (colon <= 0) {
        continue
      }
      if (line.substring(0, colon).trim().toLowerCase().equals(name)) {
        return line.substring(colon + 1).trim().toLowerCase().indexOf(want) >= 0
      }
    }
    return false
  }

  // readChunked reads a body whose length arrives in pieces: a line holding the
  // size in hexadecimal, the bytes, and a line of length zero to end it. The
  // extensions after a size and the trailers after the last chunk are read and
  // dropped, which is what a server that does not use them does.
  private String readChunked(SocketInputStream in) {
    StringBuilder b = new StringBuilder()
    while (true) {
      String line = in.readLine()
      if (line == null) {
        break
      }
      int semi = line.indexOf(';')
      String size = (semi >= 0 ? line.substring(0, semi) : line).trim()
      int n
      try {
        n = Integer.parseInt(size, 16)
      } catch (NumberFormatException e) {
        break
      }
      if (n == 0) {
        // the trailers end at the blank line, which is what was just read
        in.readLine()
        break
      }
      byte[] buf = new byte[n]
      int got = 0
      while (got < n) {
        int k = in.read(buf, got, n - got)
        if (k <= 0) {
          break
        }
        got += k
      }
      b.append(Net.stringFrom(buf, 0, got))
      in.readLine()
    }
    return b.toString()
  }

  // knownMethod reports whether this server implements a method at all. The set
  // is HTTP's own: anything else is a 501 rather than a 404, because a client
  // that sends FOO learns the server does not know FOO.
  private boolean knownMethod(String method) {
    return method.equals("GET") || method.equals("POST") || method.equals("PUT") ||
        method.equals("DELETE") || method.equals("PATCH") || method.equals("HEAD") ||
        method.equals("OPTIONS")
  }

  // allowOf lists the methods a path takes, in the order a client is used to
  // seeing them, or "" when the path is not routed at all.
  private String allowOf(String path) {
    String[] order = { "GET", "HEAD", "POST", "PUT", "PATCH", "DELETE" }
    StringBuilder b = new StringBuilder()
    for (String m : order) {
      Map<String, String> ignored = new HashMap<String, String>()
      if (router.match(m, path, ignored) != null) {
        if (b.length() > 0) {
          b.append(", ")
        }
        // HEAD is what GET answers, so a path with a GET takes a HEAD even
        // though no route names one
        b.append(m)
      }
    }
    return b.toString()
  }

  // handle answers one request. It is separate from the socket loop so that it
  // can be exercised without one, and so a failure inside a handler becomes a
  // 500 rather than an exception that escapes the connection.
  public HttpResponse handle(HttpRequest req) {
    HttpResponse res = new HttpResponse()
    // CORS first: a preflight is a question about the route rather than a call
    // to it, so it is answered here and never reaches a controller.
    if (isPreflight(req)) {
      applyCors(req, res)
      return res
    }
    // A method this server does not implement is a 501, which is what says so;
    // a method it does implement but has no route for is a 404 below.
    if (knownMethod(req.method) == false) {
      res.status = 501
      res.body = "not implemented: " + req.method
      return res
    }
    // OPTIONS asks what a path takes, and the answer is the Allow header. It is
    // part of the protocol rather than of a program, so no route answers it.
    if (req.method.equals("OPTIONS")) {
      String allow = allowOf(req.path)
      if (allow.isEmpty()) {
        res.status = 404
        res.body = "not found: " + req.path
        return res
      }
      res.status = 204
      res.header("Allow", allow)
      return res
    }
    // HEAD is a GET whose body is not sent, so it is routed as one and the
    // writer drops the body.
    String method = req.method.equals("HEAD") ? "GET" : req.method
    Map<String, String> vars = new HashMap<String, String>()
    Route r = router.match(method, req.path, vars)
    if (r == null) {
      // a path that exists under another method is a 405, not a 404: the
      // client asked the wrong thing, not for something that is not there, and
      // the methods that are there are what Allow says
      String allow = allowOf(req.path)
      if (allow.isEmpty() == false) {
        res.status = 405
        res.header("Allow", allow)
        res.body = "method not allowed: " + req.method
        return res
      }
      // a path no route claimed is a file, when the program has a static
      // directory and the file is there
      HttpResponse file = StaticFiles.serve(staticRoot(), req.path)
      if (file != null) {
        served++
        return file
      }
      res.status = 404
      res.body = "not found: " + req.path
      return res
    }
    // The interceptors run around the route, and one that answers false stops
    // the request before the controller sees it.
    List<HandlerInterceptor> chain = interceptors()
    for (int i = 0 : i < chain.size() : i++) {
      if (chain.get(i).preHandle(req) == false) {
        res.status = 403
        res.body = "forbidden: " + req.path
        return res
      }
    }
    HttpResponse out
    try {
      out = invoke(r, req, vars, res)
    } catch (TypeMismatchException e) {
      // the request named a value the parameter cannot hold: the client's
      // mistake, so it is a 400 rather than the advice below
      out = new HttpResponse()
      out.status = 400
      out.body = "bad request: " + e.getMessage()
    } catch (Exception e) {
      // A route is called reflectively, so what the controller threw arrives
      // wrapped in an InvocationTargetException. The advice has to see the
      // exception the controller meant -- the one it would have seen if the
      // call had been direct -- so the wrapper comes off here.
      Exception thrown = e
      if (e instanceof InvocationTargetException && e.getCause() instanceof Exception) {
        thrown = (Exception) e.getCause()
      }
      // what a @ControllerAdvice answers for this kind of failure, and a 500
      // when no advice does. An exception, rather than a runtime one: a route
      // that throws a checked exception, or an advice that throws while
      // answering, is still an answer the client has to get.
      HttpResponse advised = WebAdvice.answer(ctx, thrown, req)
      if (advised != null) {
        out = advised
      } else {
        out = new HttpResponse()
        out.status = 500
        out.body = "internal error: " + thrown.getMessage()
      }
    }
    for (int i = chain.size() - 1 : i >= 0 : i--) {
      chain.get(i).afterCompletion(req, out)
    }
    // The CORS headers go on the answer that is actually sent: a route builds
    // its own response, so headers set on the one above would be dropped.
    applyCors(req, out)
    return out
  }

  // invoke runs one route and answers what the connection writes.
  private HttpResponse invoke(Route r, HttpRequest req, Map<String, String> vars, HttpResponse res) {
    Object out = r.handler.handle(ctx, req, vars)
    if (out instanceof HttpResponse) {
      return (HttpResponse) out
    }
    if (out != null) {
      res.body = out.toString()
    }
    served++
    return res
  }

  // isPreflight is a browser asking whether a cross-origin call would be
  // allowed, which is an OPTIONS that names the method it means to use.
  private boolean isPreflight(HttpRequest req) {
    return req.method.equals("OPTIONS") && req.header("Access-Control-Request-Method").length() > 0
  }

  // applyCors adds the headers an allowed origin needs. `spring.web.cors` names
  // the origins -- "*" or a comma-separated list -- and with none set a browser
  // on another origin is not told anything, which is the safe default.
  private void applyCors(HttpRequest req, HttpResponse res) {
    String allowed = ctx == null ? "" : ctx.getProperty("spring.web.cors", "")
    String origin = req.header("Origin")
    if (allowed.length() == 0 || origin.length() == 0) {
      return
    }
    if (allowed.equals("*") == false && allowed.indexOf(origin) < 0) {
      return
    }
    res.header("Access-Control-Allow-Origin", allowed.equals("*") ? "*" : origin)
    res.header("Access-Control-Allow-Methods", "GET, POST, PUT, PATCH, DELETE, OPTIONS")
    res.header("Access-Control-Allow-Headers", req.header("Access-Control-Request-Headers", "*"))
    res.header("Vary", "Origin")
  }

  // staticRoot is where a program's files are served from, which its
  // configuration may name.
  private String staticRoot() {
    return ctx == null ? "static" : ctx.getProperty("spring.web.static", "static")
  }

  // interceptors are the beans that implement HandlerInterceptor, built once
  // and kept: a request should not ask the container a question it can answer
  // the same way every time.
  private List<HandlerInterceptor> chain = null

  private List<HandlerInterceptor> interceptors() {
    if (chain == null) {
      chain = ctx == null ? new ArrayList<HandlerInterceptor>() : WebAdvice.interceptors(ctx)
    }
    return chain
  }
}

// ---------------------------------------------------------------- bootstrap

// @SpringBootApplication is @Configuration + @ComponentScan + @EnableAutoConfiguration
// in one, which in Spring is what makes a class the program's root.
@interface SpringBootApplication {
  String value() default ""
}

// Application is the program's entry point: it builds the context, collects the
// routes the compiler registered, and serves them.
//
// The port comes from the server.port property, or from the argument, or is
// 8080 -- the same order Spring uses for a property and the same default.
class Application {
  // boot creates the container and builds every singleton.
  public static ApplicationContext boot(String[] args) {
    ApplicationContext ctx = new ApplicationContext()
    for (String a : args) {
      int eq = a.indexOf("=")
      if (a.startsWith("--") && eq > 2) {
        ctx.setProperty(a.substring(2, eq), a.substring(eq + 1))
      }
    }
    ctx.refresh()
    return ctx
  }

  // serve is the whole application: the routes a controller declares and the
  // WebSockets a handler declares are read from the container, the server is
  // bound to a port, and it runs until it is idle. It is what a program's main
  // does, and it is here so that main is one line.
  public static void serve(ApplicationContext ctx, int port, int idleMs) {
    HttpServer server = new HttpServer(port, routerFrom(ctx), ctx)
    WebSocketScanner.register(ctx, server)
    server.bind()
    server.serveIdle(idleMs == 0 ? 0 : idleMs)
  }

  // routerFrom builds the router by reading each controller's methods, which is
  // what the compiler used to do while checking: the mapping annotations, the
  // class's prefix, and one handler per mapping (lib/31_routes.teyru).
  public static Router routerFrom(ApplicationContext ctx) {
    Router r = new Router()
    for (Class c : BeanRegistry.registered()) {
      RouteScanner.register(r, c, "")
    }
    return r
  }

  // portOf answers with the port to listen on: the request's argument, then the
  // server.port property, then 8080.
  public static int portOf(ApplicationContext ctx, String[] args) {
    for (String a : args) {
      if (a.startsWith("--port=")) {
        return Integer.parseInt(a.substring(7))
      }
    }
    return Integer.parseInt(ctx.getProperty("server.port", "8080"))
  }
}
