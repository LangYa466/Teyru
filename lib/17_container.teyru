package teyru

// The annotations and the container behind the Spring-compatible framework.
//
// Spring resolves beans by reflection at startup. Teyru resolves them at
// compile time instead -- a missing bean, a cycle or two candidates for one
// type is an error at build time rather than a startup failure. Reflection
// exists here (lib/26_reflect.teyru) and the container does not use it: the
// set of classes is fixed when the program is compiled, so the compiler knows
// every annotated class, every field to inject and every dependency edge. It
// generates one registration per bean into BeanRegistry, and this file is what
// reads that list back. The result is what Spring does -- singleton beans
// constructed once, injected by type, lifecycle callbacks in order -- with the
// wiring resolved before the program runs instead of while it starts.
//
// What that buys: a missing bean, a circular dependency or a type that does not
// match is a compile error rather than a startup stack trace. What it costs:
// there is no way to add a bean at runtime, which is a thing Spring programs do
// and Teyru programs cannot.

// ---------------------------------------------------------------- annotations

// @Component marks a class the container owns. @Service, @Repository,
// @Controller and @RestController are the same thing with a different name,
// which is how Spring reads them too.
@interface Component {
  String value() default ""
}

@interface Service {
  String value() default ""
}

@interface Repository {
  String value() default ""
}

@interface Controller {
  String value() default ""
}

@interface RestController {
  String value() default ""
}

// @Configuration marks a class whose @Bean methods define beans rather than a
// bean itself.
@interface Configuration {
  String value() default ""
}

@interface Bean {
  String value() default ""
}

// @Autowired asks for the bean of the field's or parameter's type. `required`
// is accepted for compatibility; a missing bean is refused at compile time
// whether or not it is set, because a container with an optional dependency it
// cannot satisfy is a program that fails later instead of now.
@interface Autowired {
  boolean required() default true
}

// @Qualifier names which bean to inject when several have the type.
@interface Qualifier {
  String value()
}

// @Value takes a property: @Value("${server.port}") or, with a default,
// @Value("${server.port:8080}").
@interface Value {
  String value()
}

@interface PostConstruct {}

@interface PreDestroy {}

// @Scope("prototype") gives a new instance per request for the bean; the
// default is "singleton".
@interface Scope {
  String value()
}

// @Primary marks the bean to inject when several share a type and none was
// named with @Qualifier.
@interface Primary {}

// ---------------------------------------------------------------- registry

// A bean's factory builds it; the injector fills its @Autowired members and
// calls @PostConstruct. The compiler generates both for every annotated class.
interface BeanFactory {
  Object create(ApplicationContext ctx)
}

interface BeanInjector {
  void inject(Object bean, ApplicationContext ctx)
}

class BeanDefinition {
  public String name
  // type is the bean's class. A getBean(SomeType.class) matches it with
  // Class.isAssignableFrom, which is how a lookup by interface works: the bean's
  // own class, a superclass, or an interface it implements.
  public Class type
  public BeanFactory factory
  public BeanInjector injector
  public boolean singleton = true
  public boolean primary = false
  // instance is the bean once it exists. A singleton is built once; a
  // prototype is built per lookup and never stored here.
  public Object instance
  // creating guards against a cycle: a bean asked for while it is being built
  // is a dependency loop, and answering with a half-built object would be worse
  // than refusing.
  public boolean creating = false
}

// BeanRegistry is what the compiler's generated class fills in: the classes
// that carry a component annotation. There is no classpath to scan here, so the
// compiler's list is what the container knows about; everything else about a
// bean -- its name, its scope, its constructor, its @Autowired fields, its
// @Bean methods -- is read off the class itself (lib/28_container_reflect.teyru),
// which is what Spring does.
class BeanRegistry {
  private static List<Class> classes = new ArrayList<Class>()
  private static List<Route> routeDefs = new ArrayList<Route>()

  public static void register(Class type) {
    classes.add(type)
  }

  public static List<Class> registered() {
    return classes
  }

  public static int count() {
    return classes.size()
  }

  // route records a controller mapping. The handler the compiler generates
  // already knows which bean answers, so the name is not needed here.
  public static void route(String method, String path, Handler handler) {
    Route r = new Route()
    r.method = method
    r.pattern = path
    r.handler = handler
    routeDefs.add(r)
  }

  public static List<Route> routes() {
    return routeDefs
  }

  public static int routeCount() {
    return routeDefs.size()
  }
}

// ---------------------------------------------------------------- context

class ApplicationContext {
  private Map<String, BeanDefinition> byName = new HashMap<String, BeanDefinition>()
  private Map<String, String> properties = new HashMap<String, String>()
  private List<String> order = new ArrayList<String>()
  private boolean refreshed = false

  public ApplicationContext() {
  }

  public ApplicationContext setProperty(String key, String value) {
    properties.put(key, value)
    return this
  }

  public String getProperty(String key) {
    String v = properties.get(key)
    if (v == null) {
      throw new IllegalStateException("no property " + key)
    }
    return v
  }

  public String getProperty(String key, String fallback) {
    String v = properties.get(key)
    return v == null ? fallback : v
  }

  // refresh builds every singleton, which is where a dependency that cannot be
  // satisfied is reported -- at startup, in order, not at the first request.
  public void refresh() {
    if (refreshed) {
      return
    }
    refreshed = true
    // Each registered class answers with the beans it declares: itself, and one
    // per @Bean method when it is a @Configuration class.
    for (Class c : BeanRegistry.registered()) {
      BeanDefinition[] defs = BeanScanner.all(c)
      for (int i = 0 : i < defs.length : i++) {
        BeanDefinition d = defs[i]
        BeanDefinition prev = byName.get(d.name)
        if (prev != null) {
          throw new IllegalStateException("two beans named " + d.name)
        }
        byName.put(d.name, d)
        order.add(d.name)
      }
    }
    for (String n : order) {
      BeanDefinition d = byName.get(n)
      if (d.singleton) {
        resolve(n)
      }
    }
  }

  private Object resolve(String name) {
    BeanDefinition d = byName.get(name)
    if (d == null) {
      throw new IllegalStateException("no bean named " + name)
    }
    if (d.instance != null) {
      return d.instance
    }
    if (d.creating) {
      throw new IllegalStateException("circular dependency involving " + name)
    }
    d.creating = true
    Object o = d.factory.create(this)
    d.injector.inject(o, this)
    d.creating = false
    if (d.singleton) {
      d.instance = o
    }
    return o
  }

  public Object getBean(Class type) {
    return getBean(type, "")
  }

  // getBean answers with the bean of a type, or the one a qualifier names. Two
  // beans of one type with no qualifier and no @Primary is ambiguous, and
  // Spring refuses it; so does this, at lookup time, since which beans share a
  // type is a whole-program fact the compiler could also check.
  public Object getBean(Class type, String qualifier) {
    BeanDefinition found = null
    for (String n : order) {
      BeanDefinition d = byName.get(n)
      // `==` on strings is reference comparison, as in Java, so the names are
      // compared with equals: getName() builds a fresh string on each call.
      if (implementsType(d, type) == false) {
        continue
      }
      if (qualifier.isEmpty() == false) {
        if (d.name.equals(qualifier)) {
          return resolve(n)
        }
        continue
      }
      if (d.primary) {
        return resolve(n)
      }
      if (found != null) {
        throw new IllegalStateException("two beans of type " + type.getName() + ": " + found.name + " and " + d.name)
      }
      found = d
    }
    if (found == null) {
      throw new IllegalStateException("no bean of type " + type.getName())
    }
    return resolve(found.name)
  }

  public Object getBean(String name) {
    return resolve(name)
  }

  // implementsType reports whether a bean satisfies a type, which is what
  // Class.isAssignableFrom answers: its own class, a superclass, or an
  // interface it implements.
  private boolean implementsType(BeanDefinition d, Class want) {
    if (d.type == null) {
      return false
    }
    if (want.isAssignableFrom(d.type)) {
      return true
    }
    // a bean of a primitive type answers a lookup for its box and the other way
    // round, which is how Spring resolves a bean of type int for an
    // application that asks for Integer
    return ContainerConvert.boxOf(want).equals(d.type) || want.equals(ContainerConvert.boxOf(d.type))
  }

  // resolveValue is a @Value: the property, or the fallback the annotation
  // names, converted to the type of the field or parameter it is written on.
  public Object resolveValue(String[] spec, Class type) {
    String raw = getProperty(spec[0], spec[1])
    return ContainerConvert.to(raw, type)
  }

  public boolean containsBean(String name) {
    return byName.containsKey(name)
  }

  public List<String> getBeanNames() {
    return order
  }

  public int beanCount() {
    return order.size()
  }
}

// ContainerConvert turns a property's text into the type a @Value is written
// on. Spring does this with its conversion service; the set of types is the one
// a property can meaningfully hold.
class ContainerConvert {
  public static Object to(String raw, Class type) {
    if (type.equals(String.class)) {
      return raw
    }
    if (type.equals(int.class) || type.equals(Integer.class)) {
      return Integer.parseInt(raw)
    }
    if (type.equals(long.class) || type.equals(Long.class)) {
      return Long.parseLong(raw)
    }
    if (type.equals(short.class) || type.equals(Short.class)) {
      return Short.parseShort(raw)
    }
    if (type.equals(byte.class) || type.equals(Byte.class)) {
      return Byte.parseByte(raw)
    }
    if (type.equals(double.class) || type.equals(Double.class)) {
      return Double.parseDouble(raw)
    }
    if (type.equals(float.class) || type.equals(Float.class)) {
      return Float.parseFloat(raw)
    }
    if (type.equals(boolean.class) || type.equals(Boolean.class)) {
      return Boolean.parseBoolean(raw)
    }
    if (type.equals(char.class) || type.equals(Character.class)) {
      return raw.charAt(0)
    }
    throw new IllegalStateException("a @Value cannot be read as " + type.getName())
  }

  // boxOf answers the box of a primitive type and the primitive of a box, and
  // the type itself for anything else. It is what makes a bean of type int and
  // a lookup for Integer the same question.
  public static Class boxOf(Class type) {
    if (type.equals(Integer.TYPE)) { return Integer.class }
    if (type.equals(Long.TYPE)) { return Long.class }
    if (type.equals(Double.TYPE)) { return Double.class }
    if (type.equals(Float.TYPE)) { return Float.class }
    if (type.equals(Short.TYPE)) { return Short.class }
    if (type.equals(Byte.TYPE)) { return Byte.class }
    if (type.equals(Character.TYPE)) { return Character.class }
    if (type.equals(Boolean.TYPE)) { return Boolean.class }
    if (type.equals(Integer.class)) { return Integer.TYPE }
    if (type.equals(Long.class)) { return Long.TYPE }
    if (type.equals(Double.class)) { return Double.TYPE }
    if (type.equals(Float.class)) { return Float.TYPE }
    if (type.equals(Short.class)) { return Short.TYPE }
    if (type.equals(Byte.class)) { return Byte.TYPE }
    if (type.equals(Character.class)) { return Character.TYPE }
    if (type.equals(Boolean.class)) { return Boolean.TYPE }
    return type
  }
}

